recursive-include protocol *
recursive-include harness *
recursive-include bin *
include README.md
include LICENSE

# Persona symlink: must NEVER be in dist artifacts.
# `prune` is the unambiguous "drop this entry" command (recursive-exclude only excludes files inside).
prune persona

# Don't ship local docs / .agents / archive
prune docs/archive
prune .agents
prune dist
prune build
prune *.egg-info
