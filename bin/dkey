#!/bin/sh
# dkey - small age-backed capability grants for CLI/resource operations.

set -eu

VERSION="0.1.0-vnext"

HOME_DIR="${HOME:?HOME is required}"
AGENTS_DIR="${DOT_AGENTS_DIR:-$HOME_DIR/.agents}"
DOT_DIR="$AGENTS_DIR/.dotpanel"
SECRETS_DIR="$AGENTS_DIR/secrets"
KEYS_FILE="${DKEY_KEYS_FILE:-$SECRETS_DIR/keys.env.age}"
GRANTS_FILE="${DKEY_GRANTS_FILE:-$SECRETS_DIR/dkey.conf}"
PROVIDERS_FILE="${DKEY_PROVIDERS_FILE:-$SECRETS_DIR/dkey.providers.json}"
AGE_IDENTITY_FILE="${DKEY_AGE_IDENTITY_FILE:-$HOME_DIR/.config/age/key.txt}"
TEMPLATE_DIR="$AGENTS_DIR/.dotpanel/templates/secrets"

info() { printf 'OK  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
dkey - age-backed capability grants

Usage:
  dkey init
  dkey keygen
  dkey identity import PATH [--force]
  dkey identity import --stdin [--force]
  dkey set NAME VALUE
  dkey set NAME=VALUE
  dkey edit
  dkey list
  dkey grants
  dkey reset claude|codex|all
  dkey status
  dkey doctor
  dkey run --with GRANT [--with GRANT...] -- COMMAND [ARGS...]
  dkey on --with GRANT [--with GRANT...]
  dkey off
  dkey version
  dkey help

Shell integration:
  `dot init` installs a shell function that evals `dkey on/off` in the current
  shell. Direct `dkey on` refuses to print secret-bearing shell code.
  `dkey on --with GRANT` exports only that grant; `dkey off` removes variables it set.
EOF
}

version() {
    printf 'dkey %s\n' "$VERSION"
}

need_age() {
    command -v age >/dev/null 2>&1 || fail "age is required"
}

have_age_tools() {
    command -v age >/dev/null 2>&1 && command -v age-keygen >/dev/null 2>&1
}

need_jq() {
    command -v jq >/dev/null 2>&1 || fail "jq is required"
}

ensure_dirs() {
    mkdir -p "$SECRETS_DIR" "$DOT_DIR/var"
}

sample_keys() {
    if [ -f "$TEMPLATE_DIR/keys.env.template" ]; then
        cat "$TEMPLATE_DIR/keys.env.template"
        return 0
    fi
    cat <<'EOF'
# Plaintext template. Edit values, save, and dkey will encrypt it.
# Format: NAME=value
#
# CLOUDFLARE_API_TOKEN=
# GITHUB_TOKEN=
EOF
}

sample_grants() {
    if [ -f "$TEMPLATE_DIR/dkey.conf" ]; then
        cat "$TEMPLATE_DIR/dkey.conf"
        return 0
    fi
    cat <<'EOF'
# dkey grants.
# Format:
#   grant:<name>:ENV_VAR=SECRET_NAME[,ENV_VAR2=SECRET_NAME2]
#   extra:<name>:ENV_VAR=value[,ENV_VAR2=value2]
#
# Example:
#   grant:cloudflare-readonly:CLOUDFLARE_API_TOKEN=CLOUDFLARE_READONLY_TOKEN
#   grant:github-release:GITHUB_TOKEN=GITHUB_RELEASE_TOKEN
EOF
}

keygen_cmd() {
    command -v age-keygen >/dev/null 2>&1 || fail "age-keygen is required"
    if [ -f "$AGE_IDENTITY_FILE" ]; then
        info "age identity already exists: $AGE_IDENTITY_FILE"
        return 0
    fi
    mkdir -p "$(dirname "$AGE_IDENTITY_FILE")"
    age-keygen -o "$AGE_IDENTITY_FILE"
    chmod 600 "$AGE_IDENTITY_FILE"
    info "created age identity: $AGE_IDENTITY_FILE"
}

identity_import_cmd() {
    command -v age-keygen >/dev/null 2>&1 || fail "age-keygen is required"
    src=""
    force=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --stdin)
                [ -z "$src" ] || fail "identity source already set"
                src="-"
                ;;
            --force)
                force=true
                ;;
            -h|--help)
                printf '%s\n' "Usage: dkey identity import PATH [--force] | dkey identity import --stdin [--force]"
                return 0
                ;;
            -*)
                fail "unknown identity import argument: $1"
                ;;
            *)
                [ -z "$src" ] || fail "identity source already set"
                src="$1"
                ;;
        esac
        shift
    done

    [ -n "$src" ] || fail "identity import requires PATH or --stdin"
    if [ -f "$AGE_IDENTITY_FILE" ] && ! $force; then
        fail "age identity already exists: $AGE_IDENTITY_FILE; pass --force to replace it"
    fi

    mkdir -p "$(dirname "$AGE_IDENTITY_FILE")"
    tmp="$AGE_IDENTITY_FILE.$$"
    if [ "$src" = "-" ]; then
        cat > "$tmp"
    else
        [ -f "$src" ] || fail "identity source not found: $src"
        cp "$src" "$tmp"
    fi

    age-keygen -y "$tmp" >/dev/null 2>&1 || {
        rm -f "$tmp"
        fail "invalid age identity"
    }
    chmod 600 "$tmp"
    mv "$tmp" "$AGE_IDENTITY_FILE"
    info "imported age identity: $AGE_IDENTITY_FILE"
}

identity_cmd() {
    sub="${1:-}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        import) identity_import_cmd "$@" ;;
        *) fail "usage: dkey identity import PATH [--force] | dkey identity import --stdin [--force]" ;;
    esac
}

public_recipient_from_identity() {
    [ -f "$AGE_IDENTITY_FILE" ] || return 1
    age-keygen -y "$AGE_IDENTITY_FILE" 2>/dev/null
}

encrypt_plaintext() {
    in="$1"
    out="$2"
    need_age
    command -v age-keygen >/dev/null 2>&1 || fail "age-keygen is required"
    recipient="$(public_recipient_from_identity)" || fail "age identity missing at $AGE_IDENTITY_FILE"
    tmp="$out.$$"
    age -r "$recipient" -o "$tmp" "$in"
    mv "$tmp" "$out"
}

decrypt_keys() {
    need_age
    [ -f "$KEYS_FILE" ] || fail "keys file missing: $KEYS_FILE"
    [ -f "$AGE_IDENTITY_FILE" ] || fail "age identity missing: $AGE_IDENTITY_FILE"
    age -d -i "$AGE_IDENTITY_FILE" "$KEYS_FILE"
}

validate_key_name() {
    name="$1"
    printf '%s' "$name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$' || fail "invalid key name: $name"
}

validate_grant_env_name() {
    env_name="$1"
    validate_key_name "$env_name"
    case "$env_name" in
        DKEY_*|_DOTPANEL_DKEY_*|_dkey_*|PATH|HOME|SHELL|IFS|ENV|BASH_ENV|ZDOTDIR|CDPATH|FPATH|BASHOPTS|SHELLOPTS)
            fail "reserved grant env name: $env_name"
            ;;
    esac
}

validate_grant_name() {
    grant="$1"
    case "$grant" in
        ""|*[!A-Za-z0-9._-]*) fail "invalid grant name: $grant" ;;
    esac
}

set_key_cmd() {
    ensure_dirs
    [ "$#" -gt 0 ] || fail "usage: dkey set NAME VALUE | dkey set NAME=VALUE"
    case "$1" in
        *=*)
            name="${1%%=*}"
            value="${1#*=}"
            [ "$#" -eq 1 ] || fail "usage: dkey set NAME=VALUE"
            ;;
        *)
            name="$1"
            shift
            [ "$#" -gt 0 ] || fail "usage: dkey set NAME VALUE"
            value="$*"
            ;;
    esac
    validate_key_name "$name"

    tmp="$SECRETS_DIR/.keys.env.$$"
    if [ -f "$KEYS_FILE" ]; then
        decrypt_keys > "$tmp"
    else
        sample_keys > "$tmp"
    fi

    if grep -q -E "^${name}=" "$tmp"; then
        tmp2="$SECRETS_DIR/.keys.env.set.$$"
        awk -v key="$name" -v value="$value" '
            BEGIN { done = 0 }
            $0 ~ /^[[:space:]]*#/ { print; next }
            index($0, key "=") == 1 {
                print key "=" value
                done = 1
                next
            }
            { print }
            END {
                if (!done) {
                    print key "=" value
                }
            }
        ' "$tmp" > "$tmp2"
        mv "$tmp2" "$tmp"
    else
        printf '%s=%s\n' "$name" "$value" >> "$tmp"
    fi

    encrypt_plaintext "$tmp" "$KEYS_FILE"
    rm -f "$tmp"
    info "set $name in $KEYS_FILE"
}

init_cmd() {
    ensure_dirs
    if [ ! -f "$GRANTS_FILE" ]; then
        sample_grants > "$GRANTS_FILE"
        info "created $GRANTS_FILE"
    else
        info "current $GRANTS_FILE"
    fi
    if [ ! -f "$KEYS_FILE" ]; then
        template="$SECRETS_DIR/keys.env.template"
        if [ ! -f "$template" ]; then
            sample_keys > "$template"
            info "created $template"
        else
            info "current $template"
        fi
        if have_age_tools && [ -f "$AGE_IDENTITY_FILE" ]; then
            encrypt_plaintext "$template" "$KEYS_FILE"
            info "created $KEYS_FILE"
        else
            warn "encrypted keys not created; install age, run dkey keygen, then run dkey set NAME VALUE"
        fi
    else
        info "current $KEYS_FILE"
        if [ ! -f "$AGE_IDENTITY_FILE" ]; then
            warn "keys file exists but age identity not found; run: dkey identity import --stdin"
        fi
    fi
    if [ ! -f "$PROVIDERS_FILE" ]; then
        providers_template="$TEMPLATE_DIR/dkey.providers.example.json"
        if [ -f "$providers_template" ]; then
            cp "$providers_template" "$PROVIDERS_FILE"
            info "created $PROVIDERS_FILE"
        else
            warn "providers template not found at $providers_template"
        fi
    else
        info "current $PROVIDERS_FILE"
    fi
}

edit_cmd() {
    ensure_dirs
    editor="${EDITOR:-vi}"
    tmp="$SECRETS_DIR/.keys.env.$$"
    if [ -f "$KEYS_FILE" ]; then
        decrypt_keys > "$tmp"
    else
        sample_keys > "$tmp"
    fi
    "$editor" "$tmp"
    encrypt_plaintext "$tmp" "$KEYS_FILE"
    rm -f "$tmp"
    info "updated $KEYS_FILE"
}

grant_line() {
    grant="$1"
    validate_grant_name "$grant"
    [ -f "$GRANTS_FILE" ] || fail "grants file missing: $GRANTS_FILE"
    awk -F: -v grant="$grant" '
        $1 == "grant" && $2 == grant { matched = $0 }
        END { if (matched != "") print matched }
    ' "$GRANTS_FILE"
}

extra_line() {
    grant="$1"
    validate_grant_name "$grant"
    [ -f "$GRANTS_FILE" ] || return 0
    awk -F: -v grant="$grant" '
        $1 == "extra" && $2 == grant { matched = $0 }
        END { if (matched != "") print matched }
    ' "$GRANTS_FILE"
}

list_cmd() {
    if [ ! -f "$KEYS_FILE" ]; then
        warn "keys file missing: $KEYS_FILE"
        return 0
    fi
    decrypt_keys | awk -F= '
        $0 ~ /^[[:space:]]*#/ { next }
        $1 ~ /^[A-Za-z_][A-Za-z0-9_]*$/ { print $1 }
    ' | sort -u
}

grant_names_csv() {
    [ -f "$GRANTS_FILE" ] || return 0
    awk -F: '/^grant:/ { names = names (names == "" ? "" : ", ") $2 } END { if (names != "") print names }' "$GRANTS_FILE"
}

grant_list_cmd() {
    if [ ! -f "$GRANTS_FILE" ]; then
        warn "grants file missing: $GRANTS_FILE"
        return 0
    fi
    # Name + the env vars each grant injects. Secret values are never shown.
    awk -F: '
        /^grant:/ {
            n = split($3, pairs, ",")
            envs = ""
            for (i = 1; i <= n; i++) {
                eq = index(pairs[i], "=")
                if (eq > 0) envs = envs (envs == "" ? "" : ", ") substr(pairs[i], 1, eq - 1)
            }
            printf "%-16s %s\n", $2, envs
        }
    ' "$GRANTS_FILE" | sort
}

lookup_secret() {
    name="$1"
    # Reads plaintext env lines from stdin.
    awk -F= -v key="$name" '
        $0 ~ /^[[:space:]]*#/ { next }
        $1 == key {
            sub(/^[^=]*=/, "")
            print
            found=1
            exit
        }
        END { if (!found) exit 1 }
    '
}

secret_value() {
    name="$1"
    decrypt_keys | lookup_secret "$name"
}

expand_home_path() {
    path="$1"
    case "$path" in
        "~") printf '%s\n' "$HOME_DIR" ;;
        "~/"*) printf '%s/%s\n' "$HOME_DIR" "$(printf '%s' "$path" | sed 's|^~/||')" ;;
        *) printf '%s\n' "$path" ;;
    esac
}

shell_quote() {
    # Single-quote for POSIX shell eval.
    sed "s/'/'\\\\''/g; s/^/'/; s/$/'/"
}

use_cmd() {
    cat >&2 <<'EOF'
FAIL  dkey use has been removed.

Persistent backend switching wrote global harness config and could overwrite
Codex ChatGPT/OAuth auth state with API-key mode.

Use per-invocation wrappers instead:
  claw <backend[:profile]> [claude args...]
  clawb <backend[:profile]> "prompt"
  codx <backend[:profile]> [codex args...]
  codxb <backend[:profile]> "prompt"

Backend definitions still live in ~/.agents/secrets/dkey.providers.json, and
wrapper secrets are injected via `dkey run --with llm-backends`.
EOF
    return 1
}

providers_registry_valid() {
    [ -f "$PROVIDERS_FILE" ] || return 1
    jq -e '
        def optional_object:
            if . == null then true else type == "object" end;
        def optional_nonempty_string:
            if . == null then true
            else type == "string" and length > 0 and (test("[\u0000-\u001F\u007F]") | not)
            end;
        def optional_string_array:
            if . == null then true
            elif type != "array" then false
            else all(.[]; type == "string")
            end;
        def valid_settings:
            if . == null then true
            elif type != "object" then false
            else (.env? | optional_object)
            end;
        def valid_default_claude:
            if . == null then true
            elif type != "object" then false
            else
                (.settings_path? | optional_nonempty_string) and
                (.managed_env_keys? | optional_string_array) and
                (.settings? | valid_settings)
            end;
        def valid_defaults:
            if . == null then true
            elif type != "object" then false
            else
                (.claude? | valid_default_claude) and
                (.codex? | if . == null then true
                    elif type != "object" then false
                    else (.config_path? | optional_nonempty_string)
                    end)
            end;
        def valid_profile:
            if type != "object" then false
            else
                (.claude? | if . == null then true
                    elif type != "object" then false
                    else (.settings? | valid_settings)
                    end) and
                (.codex? | if . == null then true
                    elif type != "object" then false
                    else (.model_provider? |
                        if . == null then true
                        else type == "string" and test("^[A-Za-z0-9_-]+$")
                        end)
                    end)
            end;
        def valid_provider:
            if type != "object" then false
            elif (.profiles | type) != "object" then false
            else all(.profiles[]; valid_profile)
            end;
        type == "object" and
        .version == 1 and
        (.providers | type) == "object" and
        (.defaults? | valid_defaults) and
        all(.providers[]; valid_provider)
    ' "$PROVIDERS_FILE" >/dev/null 2>&1
}

validate_reset_target_path() {
    reset_target="$1"
    reset_label="$2"
    case "$reset_target" in
        "$HOME_DIR"/*) ;;
        *) reset_abort "$reset_label path must stay below HOME: $reset_target" ;;
    esac
    case "$reset_target" in
        */./*|*/.|*/../*|*/..) reset_abort "$reset_label path must be lexically normalized: $reset_target" ;;
    esac
    [ ! -L "$HOME_DIR" ] || reset_abort "$reset_label HOME boundary is symlinked: $HOME_DIR"
    reset_cursor="$reset_target"
    while [ "$reset_cursor" != "$HOME_DIR" ]; do
        [ ! -L "$reset_cursor" ] || \
            reset_abort "$reset_label path contains a symlink: $reset_cursor"
        reset_parent="$(dirname "$reset_cursor")" || \
            reset_abort "could not inspect $reset_label path: $reset_cursor"
        [ "$reset_parent" != "$reset_cursor" ] || \
            reset_abort "could not inspect $reset_label path: $reset_cursor"
        case "$reset_parent" in
            "$HOME_DIR"|"$HOME_DIR"/*) ;;
            *) reset_abort "$reset_label path escaped HOME while inspecting: $reset_target" ;;
        esac
        reset_cursor="$reset_parent"
    done
    if [ -e "$reset_target" ] && [ ! -f "$reset_target" ]; then
        reset_abort "$reset_label target is not a regular file: $reset_target"
    fi
}

reset_cmd() {
    need_jq
    [ -f "$PROVIDERS_FILE" ] || fail "providers registry missing: $PROVIDERS_FILE"
    providers_registry_valid || \
        fail "providers registry invalid: $PROVIDERS_FILE"
    harness="${1:-}"
    case "$harness" in
        claude|codex|all) ;;
        *) fail "reset requires: claude, codex, or all" ;;
    esac

    reset_old_umask="$(umask)"
    umask 077
    mkdir -p "$DOT_DIR/var"
    claude_reset_tmp=""
    codex_reset_tmp=""
    codex_auth_reset_tmp=""
    managed_providers=""

    reset_cleanup() {
        for reset_file in "${claude_reset_tmp:-}" "${codex_reset_tmp:-}" \
            "${codex_auth_reset_tmp:-}" "${managed_providers:-}"; do
            [ -z "$reset_file" ] || rm -f "$reset_file" || true
        done
        umask "$reset_old_umask" || true
    }
    reset_signal_exit() {
        reset_signal_status="$1"
        trap - EXIT HUP INT TERM
        reset_cleanup
        exit "$reset_signal_status"
    }
    reset_abort() {
        reset_message="$1"
        reset_cleanup
        fail "$reset_message"
    }
    trap 'reset_cleanup' EXIT
    trap 'reset_signal_exit 129' HUP
    trap 'reset_signal_exit 130' INT
    trap 'reset_signal_exit 143' TERM

    case "$harness" in
        claude|all)
            settings_value="$(jq -er '
                .defaults.claude.settings_path // "~/.claude/settings.json"
                | select(type == "string" and length > 0)
            ' "$PROVIDERS_FILE")" || reset_abort "invalid Claude settings path in providers registry"
            settings_path="$(expand_home_path "$settings_value")"
            validate_reset_target_path "$settings_path" "Claude settings"
            if [ -f "$settings_path" ]; then
                mkdir -p "$(dirname "$settings_path")"
                managed_keys="$(jq -ce '[
                    (.defaults.claude.managed_env_keys // [])[],
                    ((.defaults.claude.settings.env // {}) | keys[]),
                    ((.providers[]?.profiles[]?.claude?.settings?.env // {}) | keys[])
                ] | unique | select(all(.[]; type == "string"))' "$PROVIDERS_FILE")" || \
                    reset_abort "invalid Claude managed env declarations in providers registry"
                jq -e 'type == "object" and ((.env? == null) or ((.env | type) == "object"))' \
                    "$settings_path" >/dev/null 2>&1 || \
                    reset_abort "Claude settings file is not a JSON object: $settings_path"
                claude_reset_tmp="$(mktemp "$settings_path.dkey-reset.XXXXXX")" || \
                    reset_abort "could not create Claude reset file beside: $settings_path"
                jq --argjson keys "$managed_keys" '
                    .env = ((.env // {}) | with_entries(
                        select(.key as $key | ($keys | index($key) | not))
                    ))
                    | if .env == {} then del(.env) else . end
                ' "$settings_path" > "$claude_reset_tmp" || \
                    reset_abort "could not prepare Claude settings reset: $settings_path"
                chmod 600 "$claude_reset_tmp" || \
                    reset_abort "could not protect Claude reset file: $claude_reset_tmp"
            fi
            ;;
    esac

    case "$harness" in
        codex|all)
            config_value="$(jq -er '
                .defaults.codex.config_path // "~/.codex/config.toml"
                | select(type == "string" and length > 0)
            ' "$PROVIDERS_FILE")" || reset_abort "invalid Codex config path in providers registry"
            config_path="$(expand_home_path "$config_value")"
            validate_reset_target_path "$config_path" "Codex config"
            if [ -f "$config_path" ] && \
                { grep -Fq '"""' "$config_path" || grep -Fq "'''" "$config_path"; }; then
                reset_abort "refusing to rewrite Codex config with multiline TOML strings: $config_path"
            fi
            if [ -f "$config_path" ] && ! awk '
                /^[[:space:]]*\[/ { in_table = 1 }
                /=[[:space:]]*\[[[:space:]]*(#.*)?$/ { invalid = 1 }
                /^[[:space:]]*\[/ &&
                    $0 !~ /^[[:space:]]*\[[A-Za-z0-9_.-]+\][[:space:]]*(#.*)?$/ {
                    invalid = 1
                }
                !in_table {
                    candidate = $0
                    sub(/^[[:space:]]*/, "", candidate)
                    key_quote = substr(candidate, 1, 1)
                    if ((key_quote == "\"" || key_quote == sprintf("%c", 39)) &&
                        substr(candidate, 2, 14) == "model_provider" &&
                        substr(candidate, 16, 1) == key_quote &&
                        substr(candidate, 17) ~ /^[[:space:]]*=/) {
                        invalid = 1
                    }
                }
                /^[[:space:]]*\[model_providers\./ &&
                    $0 !~ /^[[:space:]]*\[model_providers\.[A-Za-z0-9_-]+\][[:space:]]*(#.*)?$/ {
                    invalid = 1
                }
                END { exit invalid }
            ' "$config_path"; then
                reset_abort "refusing unsupported Codex TOML table/bracket syntax: $config_path"
            fi
            managed_providers="$(mktemp "$DOT_DIR/var/codex-reset-providers.XXXXXX")" || \
                reset_abort "could not create Codex provider reset list"
            jq -e '[.providers[]?.profiles[]?.codex?.model_provider // empty]
                | all(.[]; type == "string" and test("^[A-Za-z0-9_-]+$"))' \
                "$PROVIDERS_FILE" >/dev/null 2>&1 || \
                    reset_abort "invalid Codex provider IDs in providers registry"
            jq -r '[.providers[]?.profiles[]?.codex?.model_provider // empty]
                | unique[]' "$PROVIDERS_FILE" > "$managed_providers" || \
                    reset_abort "could not read Codex provider IDs from providers registry"
            clear_codex_auth=0
            if [ -f "$config_path" ]; then
                mkdir -p "$(dirname "$config_path")"
                current_provider="$(awk '
                    /^[[:space:]]*\[/ { exit }
                    /^[[:space:]]*model_provider[[:space:]]*=/ {
                        value = $0
                        sub(/^[^=]*=[[:space:]]*/, "", value)
                        sub(/[[:space:]#].*$/, "", value)
                        quote = substr(value, 1, 1)
                        if ((quote == "\"" || quote == sprintf("%c", 39)) &&
                            substr(value, length(value), 1) == quote) {
                            value = substr(value, 2, length(value) - 2)
                        }
                        print value
                        exit
                    }
                ' "$config_path")"
                clear_top=0
                if [ -n "$current_provider" ] && grep -qxF "$current_provider" "$managed_providers"; then
                    clear_top=1
                    clear_codex_auth=1
                fi
                codex_reset_tmp="$(mktemp "$config_path.dkey-reset.XXXXXX")" || \
                    reset_abort "could not create Codex reset file beside: $config_path"
                awk -v managed_file="$managed_providers" -v clear_top="$clear_top" '
                    BEGIN {
                        top = 1
                        skip = 0
                        while ((getline provider < managed_file) > 0) managed[provider] = 1
                        close(managed_file)
                    }
                    /^[[:space:]]*\[/ {
                        top = 0
                        skip = 0
                        if ($0 ~ /^[[:space:]]*\[model_providers\.[A-Za-z0-9_-]+\][[:space:]]*(#.*)?$/) {
                            provider = $0
                            sub(/^[[:space:]]*\[model_providers\./, "", provider)
                            sub(/\][[:space:]]*(#.*)?$/, "", provider)
                            if (provider in managed) { skip = 1; next }
                        }
                    }
                    skip { next }
                    top && clear_top && /^[[:space:]]*(model_provider|model|review_model)[[:space:]]*=/ { next }
                    { print }
                ' "$config_path" > "$codex_reset_tmp" || \
                    reset_abort "could not prepare Codex config reset: $config_path"
                chmod 600 "$codex_reset_tmp" || \
                    reset_abort "could not protect Codex reset file: $codex_reset_tmp"
            fi
            auth_path="$HOME_DIR/.codex/auth.json"
            [ "$clear_codex_auth" -eq 0 ] || validate_reset_target_path "$auth_path" "Codex auth"
            if [ "$clear_codex_auth" -eq 1 ] && [ -f "$auth_path" ]; then
                jq -e 'type == "object"' "$auth_path" >/dev/null 2>&1 || \
                    reset_abort "Codex auth file is not a JSON object: $auth_path"
                codex_auth_reset_tmp="$(mktemp "$auth_path.dkey-reset.XXXXXX")" || \
                    reset_abort "could not create Codex auth reset file beside: $auth_path"
                jq 'if .auth_mode == "apikey" then del(.auth_mode, .OPENAI_API_KEY) else . end' \
                    "$auth_path" > "$codex_auth_reset_tmp" || \
                    reset_abort "could not prepare Codex auth reset: $auth_path"
                chmod 600 "$codex_auth_reset_tmp" || \
                    reset_abort "could not protect Codex auth reset file: $codex_auth_reset_tmp"
            fi
            ;;
    esac

    reset_claude_changed=0
    reset_codex_changed=0
    reset_auth_changed=0
    if [ -n "$claude_reset_tmp" ]; then
        mv "$claude_reset_tmp" "$settings_path" || \
            reset_abort "could not install Claude settings reset: $settings_path"
        claude_reset_tmp=""
        reset_claude_changed=1
    fi
    if [ -n "$codex_reset_tmp" ]; then
        mv "$codex_reset_tmp" "$config_path" || \
            reset_abort "could not install Codex config reset: $config_path"
        codex_reset_tmp=""
        reset_codex_changed=1
    fi
    if [ -n "$codex_auth_reset_tmp" ]; then
        mv "$codex_auth_reset_tmp" "$auth_path" || \
            reset_abort "could not install Codex auth reset: $auth_path"
        codex_auth_reset_tmp=""
        reset_auth_changed=1
    fi
    reset_cleanup
    trap - EXIT HUP INT TERM
    [ "$reset_claude_changed" -eq 0 ] || \
        info "reset Claude Code — registry-managed backend env vars cleared"
    [ "$reset_codex_changed" -eq 0 ] || \
        info "reset Codex — registry-managed provider settings cleared"
    [ "$reset_auth_changed" -eq 0 ] || \
        info "reset Codex — legacy API-key auth override cleared; OAuth fields preserved"
}

emit_exports_for_grants() {
    grants="$1"
    [ -n "$grants" ] || fail "grant list is empty"
    keys_plain="$(decrypt_keys)"
    managed=""
    active=""

    for grant in $grants; do
        line="$(grant_line "$grant")"
        [ -n "$line" ] || fail "grant not found: $grant (available: $(grant_names_csv))"
        mapping="${line#grant:${grant}:}"

        old_ifs="$IFS"
        IFS=','
        for pair in $mapping; do
            case "$pair" in *=*) ;; *) fail "bad grant mapping: $pair" ;; esac
            env_name="${pair%%=*}"
            secret_name="${pair#*=}"
            [ -n "$env_name" ] && [ -n "$secret_name" ] || fail "bad grant mapping: $pair"
            validate_grant_env_name "$env_name"
            validate_key_name "$secret_name"
            value="$(printf '%s\n' "$keys_plain" | lookup_secret "$secret_name")" || fail "secret not found: $secret_name"
            quoted="$(printf '%s' "$value" | shell_quote)"
            printf 'export %s=%s &&\n' "$env_name" "$quoted"
            managed="${managed:-}${managed:+ }$env_name"
        done
        IFS="$old_ifs"

        extra="$(extra_line "$grant")"
        if [ -n "$extra" ]; then
            extras="${extra#extra:${grant}:}"
            IFS=','
            for pair in $extras; do
                case "$pair" in *=*) ;; *) fail "bad extra mapping: $pair" ;; esac
                env_name="${pair%%=*}"
                value="${pair#*=}"
                validate_grant_env_name "$env_name"
                quoted="$(printf '%s' "$value" | shell_quote)"
                printf 'export %s=%s &&\n' "$env_name" "$quoted"
                managed="${managed:-}${managed:+ }$env_name"
            done
            IFS="$old_ifs"
        fi

        active="${active:-}${active:+,}$grant"
    done

    printf 'export DKEY_ACTIVE_GRANT=%s &&\n' "$(printf '%s' "$active" | shell_quote)"
    printf 'export DKEY_MANAGED_VARS=%s\n' "$(printf '%s' "$managed" | shell_quote)"
}

shell_on_cmd() {
    [ "${DKEY_EMIT_SHELL:-}" = "1" ] || fail "dkey on requires dot shell integration; run '. ~/.agents/.dotpanel/env.sh' first"
    grants=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --with)
                shift
                [ "$#" -gt 0 ] || fail "--with requires a grant"
                grants="${grants:-}${grants:+ }$1"
                ;;
            *) fail "unknown shell on argument: $1" ;;
        esac
        shift
    done
    [ -n "$grants" ] || fail "dkey on requires --with GRANT; unscoped activation is disabled"
    emit_exports_for_grants "$grants"
}

shell_off_cmd() {
    cat <<'EOF'
_DOTPANEL_DKEY_OFF_STATUS=0
if [ -n "${DKEY_MANAGED_VARS:-}" ]; then
    for _dkey_var in $DKEY_MANAGED_VARS; do
        case "$_dkey_var" in
            ""|*[!A-Za-z0-9_]*|[0-9]*|DKEY_*|_DOTPANEL_DKEY_*|_dkey_*|PATH|HOME|SHELL|IFS|ENV|BASH_ENV|ZDOTDIR|CDPATH|FPATH|BASHOPTS|SHELLOPTS)
                _DOTPANEL_DKEY_OFF_STATUS=1
                ;;
            *) unset "$_dkey_var" || _DOTPANEL_DKEY_OFF_STATUS=$? ;;
        esac
    done
fi
unset DKEY_ACTIVE_GRANT || _DOTPANEL_DKEY_OFF_STATUS=$?
unset DKEY_MANAGED_VARS || _DOTPANEL_DKEY_OFF_STATUS=$?
unset _dkey_var
[ "$_DOTPANEL_DKEY_OFF_STATUS" -eq 0 ]
EOF
}

run_cmd() {
    grants=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --with)
                shift
                [ "$#" -gt 0 ] || fail "--with requires a grant"
                grants="${grants:-}${grants:+ }$1"
                ;;
            --)
                shift
                break
                ;;
            *) fail "unknown run argument: $1" ;;
        esac
        shift
    done
    [ -n "$grants" ] || fail "run requires --with GRANT"
    [ "$#" -gt 0 ] || fail "run requires a command after --"

    env_script="$(emit_exports_for_grants "$grants")"
    # Apply only in this process, then exec target.
    eval "$env_script"
    exec "$@"
}

status_cmd() {
    if [ -n "${DKEY_ACTIVE_GRANT:-}" ]; then
        printf 'active grant: %s\n' "$DKEY_ACTIVE_GRANT"
        printf 'managed vars: %s\n' "${DKEY_MANAGED_VARS:-}"
    else
        printf 'active grant: none\n'
    fi
}

doctor_cmd() {
    problems=0
    command -v age >/dev/null 2>&1 && info "age found" || { warn "age missing"; problems=$((problems + 1)); }
    command -v age-keygen >/dev/null 2>&1 && info "age-keygen found" || { warn "age-keygen missing"; problems=$((problems + 1)); }
    command -v jq >/dev/null 2>&1 && info "jq found" || { warn "jq missing"; problems=$((problems + 1)); }
    [ -f "$AGE_IDENTITY_FILE" ] && info "age identity exists: $AGE_IDENTITY_FILE" || {
        warn "age identity missing: $AGE_IDENTITY_FILE"
        problems=$((problems + 1))
    }
    [ -f "$KEYS_FILE" ] && info "keys file exists: $KEYS_FILE" || {
        warn "keys file missing: $KEYS_FILE"
        problems=$((problems + 1))
    }
    [ -f "$GRANTS_FILE" ] && info "grants file exists: $GRANTS_FILE" || {
        warn "grants file missing: $GRANTS_FILE"
        problems=$((problems + 1))
    }
    if [ -f "$PROVIDERS_FILE" ]; then
        if command -v jq >/dev/null 2>&1; then
            if providers_registry_valid; then
                info "providers registry valid: $PROVIDERS_FILE"
            else
                warn "providers registry invalid or unsupported: $PROVIDERS_FILE"
                problems=$((problems + 1))
            fi
        else
            info "providers registry exists: $PROVIDERS_FILE"
        fi
    else
        warn "providers registry missing: $PROVIDERS_FILE"
        problems=$((problems + 1))
    fi
    [ "$problems" -eq 0 ] || return 2
}

shell_cmd() {
    sub="${1:-}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        on) shell_on_cmd "$@" ;;
        off) shell_off_cmd ;;
        *) fail "usage: dkey shell on [--with GRANT] | dkey shell off" ;;
    esac
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$cmd" in
    init) init_cmd "$@" ;;
    keygen) keygen_cmd "$@" ;;
    identity) identity_cmd "$@" ;;
    set) set_key_cmd "$@" ;;
    edit) edit_cmd "$@" ;;
    list) list_cmd "$@" ;;
    use) use_cmd "$@" ;;
    reset) reset_cmd "$@" ;;
    grants) grant_list_cmd "$@" ;;
    run) run_cmd "$@" ;;
    on) shell_on_cmd "$@" ;;
    off) shell_off_cmd "$@" ;;
    shell) shell_cmd "$@" ;;
    status) status_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    version|--version|-v) version ;;
    help|--help|-h) usage ;;
    *) fail "unknown command: $cmd" ;;
esac
