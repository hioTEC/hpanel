#!/bin/sh
# dkey - small age-backed capability grants for CLI/resource operations.

set -eu

VERSION="0.1.0-vnext"

HOME_DIR="${HOME:?HOME is required}"
AGENTS_DIR="${DOT_AGENTS_DIR:-$HOME_DIR/.agents}"
DOT_DIR="$AGENTS_DIR/.dotpanel"
SECRETS_DIR="$AGENTS_DIR/secrets"
KEYS_FILE="${DKEY_KEYS_FILE:-$SECRETS_DIR/keys.env.age}"
GRANTS_FILE="${DKEY_GRANTS_FILE:-$SECRETS_DIR/dkey.conf}"
PROVIDERS_FILE="${DKEY_PROVIDERS_FILE:-$SECRETS_DIR/dkey.providers.json}"
AGE_IDENTITY_FILE="${DKEY_AGE_IDENTITY_FILE:-$HOME_DIR/.config/age/key.txt}"
TEMPLATE_DIR="$AGENTS_DIR/.dotpanel/templates/secrets"

info() { printf 'OK  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
dkey - age-backed capability grants

Usage:
  dkey init
  dkey keygen
  dkey identity import PATH [--force]
  dkey identity import --stdin [--force]
  dkey set NAME VALUE
  dkey set NAME=VALUE
  dkey edit
  dkey list
  dkey use claude:BACKEND[:PROFILE]
  dkey use codex:BACKEND[:PROFILE]
  dkey use all:BACKEND[:PROFILE]
  dkey reset claude|codex|all
  dkey status
  dkey doctor
  dkey run --with GRANT [--with GRANT...] -- COMMAND [ARGS...]
  dkey on [--with GRANT...]
  dkey off
  dkey version
  dkey help

Shell integration:
  `dot init` installs a shell function that evals `dkey on/off` in the current
  shell. Direct `dkey on` refuses to print secret-bearing shell code.
  `dkey on` exports all encrypted keys; `dkey off` removes all variables it set.
EOF
}

version() {
    printf 'dkey %s\n' "$VERSION"
}

need_age() {
    command -v age >/dev/null 2>&1 || fail "age is required"
}

have_age_tools() {
    command -v age >/dev/null 2>&1 && command -v age-keygen >/dev/null 2>&1
}

need_jq() {
    command -v jq >/dev/null 2>&1 || fail "jq is required"
}

ensure_dirs() {
    mkdir -p "$SECRETS_DIR" "$DOT_DIR/var"
}

sample_keys() {
    if [ -f "$TEMPLATE_DIR/keys.env.template" ]; then
        cat "$TEMPLATE_DIR/keys.env.template"
        return 0
    fi
    cat <<'EOF'
# Plaintext template. Edit values, save, and dkey will encrypt it.
# Format: NAME=value
#
# CLOUDFLARE_API_TOKEN=
# GITHUB_TOKEN=
EOF
}

sample_grants() {
    if [ -f "$TEMPLATE_DIR/dkey.conf" ]; then
        cat "$TEMPLATE_DIR/dkey.conf"
        return 0
    fi
    cat <<'EOF'
# dkey grants.
# Format:
#   grant:<name>:ENV_VAR=SECRET_NAME[,ENV_VAR2=SECRET_NAME2]
#   extra:<name>:ENV_VAR=value[,ENV_VAR2=value2]
#
# Example:
#   grant:cloudflare-readonly:CLOUDFLARE_API_TOKEN=CLOUDFLARE_READONLY_TOKEN
#   grant:github-release:GITHUB_TOKEN=GITHUB_RELEASE_TOKEN
EOF
}

keygen_cmd() {
    command -v age-keygen >/dev/null 2>&1 || fail "age-keygen is required"
    if [ -f "$AGE_IDENTITY_FILE" ]; then
        info "age identity already exists: $AGE_IDENTITY_FILE"
        return 0
    fi
    mkdir -p "$(dirname "$AGE_IDENTITY_FILE")"
    age-keygen -o "$AGE_IDENTITY_FILE"
    chmod 600 "$AGE_IDENTITY_FILE"
    info "created age identity: $AGE_IDENTITY_FILE"
}

identity_import_cmd() {
    command -v age-keygen >/dev/null 2>&1 || fail "age-keygen is required"
    src=""
    force=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --stdin)
                [ -z "$src" ] || fail "identity source already set"
                src="-"
                ;;
            --force)
                force=true
                ;;
            -h|--help)
                printf '%s\n' "Usage: dkey identity import PATH [--force] | dkey identity import --stdin [--force]"
                return 0
                ;;
            -*)
                fail "unknown identity import argument: $1"
                ;;
            *)
                [ -z "$src" ] || fail "identity source already set"
                src="$1"
                ;;
        esac
        shift
    done

    [ -n "$src" ] || fail "identity import requires PATH or --stdin"
    if [ -f "$AGE_IDENTITY_FILE" ] && ! $force; then
        fail "age identity already exists: $AGE_IDENTITY_FILE; pass --force to replace it"
    fi

    mkdir -p "$(dirname "$AGE_IDENTITY_FILE")"
    tmp="$AGE_IDENTITY_FILE.$$"
    if [ "$src" = "-" ]; then
        cat > "$tmp"
    else
        [ -f "$src" ] || fail "identity source not found: $src"
        cp "$src" "$tmp"
    fi

    age-keygen -y "$tmp" >/dev/null 2>&1 || {
        rm -f "$tmp"
        fail "invalid age identity"
    }
    chmod 600 "$tmp"
    mv "$tmp" "$AGE_IDENTITY_FILE"
    info "imported age identity: $AGE_IDENTITY_FILE"
}

identity_cmd() {
    sub="${1:-}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        import) identity_import_cmd "$@" ;;
        *) fail "usage: dkey identity import PATH [--force] | dkey identity import --stdin [--force]" ;;
    esac
}

public_recipient_from_identity() {
    [ -f "$AGE_IDENTITY_FILE" ] || return 1
    age-keygen -y "$AGE_IDENTITY_FILE" 2>/dev/null
}

encrypt_plaintext() {
    in="$1"
    out="$2"
    need_age
    command -v age-keygen >/dev/null 2>&1 || fail "age-keygen is required"
    recipient="$(public_recipient_from_identity)" || fail "age identity missing at $AGE_IDENTITY_FILE"
    tmp="$out.$$"
    age -r "$recipient" -o "$tmp" "$in"
    mv "$tmp" "$out"
}

decrypt_keys() {
    need_age
    [ -f "$KEYS_FILE" ] || fail "keys file missing: $KEYS_FILE"
    [ -f "$AGE_IDENTITY_FILE" ] || fail "age identity missing: $AGE_IDENTITY_FILE"
    age -d -i "$AGE_IDENTITY_FILE" "$KEYS_FILE"
}

validate_key_name() {
    name="$1"
    printf '%s' "$name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$' || fail "invalid key name: $name"
}

set_key_cmd() {
    ensure_dirs
    [ "$#" -gt 0 ] || fail "usage: dkey set NAME VALUE | dkey set NAME=VALUE"
    case "$1" in
        *=*)
            name="${1%%=*}"
            value="${1#*=}"
            [ "$#" -eq 1 ] || fail "usage: dkey set NAME=VALUE"
            ;;
        *)
            name="$1"
            shift
            [ "$#" -gt 0 ] || fail "usage: dkey set NAME VALUE"
            value="$*"
            ;;
    esac
    validate_key_name "$name"

    tmp="$SECRETS_DIR/.keys.env.$$"
    if [ -f "$KEYS_FILE" ]; then
        decrypt_keys > "$tmp"
    else
        sample_keys > "$tmp"
    fi

    if grep -q -E "^${name}=" "$tmp"; then
        tmp2="$SECRETS_DIR/.keys.env.set.$$"
        awk -v key="$name" -v value="$value" '
            BEGIN { done = 0 }
            $0 ~ /^[[:space:]]*#/ { print; next }
            index($0, key "=") == 1 {
                print key "=" value
                done = 1
                next
            }
            { print }
            END {
                if (!done) {
                    print key "=" value
                }
            }
        ' "$tmp" > "$tmp2"
        mv "$tmp2" "$tmp"
    else
        printf '%s=%s\n' "$name" "$value" >> "$tmp"
    fi

    encrypt_plaintext "$tmp" "$KEYS_FILE"
    rm -f "$tmp"
    info "set $name in $KEYS_FILE"
}

init_cmd() {
    ensure_dirs
    if [ ! -f "$GRANTS_FILE" ]; then
        sample_grants > "$GRANTS_FILE"
        info "created $GRANTS_FILE"
    else
        info "current $GRANTS_FILE"
    fi
    if [ ! -f "$KEYS_FILE" ]; then
        template="$SECRETS_DIR/keys.env.template"
        if [ ! -f "$template" ]; then
            sample_keys > "$template"
            info "created $template"
        else
            info "current $template"
        fi
        if have_age_tools && [ -f "$AGE_IDENTITY_FILE" ]; then
            encrypt_plaintext "$template" "$KEYS_FILE"
            info "created $KEYS_FILE"
        else
            warn "encrypted keys not created; install age, run dkey keygen, then run dkey set NAME VALUE"
        fi
    else
        info "current $KEYS_FILE"
        if [ ! -f "$AGE_IDENTITY_FILE" ]; then
            warn "keys file exists but age identity not found; run: dkey identity import --stdin"
        fi
    fi
    if [ ! -f "$PROVIDERS_FILE" ]; then
        providers_template="$TEMPLATE_DIR/dkey.providers.example.json"
        if [ -f "$providers_template" ]; then
            cp "$providers_template" "$PROVIDERS_FILE"
            info "created $PROVIDERS_FILE"
        else
            warn "providers template not found at $providers_template"
        fi
    else
        info "current $PROVIDERS_FILE"
    fi
}

edit_cmd() {
    ensure_dirs
    editor="${EDITOR:-vi}"
    tmp="$SECRETS_DIR/.keys.env.$$"
    if [ -f "$KEYS_FILE" ]; then
        decrypt_keys > "$tmp"
    else
        sample_keys > "$tmp"
    fi
    "$editor" "$tmp"
    encrypt_plaintext "$tmp" "$KEYS_FILE"
    rm -f "$tmp"
    info "updated $KEYS_FILE"
}

grant_line() {
    grant="$1"
    [ -f "$GRANTS_FILE" ] || fail "grants file missing: $GRANTS_FILE"
    grep -E "^grant:${grant}:" "$GRANTS_FILE" | tail -n 1 || true
}

extra_line() {
    grant="$1"
    [ -f "$GRANTS_FILE" ] || return 0
    grep -E "^extra:${grant}:" "$GRANTS_FILE" | tail -n 1 || true
}

list_cmd() {
    if [ ! -f "$KEYS_FILE" ]; then
        warn "keys file missing: $KEYS_FILE"
        return 0
    fi
    decrypt_keys | awk -F= '
        $0 ~ /^[[:space:]]*#/ { next }
        $1 ~ /^[A-Za-z_][A-Za-z0-9_]*$/ { print $1 }
    ' | sort -u
}

grant_list_cmd() {
    if [ ! -f "$GRANTS_FILE" ]; then
        warn "grants file missing: $GRANTS_FILE"
        return 0
    fi
    awk -F: '/^grant:/ { print $2 }' "$GRANTS_FILE" | sort -u
}

lookup_secret() {
    name="$1"
    # Reads plaintext env lines from stdin.
    awk -F= -v key="$name" '
        $0 ~ /^[[:space:]]*#/ { next }
        $1 == key {
            sub(/^[^=]*=/, "")
            print
            found=1
            exit
        }
        END { if (!found) exit 1 }
    '
}

secret_value() {
    name="$1"
    decrypt_keys | lookup_secret "$name"
}

expand_home_path() {
    path="$1"
    case "$path" in
        "~") printf '%s\n' "$HOME_DIR" ;;
        "~/"*) printf '%s/%s\n' "$HOME_DIR" "$(printf '%s' "$path" | sed 's|^~/||')" ;;
        *) printf '%s\n' "$path" ;;
    esac
}

write_file_if_changed() {
    target="$1"
    tmp="$2"
    mkdir -p "$(dirname "$target")"
    if [ -f "$target" ] && cmp -s "$target" "$tmp"; then
        rm -f "$tmp"
        info "current $target"
        return 0
    fi
    mv "$tmp" "$target"
    info "wrote $target"
}

normalize_lf_file() {
    _dkey_normalize_file="$1"
    _dkey_normalize_tmp="$DOT_DIR/var/normalize-lf.$$"
    tr -d '\r' < "$_dkey_normalize_file" > "$_dkey_normalize_tmp"
    mv "$_dkey_normalize_tmp" "$_dkey_normalize_file"
}

toml_quote() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'
}

shell_quote() {
    # Single-quote for POSIX shell eval.
    sed "s/'/'\\\\''/g; s/^/'/; s/$/'/"
}

use_usage() {
    cat <<'EOF'
Usage:
  dkey use claude:BACKEND[:PROFILE]
  dkey use codex:BACKEND[:PROFILE]
  dkey use all:BACKEND[:PROFILE]

Examples:
  dkey use claude:deepseek
  dkey use codex:qwen
  dkey use codex:qwen:payg-global

Writes backend settings from ~/.agents/secrets/dkey.providers.json.
Claude-compatible tools read ~/.claude/settings.json.
Codex reads ~/.codex/config.toml and ~/.codex/auth.json.
EOF
}

profile_has_harness() {
    provider="$1"
    profile="$2"
    harness="$3"
    jq -e --arg provider "$provider" --arg profile "$profile" --arg harness "$harness" \
        '.providers[$provider].profiles[$profile][$harness] != null' "$PROVIDERS_FILE" >/dev/null
}

write_claude_use() {
    provider="$1"
    profile="$2"
    need_jq

    settings_path="$(expand_home_path "$(jq -r '.defaults.claude.settings_path // "~/.claude/settings.json"' "$PROVIDERS_FILE")")"
    home_path="$(expand_home_path "$(jq -r '.defaults.claude.home_path // "~/.claude.json"' "$PROVIDERS_FILE")")"
    mkdir -p "$(dirname "$settings_path")" "$(dirname "$home_path")" "$DOT_DIR/var"

    tmp="$DOT_DIR/var/claude-settings.$$"
    tmp2="$DOT_DIR/var/claude-settings2.$$"
    if [ -f "$settings_path" ]; then
        cp "$settings_path" "$tmp"
    else
        printf '{}\n' > "$tmp"
    fi

    managed="$(jq -c '.defaults.claude.managed_env_keys // []' "$PROVIDERS_FILE")"
    jq --argjson keys "$managed" '
        .env = (.env // {})
        | .env |= with_entries(select((.key | $keys | index(.)) | not))
    ' "$tmp" > "$tmp2"
    mv "$tmp2" "$tmp"

    entries="$DOT_DIR/var/claude-env.$$"
    jq -r --arg provider "$provider" --arg profile "$profile" '
        ((.defaults.claude.settings.env // {}) + (.providers[$provider].profiles[$profile].claude.settings.env // {}))
        | to_entries[]
        | if ((.value | type) == "object" and (.value.secret != null))
          then [.key, "secret", .value.secret]
          else [.key, "literal", (.value | tostring)]
          end
        | @tsv
    ' "$PROVIDERS_FILE" > "$entries"
    normalize_lf_file "$entries"

    while IFS="$(printf '\t')" read -r key kind value; do
        [ -n "$key" ] || continue
        if [ "$kind" = "secret" ]; then
            resolved="$(secret_value "$value")" || fail "secret not found: $value"
        else
            resolved="$value"
        fi
        jq --arg key "$key" --arg value "$resolved" '.env[$key] = $value' "$tmp" > "$tmp2"
        mv "$tmp2" "$tmp"
    done < "$entries"
    rm -f "$entries"

    write_file_if_changed "$settings_path" "$tmp"

    home_obj="$(jq -c --arg provider "$provider" --arg profile "$profile" '
        (.defaults.claude.home // {}) * (.providers[$provider].profiles[$profile].claude.home // {})
    ' "$PROVIDERS_FILE")"
    if [ "$home_obj" != "{}" ]; then
        tmp="$DOT_DIR/var/claude-home.$$"
        tmp2="$DOT_DIR/var/claude-home2.$$"
        if [ -f "$home_path" ]; then
            cp "$home_path" "$tmp"
        else
            printf '{}\n' > "$tmp"
        fi
        jq --argjson home "$home_obj" '. * $home' "$tmp" > "$tmp2"
        mv "$tmp2" "$tmp"
        write_file_if_changed "$home_path" "$tmp"
    fi
    info "Claude-compatible backend: $provider:$profile"
}

write_codex_config_file() {
    provider="$1"
    profile="$2"
    config_path="$3"
    provider_id="$4"
    model="$5"
    mkdir -p "$(dirname "$config_path")" "$DOT_DIR/var"

    case "$provider_id" in
        *[!A-Za-z0-9_-]*|"") fail "invalid Codex provider id: $provider_id" ;;
    esac

    source_file="$config_path"
    if [ ! -f "$source_file" ]; then
        source_file="$DOT_DIR/var/codex-empty.$$"
        : > "$source_file"
    fi

    tmp="$DOT_DIR/var/codex-config.$$"
    rest="$DOT_DIR/var/codex-config-rest.$$"
    awk -v provider="$provider_id" '
        BEGIN { top = 1; skip = 0 }
        /^\[/ {
            top = 0
            if ($0 == "[model_providers." provider "]") {
                skip = 1
                next
            }
            skip = 0
        }
        skip { next }
        top && $0 ~ /^(model_provider|model|review_model)[[:space:]]*=/ { next }
        { print }
    ' "$source_file" > "$rest"

    {
        printf 'model_provider = %s\n' "$(toml_quote "$provider_id")"
        printf 'model = %s\n' "$(toml_quote "$model")"
        printf 'review_model = %s\n' "$(toml_quote "$model")"
        cat "$rest"
        printf '\n[model_providers.%s]\n' "$provider_id"
    } > "$tmp"

    entries="$DOT_DIR/var/codex-provider.$$"
    jq -r --arg provider "$provider" --arg profile "$profile" '
        .providers[$provider].profiles[$profile].codex.model_provider_config
        | to_entries[]
        | [.key, (.value | type), (.value | tostring)]
        | @tsv
    ' "$PROVIDERS_FILE" > "$entries"
    normalize_lf_file "$entries"
    while IFS="$(printf '\t')" read -r key kind value; do
        [ -n "$key" ] || continue
        case "$kind" in
            string) printf '%s = %s\n' "$key" "$(toml_quote "$value")" >> "$tmp" ;;
            boolean|number) printf '%s = %s\n' "$key" "$value" >> "$tmp" ;;
            *) fail "unsupported Codex provider config value for $key: $kind" ;;
        esac
    done < "$entries"
    rm -f "$entries" "$rest"
    [ "$source_file" = "$config_path" ] || rm -f "$source_file"

    write_file_if_changed "$config_path" "$tmp"
}

write_codex_auth_file() {
    secret_name="$1"
    auth_path="$HOME_DIR/.codex/auth.json"
    mkdir -p "$(dirname "$auth_path")" "$DOT_DIR/var"
    secret="$(secret_value "$secret_name")" || fail "secret not found: $secret_name"

    tmp="$DOT_DIR/var/codex-auth.$$"
    tmp2="$DOT_DIR/var/codex-auth2.$$"
    if [ -f "$auth_path" ]; then
        cp "$auth_path" "$tmp"
    else
        printf '{}\n' > "$tmp"
    fi
    jq --arg key "$secret" '.auth_mode = "apikey" | .OPENAI_API_KEY = $key' "$tmp" > "$tmp2"
    mv "$tmp2" "$tmp"
    write_file_if_changed "$auth_path" "$tmp"
}

write_codex_use() {
    provider="$1"
    profile="$2"
    strict="$3"
    need_jq

    if ! profile_has_harness "$provider" "$profile" codex; then
        if [ "$strict" = "yes" ]; then
            fail "backend profile has no Codex config: $provider:$profile"
        fi
        return 3
    fi

    status="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.status // empty' "$PROVIDERS_FILE")"
    status_message="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.status_message // empty' "$PROVIDERS_FILE")"
    if [ -n "$status" ] && [ "$status" != "supported" ]; then
        message="${status_message:-Codex profile is marked $status}"
        if [ "$strict" = "yes" ]; then
            fail "$message"
        fi
        warn "Codex backend not applied for $provider:$profile: $message"
        return 3
    fi

    wire_api="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.model_provider_config.wire_api // empty' "$PROVIDERS_FILE")"
    if [ "$wire_api" != "responses" ]; then
        message="Codex 0.130 requires a Responses API backend; $provider:$profile declares wire_api=$wire_api and has no successful Responses smoke test."
        if [ "$strict" = "yes" ]; then
            fail "$message"
        fi
        warn "Codex backend not applied for $provider:$profile: $message"
        return 3
    fi

    config_path="$(expand_home_path "$(jq -r '.defaults.codex.config_path // "~/.codex/config.toml"' "$PROVIDERS_FILE")")"
    provider_id="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.model_provider' "$PROVIDERS_FILE")"
    model="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.model' "$PROVIDERS_FILE")"
    secret_name="$(jq -r --arg provider "$provider" --arg profile "$profile" '
        (.providers[$provider].profiles[$profile].env // {} | to_entries[0].value.secret)
        // .providers[$provider].secret
        // empty
    ' "$PROVIDERS_FILE")"
    [ -n "$secret_name" ] || fail "Codex backend profile has no secret mapping: $provider:$profile"

    write_codex_config_file "$provider" "$profile" "$config_path" "$provider_id" "$model"
    write_codex_auth_file "$secret_name"
    info "Codex backend: $provider:$profile"
}

reset_cmd() {
    need_jq
    harness="$1"
    case "$harness" in
        claude|codex|all) ;;
        *) fail "reset requires: claude, codex, or all" ;;
    esac

    case "$harness" in
        claude|all)
            settings_path="$(expand_home_path "$(jq -r '.defaults.claude.settings_path // "~/.claude/settings.json"' "$PROVIDERS_FILE")")"
            if [ -f "$settings_path" ]; then
                mkdir -p "$(dirname "$settings_path")"
                # Remove all managed Claude env keys
                jq 'del(.env.ANTHROPIC_API_KEY, .env.ANTHROPIC_AUTH_TOKEN, .env.ANTHROPIC_BASE_URL, .env.ANTHROPIC_MODEL, .env.ANTHROPIC_DEFAULT_HAIKU_MODEL, .env.ANTHROPIC_DEFAULT_SONNET_MODEL, .env.ANTHROPIC_DEFAULT_OPUS_MODEL, .env.ANTHROPIC_SMALL_FAST_MODEL, .env.CLAUDE_CODE_SUBAGENT_MODEL, .env.API_TIMEOUT_MS, .env.CLAUDE_CODE_ATTRIBUTION_HEADER, .env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, .env.ENABLE_TOOL_SEARCH)' "$settings_path" > "$settings_path.tmp"
                mv "$settings_path.tmp" "$settings_path"
                info "reset Claude Code — custom backend env vars cleared"
            fi
            ;;
    esac

    case "$harness" in
        codex|all)
            config_path="$(expand_home_path "$(jq -r '.defaults.codex.config_path // "~/.codex/config.toml"' "$PROVIDERS_FILE")")"
            if [ -f "$config_path" ]; then
                mkdir -p "$(dirname "$config_path")" "$DOT_DIR/var"
                tmp="$DOT_DIR/var/codex-reset.$$"
                rest="$DOT_DIR/var/codex-reset-rest.$$"
                # Remove model_provider, model, review_model and all [model_providers.*] sections
                awk '
                    BEGIN { in_provider_section = 0 }
                    /^\[model_providers\./ { in_provider_section = 1; next }
                    /^\[/ && in_provider_section { in_provider_section = 0 }
                    in_provider_section { next }
                    /^(model_provider|model|review_model)[[:space:]]*=/ { next }
                    { print }
                ' "$config_path" > "$rest"
                cat "$rest" > "$config_path"
                rm -f "$rest" "$tmp"
                info "reset Codex — custom backend settings cleared"
            fi
            ;;
    esac
}

use_cmd() {
    need_jq
    [ -f "$PROVIDERS_FILE" ] || fail "providers registry missing: $PROVIDERS_FILE"

    target=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            help|-h|--help)
                use_usage
                return 0
                ;;
            --harness)
                fail "dkey use uses HARNESS:BACKEND syntax; try: dkey use claude:deepseek"
                ;;
            -*)
                fail "unknown use argument: $1"
                ;;
            *)
                [ -z "$target" ] || fail "dkey use accepts only one target"
                target="$1"
                ;;
        esac
        shift
    done

    [ -n "$target" ] || fail "use requires HARNESS:BACKEND[:PROFILE]"
    harness="${target%%:*}"
    if [ "$target" = "$harness" ]; then
        fail "dkey use target must be HARNESS:BACKEND[:PROFILE]; try: dkey use claude:deepseek"
    fi
    backend_spec="${target#*:}"
    case "$harness" in
        all|claude|codex) ;;
        *) fail "unknown harness in dkey use target: $harness" ;;
    esac

    provider="${backend_spec%%:*}"
    if [ "$backend_spec" != "$provider" ]; then
        profile="${backend_spec#*:}"
        case "$profile" in
            *:*) fail "dkey use supports at most HARNESS:BACKEND:PROFILE" ;;
        esac
    else
        profile="$(jq -r --arg provider "$provider" '.providers[$provider].default_profile // empty' "$PROVIDERS_FILE")"
    fi
    [ -n "$provider" ] || fail "backend is empty"
    [ -n "$profile" ] || fail "profile is empty for backend: $provider"

    jq -e --arg provider "$provider" '.providers[$provider] != null' "$PROVIDERS_FILE" >/dev/null || fail "unknown backend: $provider"
    jq -e --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile] != null' "$PROVIDERS_FILE" >/dev/null || fail "unknown backend profile: $provider:$profile"

    applied="no"
    case "$harness" in
        all)
            if profile_has_harness "$provider" "$profile" claude; then
                write_claude_use "$provider" "$profile"
                applied="yes"
            fi
            if write_codex_use "$provider" "$profile" no; then
                applied="yes"
            else
                code="$?"
                [ "$code" = "3" ] || return "$code"
            fi
            ;;
        claude)
            profile_has_harness "$provider" "$profile" claude || fail "backend profile has no Claude-compatible config: $provider:$profile"
            write_claude_use "$provider" "$profile"
            applied="yes"
            ;;
        codex)
            write_codex_use "$provider" "$profile" yes
            applied="yes"
            ;;
        *)
            fail "unknown harness: $harness"
            ;;
    esac

    [ "$applied" = "yes" ] || fail "no applicable harness config for backend profile $provider:$profile"
}

emit_exports_for_grant() {
    grant="$1"
    line="$(grant_line "$grant")"
    [ -n "$line" ] || fail "grant not found: $grant"
    mapping="${line#grant:${grant}:}"
    keys_plain="$(decrypt_keys)"

    old_ifs="$IFS"
    IFS=','
    for pair in $mapping; do
        env_name="${pair%%=*}"
        secret_name="${pair#*=}"
        [ -n "$env_name" ] && [ -n "$secret_name" ] || fail "bad grant mapping: $pair"
        value="$(printf '%s\n' "$keys_plain" | lookup_secret "$secret_name")" || fail "secret not found: $secret_name"
        quoted="$(printf '%s' "$value" | shell_quote)"
        printf 'export %s=%s\n' "$env_name" "$quoted"
        managed="${managed:-}${managed:+ }$env_name"
    done
    IFS="$old_ifs"

    extra="$(extra_line "$grant")"
    if [ -n "$extra" ]; then
        extras="${extra#extra:${grant}:}"
        IFS=','
        for pair in $extras; do
            env_name="${pair%%=*}"
            value="${pair#*=}"
            quoted="$(printf '%s' "$value" | shell_quote)"
            printf 'export %s=%s\n' "$env_name" "$quoted"
            managed="${managed:-}${managed:+ }$env_name"
        done
        IFS="$old_ifs"
    fi

    printf 'export DKEY_ACTIVE_GRANT=%s\n' "$(printf '%s' "$grant" | shell_quote)"
    printf 'export DKEY_MANAGED_VARS=%s\n' "$(printf '%s' "${managed:-}" | shell_quote)"
}

emit_exports_for_grants() {
    grants="$1"
    [ -n "$grants" ] || fail "grant list is empty"
    keys_plain="$(decrypt_keys)"
    managed=""
    active=""

    for grant in $grants; do
        line="$(grant_line "$grant")"
        [ -n "$line" ] || fail "grant not found: $grant"
        mapping="${line#grant:${grant}:}"

        old_ifs="$IFS"
        IFS=','
        for pair in $mapping; do
            env_name="${pair%%=*}"
            secret_name="${pair#*=}"
            [ -n "$env_name" ] && [ -n "$secret_name" ] || fail "bad grant mapping: $pair"
            value="$(printf '%s\n' "$keys_plain" | lookup_secret "$secret_name")" || fail "secret not found: $secret_name"
            quoted="$(printf '%s' "$value" | shell_quote)"
            printf 'export %s=%s\n' "$env_name" "$quoted"
            managed="${managed:-}${managed:+ }$env_name"
        done
        IFS="$old_ifs"

        extra="$(extra_line "$grant")"
        if [ -n "$extra" ]; then
            extras="${extra#extra:${grant}:}"
            IFS=','
            for pair in $extras; do
                env_name="${pair%%=*}"
                value="${pair#*=}"
                quoted="$(printf '%s' "$value" | shell_quote)"
                printf 'export %s=%s\n' "$env_name" "$quoted"
                managed="${managed:-}${managed:+ }$env_name"
            done
            IFS="$old_ifs"
        fi

        active="${active:-}${active:+,}$grant"
    done

    printf 'export DKEY_ACTIVE_GRANT=%s\n' "$(printf '%s' "$active" | shell_quote)"
    printf 'export DKEY_MANAGED_VARS=%s\n' "$(printf '%s' "$managed" | shell_quote)"
}

emit_exports_for_all_keys() {
    keys_plain="$(decrypt_keys)"
    managed=""
    printf '%s\n' "$keys_plain" | while IFS= read -r line; do
        case "$line" in
            ""|\#*) continue ;;
            *=*)
                env_name="${line%%=*}"
                value="${line#*=}"
                validate_key_name "$env_name"
                quoted="$(printf '%s' "$value" | shell_quote)"
                printf 'export %s=%s\n' "$env_name" "$quoted"
                managed="${managed:-}${managed:+ }$env_name"
                ;;
        esac
    done
    managed="$(printf '%s\n' "$keys_plain" | awk -F= '
        $0 ~ /^[[:space:]]*#/ { next }
        $1 ~ /^[A-Za-z_][A-Za-z0-9_]*$/ {
            if (managed != "") managed = managed " "
            managed = managed $1
        }
        END { print managed }
    ')"
    printf 'export DKEY_ACTIVE_GRANT=%s\n' "'all'"
    printf 'export DKEY_MANAGED_VARS=%s\n' "$(printf '%s' "$managed" | shell_quote)"
}

shell_on_cmd() {
    [ "${DKEY_EMIT_SHELL:-}" = "1" ] || fail "dkey on requires dot shell integration; run '. ~/.agents/.dotpanel/env.sh' first"
    grants=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --with)
                shift
                [ "$#" -gt 0 ] || fail "--with requires a grant"
                grants="${grants:-}${grants:+ }$1"
                ;;
            *) fail "unknown shell on argument: $1" ;;
        esac
        shift
    done
    if [ -n "$grants" ]; then
        emit_exports_for_grants "$grants"
    else
        emit_exports_for_all_keys
    fi
}

shell_off_cmd() {
    cat <<'EOF'
if [ -n "${DKEY_MANAGED_VARS:-}" ]; then
    for _dkey_var in $DKEY_MANAGED_VARS; do
        unset "$_dkey_var"
    done
fi
unset DKEY_ACTIVE_GRANT
unset DKEY_MANAGED_VARS
unset _dkey_var
EOF
}

run_cmd() {
    grants=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --with)
                shift
                [ "$#" -gt 0 ] || fail "--with requires a grant"
                grants="${grants:-}${grants:+ }$1"
                ;;
            --)
                shift
                break
                ;;
            *) fail "unknown run argument: $1" ;;
        esac
        shift
    done
    [ -n "$grants" ] || fail "run requires --with GRANT"
    [ "$#" -gt 0 ] || fail "run requires a command after --"

    env_script="$(emit_exports_for_grants "$grants")"
    # Apply only in this process, then exec target.
    eval "$env_script"
    exec "$@"
}

status_cmd() {
    if [ -n "${DKEY_ACTIVE_GRANT:-}" ]; then
        printf 'active grant: %s\n' "$DKEY_ACTIVE_GRANT"
        printf 'managed vars: %s\n' "${DKEY_MANAGED_VARS:-}"
    else
        printf 'active grant: none\n'
    fi
}

doctor_cmd() {
    problems=0
    command -v age >/dev/null 2>&1 && info "age found" || { warn "age missing"; problems=$((problems + 1)); }
    command -v age-keygen >/dev/null 2>&1 && info "age-keygen found" || { warn "age-keygen missing"; problems=$((problems + 1)); }
    command -v jq >/dev/null 2>&1 && info "jq found" || { warn "jq missing"; problems=$((problems + 1)); }
    [ -f "$AGE_IDENTITY_FILE" ] && info "age identity exists: $AGE_IDENTITY_FILE" || warn "age identity missing: $AGE_IDENTITY_FILE"
    [ -f "$KEYS_FILE" ] && info "keys file exists: $KEYS_FILE" || warn "keys file missing: $KEYS_FILE"
    [ -f "$GRANTS_FILE" ] && info "grants file exists: $GRANTS_FILE" || warn "grants file missing: $GRANTS_FILE"
    if [ -f "$PROVIDERS_FILE" ]; then
        if command -v jq >/dev/null 2>&1; then
            if jq -e '.version and .defaults and .providers' "$PROVIDERS_FILE" >/dev/null 2>&1; then
                info "providers registry valid: $PROVIDERS_FILE"
            else
                warn "providers registry invalid (missing version/defaults/providers): $PROVIDERS_FILE"
                problems=$((problems + 1))
            fi
        else
            info "providers registry exists: $PROVIDERS_FILE"
        fi
    else
        warn "providers registry missing: $PROVIDERS_FILE"
    fi
    [ "$problems" -eq 0 ] || return 2
}

shell_cmd() {
    sub="${1:-}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        on) shell_on_cmd "$@" ;;
        off) shell_off_cmd ;;
        *) fail "usage: dkey shell on [--with GRANT] | dkey shell off" ;;
    esac
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$cmd" in
    init) init_cmd "$@" ;;
    keygen) keygen_cmd "$@" ;;
    identity) identity_cmd "$@" ;;
    set) set_key_cmd "$@" ;;
    edit) edit_cmd "$@" ;;
    list) list_cmd "$@" ;;
    use) use_cmd "$@" ;;
    reset) reset_cmd "$@" ;;
    grants) grant_list_cmd "$@" ;;
    run) run_cmd "$@" ;;
    on) shell_on_cmd "$@" ;;
    off) shell_off_cmd "$@" ;;
    shell) shell_cmd "$@" ;;
    status) status_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    version|--version|-v) version ;;
    help|--help|-h) usage ;;
    *) fail "unknown command: $cmd" ;;
esac
