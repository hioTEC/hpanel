#!/bin/sh
# dot - minimal memspace sync/render helper.
#
# Philosophy:
#   ~/.agents/ is the user's memspace and source of truth.
#   ~/.agents/AGENTS.md is the entry.
#   ~/.agents/.dotpanel/ is managed local tooling and must be gitignored.

set -eu

VERSION="0.1.0-vnext"

HOME_DIR="${HOME:?HOME is required}"
AGENTS_DIR="${DOT_AGENTS_DIR:-$HOME_DIR/.agents}"
DOT_DIR="$AGENTS_DIR/.dotpanel"
ENTRY_FILE="$AGENTS_DIR/AGENTS.md"
GITIGNORE_FILE="$AGENTS_DIR/.gitignore"
CLAUDE_SKILLS="$HOME_DIR/.claude/skills"
DOT_BIN="$DOT_DIR/bin"
TOOLS_BIN="$AGENTS_DIR/tools/bin"
ENV_FILE="$DOT_DIR/env.sh"
TEMPLATE_ENTRY="$DOT_DIR/templates/AGENTS.md"

info() { printf 'OK  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

need_git() {
    command -v git >/dev/null 2>&1 || fail "git is required"
}

is_git_repo() {
    git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

usage() {
    cat <<'EOF'
dot - minimal memspace sync/render helper

Usage:
  dot init [--template|--blank|--from PATH|--no-entry] [--yes] [--no-path]
  dot set -a|--all
  dot set TARGET [TARGET...]
  dot unset -a|--all
  dot unset TARGET [TARGET...]
  dot configure [--harness all|claude|codex|kimi]
  dot doctor
  dot sync status|diff|pull|push
  dot self status|update
  dot version
  dot help

TARGET = path | claude | codex | kimi
  path is the shell integration (env.sh + rc source line).
  -a|--all expands to: path claude codex kimi.

Core invariant:
  ~/.agents/ is your memspace; ~/.agents/AGENTS.md is the entry.
  ~/.agents/.dotpanel/ is managed by dot and must be gitignored.
EOF
}

version() {
    printf 'dot %s\n' "$VERSION"
}

ensure_agents_dir() {
    mkdir -p "$AGENTS_DIR" "$DOT_DIR/var"
}

ensure_gitignore() {
    ensure_agents_dir
    touch "$GITIGNORE_FILE"
    if ! grep -qxF '/.dotpanel/' "$GITIGNORE_FILE"; then
        printf '\n/.dotpanel/\n' >> "$GITIGNORE_FILE"
        info "added /.dotpanel/ to $GITIGNORE_FILE"
    else
        info "$GITIGNORE_FILE already ignores /.dotpanel/"
    fi
}

path_source_line() {
    printf '[ -f "%s" ] && . "%s"\n' "$ENV_FILE" "$ENV_FILE"
}

write_env_file() {
    ensure_agents_dir
    tmp="$DOT_DIR/var/env.$$"
cat > "$tmp" <<EOF
# Generated by dot init; do not edit directly.
case ":\$PATH:" in
    *":$DOT_BIN:"*) ;;
    *) export PATH="$DOT_BIN:\$PATH" ;;
esac
case ":\$PATH:" in
    *":$TOOLS_BIN:"*) ;;
    *) export PATH="$TOOLS_BIN:\$PATH" ;;
esac

dkey() {
    case "\${1:-}" in
        on)
            shift
            eval "\$(DKEY_EMIT_SHELL=1 command dkey on "\$@")"
            ;;
        off)
            shift
            eval "\$(command dkey off "\$@")"
            ;;
        *)
            command dkey "\$@"
            ;;
    esac
}

# claw/clawb (claude) and codx/codxb (codex) live in ~/.agents/tools/bin/
# (added to PATH above) — per-invocation backend switch via dkey.providers.json.
# No aliases emitted here.
EOF
    if [ -f "$ENV_FILE" ] && cmp -s "$ENV_FILE" "$tmp"; then
        rm -f "$tmp"
        info "current $ENV_FILE"
    else
        mv "$tmp" "$ENV_FILE"
        info "wrote $ENV_FILE"
    fi
}

shell_rc_files() {
    if [ -n "${DOT_SHELL_RC:-}" ]; then
        printf '%s\n' "$DOT_SHELL_RC"
        return 0
    fi
    case "$(basename -- "${SHELL:-}")" in
        zsh)
            printf '%s\n' "${ZDOTDIR:-$HOME_DIR}/.zshrc"
            ;;
        *)
            printf '%s\n' "$HOME_DIR/.bashrc"
            printf '%s\n' "$HOME_DIR/.bash_profile"
            printf '%s\n' "$HOME_DIR/.profile"
            ;;
    esac
}

inject_shell_rc() {
    line="$(path_source_line)"
    shell_rc_files | while IFS= read -r rc; do
        [ -n "$rc" ] || continue
        mkdir -p "$(dirname "$rc")"
        touch "$rc"
        if grep -qxF "$line" "$rc"; then
            info "$rc already sources dot env"
            continue
        fi
        {
            printf '\n# dot: memspace tools PATH\n'
            printf '%s\n' "$line"
        } >> "$rc"
        info "added dot env source line to $rc"
    done
}

path_cmd() {
    write_env_file
    inject_shell_rc
    # This affects only this process and any commands still run by this script.
    # The caller's already-running shell must source ENV_FILE or open a new shell.
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    info "dotpanel bin is on PATH via $ENV_FILE: $DOT_BIN"
    if command -v dot >/dev/null 2>&1; then
        info "dot is available in this process: $(command -v dot)"
    else
        warn "dot is not on this shell's PATH yet"
    fi
    if command -v dkey >/dev/null 2>&1; then
        info "dkey is available in this process: $(command -v dkey)"
    else
        warn "dkey is not on this shell's PATH yet"
    fi
    printf 'For this already-open shell, run:\n  . "%s"\n' "$ENV_FILE"
}

first_nonempty_line() {
    # first_nonempty_line <file>
    awk 'NF { print; exit }' "$1" 2>/dev/null || true
}

find_entry_candidates() {
    # Print NUL-free tab-separated records: path<TAB>first line.
    # Scope: home root plus one level down.
    find "$HOME_DIR" -maxdepth 2 \( -name AGENTS.md -o -name CLAUDE.md \) \
        -type f 2>/dev/null | sort | while IFS= read -r file; do
            case "$file" in
                "$ENTRY_FILE"|"$DOT_DIR"/*) continue ;;
            esac
            line="$(first_nonempty_line "$file")"
            printf '%s\t%s\n' "$file" "$line"
        done
}

write_template_entry() {
    if [ -f "$TEMPLATE_ENTRY" ]; then
        cp "$TEMPLATE_ENTRY" "$ENTRY_FILE"
        return 0
    fi
    cat > "$ENTRY_FILE" <<'EOF'
# User Memspace

`~/.agents/` is the private memspace.
`~/.agents/AGENTS.md` is the entry.

Read this file first. Then read project-local `./.agents/AGENTS.md` when it
exists. Do not recursively scan `~/.agents/` or `./.agents/`; read only entry
files, files they explicitly reference, or files the user names.

## Voice

Describe operator voice, language preferences, and durable artifact language
here.

## Default Posture

- Follow the user's direct instructions first.
- Read before advising. When the real problem sits one layer lower than the
  question, name that lower layer.
- Default ambiguous requests to exploration and decision. Reserve file writes,
  commits, broad scripts, and agent spawning for explicit implementation verbs
  or clear task ownership.

## Read Families

Keep this entry self-contained at first. Add a route only after its target
exists, and lazy-load only the named files. Link to one source of truth instead
of copying its contents into this entry.

## Hard Edges

Follow the user's direct instructions first.

`~/.agents/.dotpanel/` is managed public tooling; do not edit it unless the
task is about dotpanel itself.

`dkey` is privileged. Subagents must refuse any `dkey` invocation or wrapper
known to use it. `dkey on` exports all encrypted keys into the current shell;
prefer grant-scoped forms for resource operations when practical.

Never output secret values in logs or responses.

## Memspace Tooling

`dot init` is bootstrap. Install scripts run it once; day-to-day use should not
need it.

Use `dot set -a` after editing `~/.agents/AGENTS.md` or after pulling memspace
changes. It renders the managed Claude, Codex, and Kimi entry files. Use
`dot set claude`, `dot set codex`, or `dot set kimi` for one harness.

Use `dot sync status`, `dot sync diff`, `dot sync pull`, and `dot sync push` to
move the memspace repo across machines. `dot sync pull` fetches, requires a
clean worktree and a fast-forward path, then re-renders entries. `dot sync push`
requires a clean worktree and pushes existing commits only; it never stages or
commits files.

Use `dkey keygen` once to create the local age identity. Use
`dkey set NAME VALUE` or `dkey set NAME=VALUE` to create or overwrite encrypted
keys, `dkey list` to list key names, `dkey on` to export all keys to the
current shell, and `dkey off` to remove variables set by `dkey on`.

## Layout

- `bin/` — user-owned command wrappers and ops verbs.
- `infra/` — machines, domains, services, desired state, network notes.
- `secrets/` — encrypted or template secret material; no plaintext real keys.
- `rules/` — behavior policy and scenario closure cards.
- `skills/` — optional user-authored skills; lazy load only when relevant.
- `journal/` — cross-session lessons; lazy load only when improving rules or doing retrospectives.
- `reference/` — optional long-form notes; lazy load only when relevant.
- `tools/` — helper libraries, templates, and docs used by `bin/`.
- `.dotpanel/` — managed checkout of the public `dot` / `dkey` tools; gitignored.
EOF
}

write_blank_entry() {
    cat > "$ENTRY_FILE" <<'EOF'
# User Memspace

`~/.agents/` is your memspace. `~/.agents/AGENTS.md` is the entry.
EOF
}

copy_entry_from() {
    src="$1"
    [ -f "$src" ] || fail "entry source not found: $src"
    cp "$src" "$ENTRY_FILE"
}

prompt_entry_seed() {
    [ -f "$ENTRY_FILE" ] && {
        info "$ENTRY_FILE already exists; leaving it unchanged"
        return 0
    }

    tmp="$DOT_DIR/var/init-candidates.tsv"
    find_entry_candidates > "$tmp"

    printf '\n%s\n' "Create $ENTRY_FILE?"
    printf '  1. Use dot template\n'

    count=1
    while IFS="$(printf '\t')" read -r path line; do
        count=$((count + 1))
        if [ -n "$line" ]; then
            printf '  %d. Use %s — %s\n' "$count" "$path" "$line"
        else
            printf '  %d. Use %s\n' "$count" "$path"
        fi
    done < "$tmp"

    blank_choice=$((count + 1))
    skip_choice=$((count + 2))
    printf '  %d. Blank AGENTS.md\n' "$blank_choice"
    printf '  %d. Skip\n' "$skip_choice"
    printf 'Select [%d]: ' "$skip_choice"

    read -r choice || choice="$skip_choice"
    [ -n "$choice" ] || choice="$skip_choice"

    if [ "$choice" = "1" ]; then
        write_template_entry
        info "created $ENTRY_FILE from template"
        return 0
    fi
    if [ "$choice" = "$blank_choice" ]; then
        write_blank_entry
        info "created blank $ENTRY_FILE"
        return 0
    fi
    if [ "$choice" = "$skip_choice" ]; then
        info "skipped entry creation"
        return 0
    fi
    if ! printf '%s' "$choice" | grep -Eq '^[0-9]+$'; then
        fail "invalid choice: $choice"
    fi
    if [ "$choice" -lt 2 ] || [ "$choice" -gt "$count" ]; then
        fail "invalid choice: $choice"
    fi

    idx=$((choice - 1))
    src="$(sed -n "${idx}p" "$tmp" | awk -F '\t' '{print $1}')"
    copy_entry_from "$src"
    info "created $ENTRY_FILE from $src"
}

init_cmd() {
    mode="prompt"
    src=""
    install_path=true

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --template) mode="template" ;;
            --blank) mode="blank" ;;
            --no-entry) mode="none" ;;
            --from)
                shift
                [ "$#" -gt 0 ] || fail "--from requires a path"
                mode="from"
                src="$1"
                ;;
            --yes|-y)
                # Non-interactive default: do not create user entry rules.
                [ "$mode" = "prompt" ] && mode="none"
                ;;
            --no-path)
                install_path=false
                ;;
            -h|--help) usage; return 0 ;;
            *) fail "unknown init argument: $1" ;;
        esac
        shift
    done

    ensure_agents_dir
    ensure_gitignore

    case "$mode" in
        template)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                write_template_entry
                info "created $ENTRY_FILE from template"
            fi
            ;;
        blank)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                write_blank_entry
                info "created blank $ENTRY_FILE"
            fi
            ;;
        from)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                copy_entry_from "$src"
                info "created $ENTRY_FILE from $src"
            fi
            ;;
        none)
            info "entry creation skipped"
            ;;
        prompt)
            prompt_entry_seed
            ;;
        *) fail "internal error: bad init mode $mode" ;;
    esac

    configure_cmd --harness all
    if $install_path; then
        path_cmd
    fi
}

wrapper_body() {
    cat <<'EOF'
<!-- Generated by dot configure; do not edit directly. -->
`~/.agents/` is your memspace. `~/.agents/AGENTS.md` is the entry.

Before doing any work, read `~/.agents/AGENTS.md` if it exists.
Then read `./.agents/AGENTS.md` if it exists in the current repository.

Do not recursively scan `~/.agents/` or `./.agents/`. Read only the entry files above, files they explicitly reference, or files the user explicitly asks for.
EOF
}

# _gen_plugin_flat <name> <src_dir> — generate a plugin from flat skill dirs.
# Scans <src_dir>/*/SKILL.md. Output: $CLAUDE_SKILLS/<name>/
_gen_plugin_flat() {
    plugin_name="$1"
    src_dir="$2"
    out_dir="$CLAUDE_SKILLS/$plugin_name"

    [ -d "$src_dir" ] || return 0

    tmp="$DOT_DIR/var/plugin.$plugin_name.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp/.claude-plugin" "$tmp/skills"

    count=0
    for skill_dir in "$src_dir"/*/; do
        [ -d "$skill_dir" ] || continue
        skill_file="$skill_dir/SKILL.md"
        [ -f "$skill_file" ] || continue

        frontmatter=$(awk 'BEGIN{c=0} /^---$/{c++; if(c==2) exit; next} c==1' "$skill_file")
        skill_name=$(printf '%s\n' "$frontmatter" | sed -n 's/^name: *//p' | head -1)
        skill_type=$(printf '%s\n' "$frontmatter" | sed -n 's/^type: *//p' | head -1)
        skill_harnesses=$(printf '%s\n' "$frontmatter" | sed -n 's/^supported_harnesses: *//p' | head -1)

        [ -n "$skill_name" ] || continue
        [ -z "$skill_type" ] || [ "$skill_type" = "skill" ] || continue
        if [ -n "$skill_harnesses" ]; then
            case "$skill_harnesses" in *claude*) ;; *) continue ;; esac
        fi

        cp -r "$skill_dir" "$tmp/skills/$skill_name"
        count=$((count + 1))
    done

    cat > "$tmp/.claude-plugin/plugin.json" <<PLUGINJSON
{
  "name": "$plugin_name",
  "description": "$plugin_name skills from memspace",
  "author": { "name": "dot" }
}
PLUGINJSON

    mkdir -p "$(dirname "$out_dir")"
    rm -rf "$out_dir"
    mv "$tmp" "$out_dir"
    info "generated $plugin_name plugin: $count skill(s) -> $out_dir"
}

# _gen_matt_plugin — generate from mattpocock/skills git clone.
# Reads upstream .claude-plugin/plugin.json for the skill manifest,
# flattens categorized paths (skills/engineering/diagnose) into flat skill dirs.
# Output: $CLAUDE_SKILLS/matt/
_gen_matt_plugin() {
    src="$AGENTS_DIR/skills/matt"
    out_dir="$CLAUDE_SKILLS/matt"
    manifest="$src/.claude-plugin/plugin.json"

    [ -d "$src" ] || return 0
    [ -f "$manifest" ] || { warn "matt plugin.json missing at $manifest"; return 0; }
    command -v jq >/dev/null || { warn "jq required for matt plugin generation"; return 0; }

    tmp="$DOT_DIR/var/plugin.matt.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp/.claude-plugin" "$tmp/skills"

    # Write skill paths to temp file to avoid subshell pipe
    skill_list="$DOT_DIR/var/.matt_skills.$$"
    jq -r '.skills[]' "$manifest" > "$skill_list"

    count=0
    while IFS= read -r skill_path; do
        [ -n "$skill_path" ] || continue
        skill_dir="$src/$skill_path"
        skill_file="$skill_dir/SKILL.md"
        [ -f "$skill_file" ] || { warn "matt skill not found: $skill_path"; continue; }

        frontmatter=$(awk 'BEGIN{c=0} /^---$/{c++; if(c==2) exit; next} c==1' "$skill_file")
        skill_name=$(printf '%s\n' "$frontmatter" | sed -n 's/^name: *//p' | head -1)
        [ -n "$skill_name" ] || continue

        cp -r "$skill_dir" "$tmp/skills/$skill_name"
        count=$((count + 1))
    done < "$skill_list"
    rm -f "$skill_list"

    cat > "$tmp/.claude-plugin/plugin.json" <<PLUGINJSON
{
  "name": "matt",
  "description": "Matt Pocock engineering & productivity skills",
  "author": { "name": "dot" }
}
PLUGINJSON

    mkdir -p "$(dirname "$out_dir")"
    rm -rf "$out_dir"
    mv "$tmp" "$out_dir"
    info "generated matt plugin: $count skill(s) -> $out_dir"
}

# _gen_impeccable_plugin — generate from pbakaus/impeccable git clone.
# Moves scripts/ to plugin root so hardcoded .claude/skills/impeccable/scripts/
# paths work natively. reference/ stays inside the skill dir for relative refs.
# Output: $CLAUDE_SKILLS/impeccable/
_gen_impeccable_plugin() {
    src="$AGENTS_DIR/skills/impeccable"
    skill_src="$src/plugin/skills/impeccable"
    out_dir="$CLAUDE_SKILLS/impeccable"

    [ -d "$skill_src" ] || { warn "impeccable skill not found at $skill_src"; return 0; }

    tmp="$DOT_DIR/var/plugin.impeccable.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp/.claude-plugin" "$tmp/skills/impeccable"

    # SKILL.md + reference/ stay inside skills/impeccable/
    cp "$skill_src/SKILL.md" "$tmp/skills/impeccable/"
    if [ -d "$skill_src/reference" ]; then
        cp -r "$skill_src/reference" "$tmp/skills/impeccable/reference"
    fi

    # Scripts go to plugin root so .claude/skills/impeccable/scripts/ works
    if [ -d "$skill_src/scripts" ]; then
        cp -r "$skill_src/scripts" "$tmp/scripts"
    fi

    # Agents (if any)
    if [ -d "$src/plugin/agents" ]; then
        cp -r "$src/plugin/agents" "$tmp/agents"
    fi

    cat > "$tmp/.claude-plugin/plugin.json" <<PLUGINJSON
{
  "name": "impeccable",
  "description": "Frontend design & craft skill — 23 sub-commands",
  "author": { "name": "dot" }
}
PLUGINJSON

    mkdir -p "$(dirname "$out_dir")"
    rm -rf "$out_dir"
    mv "$tmp" "$out_dir"
    info "generated impeccable plugin -> $out_dir"
}

generate_claude_plugins() {
    # Build per-source Claude Code plugins from ~/.agents/skills/{hio,matt,impeccable}/.
    # Output: ~/.claude/skills/{hio,matt,impeccable}/
    # Claude Code auto-discovers plugins with .claude-plugin/plugin.json in this directory.
    SKILLS_SRC="$AGENTS_DIR/skills"
    [ -d "$SKILLS_SRC" ] || return 0

    _gen_plugin_flat "hio" "$SKILLS_SRC/hio"
    _gen_matt_plugin
    _gen_impeccable_plugin
}

write_file_if_changed() {
    target="$1"
    tmp="$2"
    mkdir -p "$(dirname "$target")"
    if [ -f "$target" ] && cmp -s "$target" "$tmp"; then
        rm -f "$tmp"
        info "current $target"
        return 0
    fi
    mv "$tmp" "$target"
    info "wrote $target"
}

configure_one() {
    harness="$1"
    case "$harness" in
        claude)
            target="$HOME_DIR/.claude/CLAUDE.md"
            generate_claude_plugins
            ;;
        codex) target="$HOME_DIR/.codex/AGENTS.md" ;;
        kimi) target="$HOME_DIR/.kimi/AGENTS.md" ;;
        *) fail "unknown harness: $harness" ;;
    esac
    tmp="$DOT_DIR/var/wrapper.$harness.$$"
    wrapper_body > "$tmp"
    write_file_if_changed "$target" "$tmp"
}

configure_cmd() {
    harness="all"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --harness)
                shift
                [ "$#" -gt 0 ] || fail "--harness requires a value"
                harness="$1"
                ;;
            -h|--help) usage; return 0 ;;
            *) fail "unknown configure argument: $1" ;;
        esac
        shift
    done

    ensure_agents_dir
    case "$harness" in
        all)
            configure_one claude
            configure_one codex
            configure_one kimi
            ;;
        claude|codex|kimi)
            configure_one "$harness"
            ;;
        *) fail "unknown harness: $harness" ;;
    esac
    write_env_file
}

set_usage() {
    cat <<'EOF'
Usage:
  dot set -a|--all
  dot set TARGET [TARGET...]

TARGET = path | claude | codex | kimi

  path   - write env.sh and inject the source line into the shell rc
  claude - render ~/.claude/CLAUDE.md and generate .claude/skills/ plugins (hio/matt/impeccable)
  codex  - render ~/.codex/AGENTS.md
  kimi   - render ~/.kimi/AGENTS.md

-a|--all expands to: path claude codex kimi
EOF
}

set_cmd() {
    targets=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--all|all) targets="path claude codex kimi" ;;
            --harness)
                shift
                [ "$#" -gt 0 ] || fail "--harness requires a value"
                case "$1" in
                    all) targets="path claude codex kimi" ;;
                    claude|codex|kimi) targets="$targets $1" ;;
                    *) fail "unknown harness: $1" ;;
                esac
                ;;
            path|claude|codex|kimi) targets="$targets $1" ;;
            help|-h|--help) set_usage; return 0 ;;
            *) fail "unknown set argument: $1" ;;
        esac
        shift
    done
    [ -n "$targets" ] || fail "set requires -a|--all or a target name"

    ensure_agents_dir
    do_path=0
    for t in $targets; do
        case "$t" in
            path) do_path=1 ;;
            claude|codex|kimi) configure_one "$t" ;;
        esac
    done
    if [ "$do_path" -eq 1 ]; then
        path_cmd
    else
        write_env_file
    fi
}

unset_usage() {
    cat <<'EOF'
Usage:
  dot unset -a|--all
  dot unset TARGET [TARGET...]

TARGET = path | claude | codex | kimi

  path   - remove the source line from shell rc and delete env.sh
  claude - delete ~/.claude/CLAUDE.md and the generated plugin directories
  codex  - delete ~/.codex/AGENTS.md
  kimi   - delete ~/.kimi/AGENTS.md

-a|--all expands to: path claude codex kimi.
A wrapper file is only removed if it carries the dot-generated header;
hand-edited files are left untouched.
EOF
}

unset_one() {
    harness="$1"
    case "$harness" in
        claude) target="$HOME_DIR/.claude/CLAUDE.md" ;;
        codex)  target="$HOME_DIR/.codex/AGENTS.md" ;;
        kimi)   target="$HOME_DIR/.kimi/AGENTS.md" ;;
        *) fail "unknown harness: $harness" ;;
    esac
    if [ -f "$target" ]; then
        if grep -q 'Generated by dot configure' "$target"; then
            rm -f "$target"
            info "removed $target"
        else
            warn "$target not generated by dot; leaving untouched"
        fi
    else
        info "$target already absent"
    fi
    if [ "$harness" = "claude" ]; then
        for plugin_name in hio matt impeccable; do
            plugin_dir="$CLAUDE_SKILLS/$plugin_name"
            if [ -d "$plugin_dir/.claude-plugin" ]; then
                rm -rf "$plugin_dir"
                info "removed $plugin_dir"
            else
                info "$plugin_dir already absent"
            fi
        done
    fi
}

uninject_shell_rc() {
    line="$(path_source_line)"
    shell_rc_files | while IFS= read -r rc; do
        [ -n "$rc" ] || continue
        [ -f "$rc" ] || continue
        if ! grep -qxF "$line" "$rc"; then
            info "$rc has no dot env source line"
            continue
        fi
        ensure_agents_dir
        tmp="$DOT_DIR/var/rc.$$"
        awk -v target="$line" '
            {
                if ($0 == target) {
                    if (have_prev && prev == "# dot: memspace tools PATH") {
                        have_prev = 0
                        prev = ""
                    } else if (have_prev) {
                        print prev
                        have_prev = 0
                        prev = ""
                    }
                    next
                }
                if (have_prev) print prev
                prev = $0
                have_prev = 1
            }
            END { if (have_prev) print prev }
        ' "$rc" > "$tmp"
        mv "$tmp" "$rc"
        info "removed dot env source line from $rc"
    done
}

unset_path_step() {
    uninject_shell_rc
    if [ -f "$ENV_FILE" ]; then
        rm -f "$ENV_FILE"
        info "removed $ENV_FILE"
    else
        info "$ENV_FILE already absent"
    fi
    printf 'This already-open shell still has the PATH/aliases until you exit it.\n'
}

unset_cmd() {
    targets=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--all|all) targets="claude codex kimi path" ;;
            path|claude|codex|kimi) targets="$targets $1" ;;
            help|-h|--help) unset_usage; return 0 ;;
            *) fail "unknown unset argument: $1" ;;
        esac
        shift
    done
    [ -n "$targets" ] || fail "unset requires -a|--all or a target name"

    ensure_agents_dir
    for t in $targets; do
        case "$t" in
            claude|codex|kimi) unset_one "$t" ;;
            path) unset_path_step ;;
        esac
    done
}

doctor_cmd() {
    problems=0
    [ -d "$AGENTS_DIR" ] || { warn "$AGENTS_DIR missing"; problems=$((problems + 1)); }
    [ -d "$DOT_DIR" ] || { warn "$DOT_DIR missing"; problems=$((problems + 1)); }
    if [ -f "$GITIGNORE_FILE" ] && grep -qxF '/.dotpanel/' "$GITIGNORE_FILE"; then
        info "$GITIGNORE_FILE ignores /.dotpanel/"
    else
        warn "$GITIGNORE_FILE does not ignore /.dotpanel/"
        problems=$((problems + 1))
    fi
    if [ -f "$ENTRY_FILE" ]; then
        info "entry exists: $ENTRY_FILE"
    else
        warn "entry missing: $ENTRY_FILE"
        problems=$((problems + 1))
    fi
    wrapper_expected="$DOT_DIR/var/doctor-wrapper.$$"
    wrapper_body > "$wrapper_expected"
    for target in "$HOME_DIR/.claude/CLAUDE.md" "$HOME_DIR/.codex/AGENTS.md" "$HOME_DIR/.kimi/AGENTS.md"; do
        if [ ! -f "$target" ]; then
            warn "wrapper missing: $target"
            problems=$((problems + 1))
        elif cmp -s "$wrapper_expected" "$target"; then
            info "wrapper current: $target"
        else
            warn "wrapper differs from generated content: $target"
            problems=$((problems + 1))
        fi
    done
    rm -f "$wrapper_expected"
    expected_plugins="$(mktemp -d "$DOT_DIR/var/doctor-plugins.XXXXXX")"
    actual_plugins="$CLAUDE_SKILLS"
    CLAUDE_SKILLS="$expected_plugins"
    if generate_claude_plugins >/dev/null 2>&1; then
        plugin_render_ok=1
    else
        plugin_render_ok=0
    fi
    CLAUDE_SKILLS="$actual_plugins"

    if [ "$plugin_render_ok" -eq 1 ]; then
        for plugin_name in hio matt impeccable; do
            expected_plugin="$expected_plugins/$plugin_name"
            actual_plugin="$actual_plugins/$plugin_name"
            if [ -d "$expected_plugin" ] && [ -d "$actual_plugin" ] && diff -qr "$expected_plugin" "$actual_plugin" >/dev/null 2>&1; then
                skill_count=$(find "$actual_plugin/skills" -name SKILL.md 2>/dev/null | wc -l)
                info "$plugin_name plugin current: $skill_count skill(s) at $actual_plugin"
            else
                warn "$plugin_name plugin differs from source render; run 'dot set claude'"
                problems=$((problems + 1))
            fi
        done
    else
        warn "could not render expected Claude plugins"
        problems=$((problems + 1))
    fi
    rm -rf "$expected_plugins"
    case ":$PATH:" in
        *":$DOT_BIN:"*) info "dotpanel bin is on PATH: $DOT_BIN" ;;
        *) warn "dotpanel bin is not on PATH in this shell: $DOT_BIN" ;;
    esac
    if command -v dot >/dev/null 2>&1; then
        info "dot command found: $(command -v dot)"
    else
        warn "dot command not found on PATH"
    fi
    if command -v dkey >/dev/null 2>&1; then
        info "dkey command found: $(command -v dkey)"
    else
        warn "dkey command not found on PATH"
    fi
    if [ -f "$ENV_FILE" ]; then
        info "env file exists: $ENV_FILE"
    else
        warn "env file missing: $ENV_FILE"
    fi
    if command -v age >/dev/null 2>&1; then
        info "age found"
    else
        warn "age missing; dkey encrypted grants will not work yet"
    fi
    if command -v jq >/dev/null 2>&1; then
        info "jq found"
    else
        warn "jq missing; dkey provider JSON features will not work"
        problems=$((problems + 1))
    fi
    if [ "$problems" -gt 0 ]; then
        return 2
    fi
}

sync_usage() {
    cat <<'EOF'
Usage:
  dot sync status
  dot sync diff
  dot sync pull
  dot sync push [GIT_PUSH_ARGS...]

Synchronizes ~/.agents as the user's memspace repo.
~/.agents/.dotpanel/ is ignored and not part of this repo.

pull prints status, fetches, requires a clean worktree, fast-forwards from the
configured upstream, then renders all harness outputs.
push requires a clean worktree and pushes existing commits only. It never
stages or commits files.
EOF
}

ensure_agents_git_repo() {
    need_git
    [ -d "$AGENTS_DIR" ] || fail "$AGENTS_DIR missing; run dot init first"
    is_git_repo "$AGENTS_DIR" || fail "$AGENTS_DIR is not a git repo; run 'git -C \"$AGENTS_DIR\" init' or clone your memspace repo there"
}

require_clean_git_worktree() {
    repo="$1"
    label="$2"
    action="$3"
    if [ -n "$(git -C "$repo" status --porcelain=v1 --untracked-files=all)" ]; then
        fail "$label has uncommitted changes; commit or stash them before $action"
    fi
}

sync_cmd() {
    sub="${1:-status}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        help|-h|--help)
            sync_usage
            ;;
        status)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" status --short --branch
            ;;
        diff)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" diff "$@"
            ;;
        pull)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" status --short --branch
            git -C "$AGENTS_DIR" fetch "$@"
            require_clean_git_worktree "$AGENTS_DIR" "memspace" "pulling"
            upstream="$(git -C "$AGENTS_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || \
                fail "memspace branch has no upstream; configure one before pulling"
            git -C "$AGENTS_DIR" merge --ff-only "$upstream"
            configure_cmd --harness all
            ;;
        push)
            ensure_agents_git_repo
            require_clean_git_worktree "$AGENTS_DIR" "memspace" "pushing"
            git -C "$AGENTS_DIR" push "$@"
            ;;
        *)
            fail "unknown sync command: $sub"
            ;;
    esac
}

self_usage() {
    cat <<'EOF'
Usage:
  dot self status
  dot self update

Manages the dot tool checkout at ~/.agents/.dotpanel.
update refuses a checkout with tracked, staged, or untracked changes.
EOF
}

self_cmd() {
    sub="${1:-status}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        help|-h|--help)
            self_usage
            ;;
        status)
            need_git
            is_git_repo "$DOT_DIR" || fail "$DOT_DIR is not a git repo; install with 'git clone <repo> \"$DOT_DIR\" && sh \"$DOT_DIR/bin/dot\" init'"
            git -C "$DOT_DIR" status --short --branch
            ;;
        update)
            need_git
            is_git_repo "$DOT_DIR" || fail "$DOT_DIR is not a git repo; install with 'git clone <repo> \"$DOT_DIR\" && sh \"$DOT_DIR/bin/dot\" init'"
            require_clean_git_worktree "$DOT_DIR" "dotpanel checkout" "updating"
            git -C "$DOT_DIR" pull --ff-only "$@"
            configure_cmd --harness all
            path_cmd
            ;;
        *)
            fail "unknown self command: $sub"
            ;;
    esac
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$cmd" in
    init) init_cmd "$@" ;;
    set) set_cmd "$@" ;;
    unset) unset_cmd "$@" ;;
    configure) configure_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    sync) sync_cmd "$@" ;;
    self) self_cmd "$@" ;;
    version|--version|-v) version ;;
    help|--help|-h) usage ;;
    *) fail "unknown command: $cmd" ;;
esac
