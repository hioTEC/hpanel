#!/bin/sh
# dot - minimal memspace sync/render helper.
#
# Philosophy:
#   ~/.agents/ is the user's memspace and source of truth.
#   ~/.agents/AGENTS.md is the entry.
#   ~/.agents/.dotpanel/ is managed local tooling and must be gitignored.

set -eu

VERSION="0.1.0-vnext"

HOME_DIR="${HOME:?HOME is required}"
AGENTS_DIR="${DOT_AGENTS_DIR:-$HOME_DIR/.agents}"
DOT_DIR="$AGENTS_DIR/.dotpanel"
SECRETS_DIR="$AGENTS_DIR/secrets"
ENTRY_FILE="$AGENTS_DIR/AGENTS.md"
GITIGNORE_FILE="$AGENTS_DIR/.gitignore"
DOT_BIN="$DOT_DIR/bin"
ENV_FILE="$DOT_DIR/env.sh"
TEMPLATE_ENTRY="$DOT_DIR/templates/AGENTS.md"
PROVIDERS_FILE="${DKEY_PROVIDERS_FILE:-$SECRETS_DIR/dkey.providers.json}"
KEYS_FILE="${DKEY_KEYS_FILE:-$SECRETS_DIR/keys.env.age}"
AGE_IDENTITY_FILE="${DKEY_AGE_IDENTITY_FILE:-$HOME_DIR/.config/age/key.txt}"

info() { printf 'OK  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

need_git() {
    command -v git >/dev/null 2>&1 || fail "git is required"
}

is_git_repo() {
    git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

usage() {
    cat <<'EOF'
dot - minimal memspace sync/render helper

Usage:
  dot init [--template|--blank|--from PATH|--no-entry] [--yes] [--no-path]
  dot set -a|--all
  dot set claude|codex|kimi
  dot configure [--harness all|claude|codex|kimi]
  dot use claude:BACKEND[:PROFILE]
  dot use codex:BACKEND[:PROFILE]
  dot use all:BACKEND[:PROFILE]
  dot doctor
  dot path
  dot sync status|diff|pull|push
  dot self status|update
  dot version
  dot help

Core invariant:
  ~/.agents/ is your memspace; ~/.agents/AGENTS.md is the entry.
  ~/.agents/.dotpanel/ is managed by dot and must be gitignored.
EOF
}

version() {
    printf 'dot %s\n' "$VERSION"
}

ensure_agents_dir() {
    mkdir -p "$AGENTS_DIR" "$DOT_DIR/var"
}

ensure_gitignore() {
    ensure_agents_dir
    touch "$GITIGNORE_FILE"
    if ! grep -qxF '/.dotpanel/' "$GITIGNORE_FILE"; then
        printf '\n/.dotpanel/\n' >> "$GITIGNORE_FILE"
        info "added /.dotpanel/ to $GITIGNORE_FILE"
    else
        info "$GITIGNORE_FILE already ignores /.dotpanel/"
    fi
}

path_source_line() {
    printf '[ -f "%s" ] && . "%s"\n' "$ENV_FILE" "$ENV_FILE"
}

write_env_file() {
    ensure_agents_dir
    tmp="$DOT_DIR/var/env.$$"
cat > "$tmp" <<EOF
# Generated by dot init; do not edit directly.
case ":\$PATH:" in
    *":$DOT_BIN:"*) ;;
    *) export PATH="$DOT_BIN:\$PATH" ;;
esac

dkey() {
    case "\${1:-}" in
        on)
            shift
            eval "\$(DKEY_EMIT_SHELL=1 command dkey on "\$@")"
            ;;
        off)
            shift
            eval "\$(command dkey off "\$@")"
            ;;
        *)
            command dkey "\$@"
            ;;
    esac
}

alias claw='claude --dangerously-skip-permissions'
alias codx='codex --dangerously-bypass-approvals-and-sandbox'
EOF
    if [ -f "$ENV_FILE" ] && cmp -s "$ENV_FILE" "$tmp"; then
        rm -f "$tmp"
        info "current $ENV_FILE"
    else
        mv "$tmp" "$ENV_FILE"
        info "wrote $ENV_FILE"
    fi
}

shell_rc_files() {
    if [ -n "${DOT_SHELL_RC:-}" ]; then
        printf '%s\n' "$DOT_SHELL_RC"
        return 0
    fi
    printf '%s\n' "$HOME_DIR/.bashrc"
    printf '%s\n' "$HOME_DIR/.bash_profile"
    printf '%s\n' "$HOME_DIR/.profile"
}

inject_shell_rc() {
    line="$(path_source_line)"
    shell_rc_files | while IFS= read -r rc; do
        [ -n "$rc" ] || continue
        mkdir -p "$(dirname "$rc")"
        touch "$rc"
        if grep -qxF "$line" "$rc"; then
            info "$rc already sources dot env"
            continue
        fi
        {
            printf '\n# dot: memspace tools PATH\n'
            printf '%s\n' "$line"
        } >> "$rc"
        info "added dot env source line to $rc"
    done
}

path_cmd() {
    write_env_file
    inject_shell_rc
    # This affects only this process and any commands still run by this script.
    # The caller's already-running shell must source ENV_FILE or open a new shell.
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    info "dotpanel bin is on PATH via $ENV_FILE: $DOT_BIN"
    if command -v dot >/dev/null 2>&1; then
        info "dot is available in this process: $(command -v dot)"
    else
        warn "dot is not on this shell's PATH yet"
    fi
    if command -v dkey >/dev/null 2>&1; then
        info "dkey is available in this process: $(command -v dkey)"
    else
        warn "dkey is not on this shell's PATH yet"
    fi
    printf 'For this already-open shell, run:\n  . "%s"\n' "$ENV_FILE"
}

first_nonempty_line() {
    # first_nonempty_line <file>
    awk 'NF { print; exit }' "$1" 2>/dev/null || true
}

find_entry_candidates() {
    # Print NUL-free tab-separated records: path<TAB>first line.
    # Scope: home root plus one level down.
    find "$HOME_DIR" -maxdepth 2 \( -name AGENTS.md -o -name CLAUDE.md \) \
        -type f 2>/dev/null | sort | while IFS= read -r file; do
            case "$file" in
                "$ENTRY_FILE"|"$DOT_DIR"/*) continue ;;
            esac
            line="$(first_nonempty_line "$file")"
            printf '%s\t%s\n' "$file" "$line"
        done
}

write_template_entry() {
    if [ -f "$TEMPLATE_ENTRY" ]; then
        cp "$TEMPLATE_ENTRY" "$ENTRY_FILE"
        return 0
    fi
    cat > "$ENTRY_FILE" <<'EOF'
# User Memspace

`~/.agents/` is the private memspace.
`~/.agents/AGENTS.md` is the entry.

Read this file first. Then read project-local `./.agents/AGENTS.md` when it
exists. Do not recursively scan `~/.agents/` or `./.agents/`; read only entry
files, files they explicitly reference, or files the user names.

## Voice

Describe operator voice, language preferences, and durable artifact language
here.

## Default Posture

- Follow the user's direct instructions first.
- Read before advising. When the real problem sits one layer lower than the
  question, name that lower layer.
- Default ambiguous requests to exploration and decision. Reserve file writes,
  commits, broad scripts, and agent spawning for explicit implementation verbs
  or clear task ownership.

## Read Families

Add routing here as the memspace grows. Start with the family, then lazy-load
only the named files.

Examples:

- skill or slash command -> `skills/README.md`, then the named skill
- service / deploy / secrets / external resource -> `rules/flow-resource-ops.md`
- repeated friction / protocol improvement -> `rules/flow-improve-protocol.md`

## Hard Edges

Follow the user's direct instructions first.

`~/.agents/.dotpanel/` is managed public tooling; do not edit it unless the
task is about dotpanel itself.

`dkey` is privileged. Subagents must refuse any `dkey` invocation or wrapper
known to use it. `dkey on` exports all encrypted keys into the current shell;
prefer grant-scoped forms for resource operations when practical.

Never output secret values in logs or responses.

## Memspace Tooling

`dot init` is bootstrap. Install scripts run it once; day-to-day use should not
need it.

Use `dot set -a` after editing `~/.agents/AGENTS.md` or after pulling memspace
changes. It renders the managed Claude, Codex, and Kimi entry files. Use
`dot set claude`, `dot set codex`, or `dot set kimi` for one harness.

Use `dot sync status`, `dot sync diff`, `dot sync pull`, and `dot sync push` to
move the memspace repo across machines. `dot sync pull` is fast-forward only
and re-renders entries afterward. `dot sync push` stages all non-ignored
memspace changes under `~/.agents`, commits when needed, and pushes.

Use `dkey keygen` once to create the local age identity. Use
`dkey set NAME VALUE` or `dkey set NAME=VALUE` to create or overwrite encrypted
keys, `dkey list` to list key names, `dkey on` to export all keys to the
current shell, and `dkey off` to remove variables set by `dkey on`.

## Layout

- `bin/` — user-owned command wrappers and ops verbs.
- `infra/` — machines, domains, services, desired state, network notes.
- `secrets/` — encrypted or template secret material; no plaintext real keys.
- `rules/` — behavior policy and scenario closure cards.
- `skills/` — optional user-authored skills; lazy load only when relevant.
- `journal/` — cross-session lessons; lazy load only when improving rules or doing retrospectives.
- `reference/` — optional long-form notes; lazy load only when relevant.
- `tools/` — helper libraries, templates, and docs used by `bin/`.
- `.dotpanel/` — managed checkout of the public `dot` / `dkey` tools; gitignored.
EOF
}

write_blank_entry() {
    cat > "$ENTRY_FILE" <<'EOF'
# User Memspace

`~/.agents/` is your memspace. `~/.agents/AGENTS.md` is the entry.
EOF
}

copy_entry_from() {
    src="$1"
    [ -f "$src" ] || fail "entry source not found: $src"
    cp "$src" "$ENTRY_FILE"
}

prompt_entry_seed() {
    [ -f "$ENTRY_FILE" ] && {
        info "$ENTRY_FILE already exists; leaving it unchanged"
        return 0
    }

    tmp="$DOT_DIR/var/init-candidates.tsv"
    find_entry_candidates > "$tmp"

    printf '\n%s\n' "Create $ENTRY_FILE?"
    printf '  1. Use dot template\n'

    count=1
    while IFS="$(printf '\t')" read -r path line; do
        count=$((count + 1))
        if [ -n "$line" ]; then
            printf '  %d. Use %s — %s\n' "$count" "$path" "$line"
        else
            printf '  %d. Use %s\n' "$count" "$path"
        fi
    done < "$tmp"

    blank_choice=$((count + 1))
    skip_choice=$((count + 2))
    printf '  %d. Blank AGENTS.md\n' "$blank_choice"
    printf '  %d. Skip\n' "$skip_choice"
    printf 'Select [%d]: ' "$skip_choice"

    read -r choice || choice="$skip_choice"
    [ -n "$choice" ] || choice="$skip_choice"

    if [ "$choice" = "1" ]; then
        write_template_entry
        info "created $ENTRY_FILE from template"
        return 0
    fi
    if [ "$choice" = "$blank_choice" ]; then
        write_blank_entry
        info "created blank $ENTRY_FILE"
        return 0
    fi
    if [ "$choice" = "$skip_choice" ]; then
        info "skipped entry creation"
        return 0
    fi
    if ! printf '%s' "$choice" | grep -Eq '^[0-9]+$'; then
        fail "invalid choice: $choice"
    fi
    if [ "$choice" -lt 2 ] || [ "$choice" -gt "$count" ]; then
        fail "invalid choice: $choice"
    fi

    idx=$((choice - 1))
    src="$(sed -n "${idx}p" "$tmp" | awk -F '\t' '{print $1}')"
    copy_entry_from "$src"
    info "created $ENTRY_FILE from $src"
}

init_cmd() {
    mode="prompt"
    src=""
    install_path=true

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --template) mode="template" ;;
            --blank) mode="blank" ;;
            --no-entry) mode="none" ;;
            --from)
                shift
                [ "$#" -gt 0 ] || fail "--from requires a path"
                mode="from"
                src="$1"
                ;;
            --yes|-y)
                # Non-interactive default: do not create user entry rules.
                [ "$mode" = "prompt" ] && mode="none"
                ;;
            --no-path)
                install_path=false
                ;;
            -h|--help) usage; return 0 ;;
            *) fail "unknown init argument: $1" ;;
        esac
        shift
    done

    ensure_agents_dir
    ensure_gitignore

    case "$mode" in
        template)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                write_template_entry
                info "created $ENTRY_FILE from template"
            fi
            ;;
        blank)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                write_blank_entry
                info "created blank $ENTRY_FILE"
            fi
            ;;
        from)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                copy_entry_from "$src"
                info "created $ENTRY_FILE from $src"
            fi
            ;;
        none)
            info "entry creation skipped"
            ;;
        prompt)
            prompt_entry_seed
            ;;
        *) fail "internal error: bad init mode $mode" ;;
    esac

    configure_cmd --harness all
    if $install_path; then
        path_cmd
    fi
}

wrapper_body() {
    cat <<EOF
<!-- Generated by dot configure; do not edit directly. -->
\`~/.agents/\` is your memspace. \`~/.agents/AGENTS.md\` is the entry.

Before doing any work, read \`~/.agents/AGENTS.md\` if it exists.
Then read \`./.agents/AGENTS.md\` if it exists in the current repository.

Do not recursively scan \`~/.agents/\` or \`./.agents/\`. Read only the entry files above, files they explicitly reference, or files the user explicitly asks for.
EOF
}

write_file_if_changed() {
    target="$1"
    tmp="$2"
    mkdir -p "$(dirname "$target")"
    if [ -f "$target" ] && cmp -s "$target" "$tmp"; then
        rm -f "$tmp"
        info "current $target"
        return 0
    fi
    mv "$tmp" "$target"
    info "wrote $target"
}

configure_one() {
    harness="$1"
    case "$harness" in
        claude) target="$HOME_DIR/.claude/CLAUDE.md" ;;
        codex) target="$HOME_DIR/.codex/AGENTS.md" ;;
        kimi) target="$HOME_DIR/.kimi/AGENTS.md" ;;
        *) fail "unknown harness: $harness" ;;
    esac
    tmp="$DOT_DIR/var/wrapper.$harness.$$"
    wrapper_body > "$tmp"
    write_file_if_changed "$target" "$tmp"
}

configure_cmd() {
    harness="all"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --harness)
                shift
                [ "$#" -gt 0 ] || fail "--harness requires a value"
                harness="$1"
                ;;
            -h|--help) usage; return 0 ;;
            *) fail "unknown configure argument: $1" ;;
        esac
        shift
    done

    ensure_agents_dir
    case "$harness" in
        all)
            configure_one claude
            configure_one codex
            configure_one kimi
            ;;
        claude|codex|kimi)
            configure_one "$harness"
            ;;
        *) fail "unknown harness: $harness" ;;
    esac
}

set_usage() {
    cat <<'EOF'
Usage:
  dot set -a|--all
  dot set claude|codex|kimi

Renders the managed harness entry files from ~/.agents/AGENTS.md.
This is the short human-facing alias for `dot configure --harness ...`.
EOF
}

set_cmd() {
    harness=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--all) harness="all" ;;
            --harness)
                shift
                [ "$#" -gt 0 ] || fail "--harness requires a value"
                harness="$1"
                ;;
            all|claude|codex|kimi) harness="$1" ;;
            help|-h|--help) set_usage; return 0 ;;
            *) fail "unknown set argument: $1" ;;
        esac
        shift
    done
    [ -n "$harness" ] || fail "set requires -a|--all or a harness name"
    configure_cmd --harness "$harness"
}

need_jq() {
    command -v jq >/dev/null 2>&1 || fail "jq is required"
}

need_age() {
    command -v age >/dev/null 2>&1 || fail "age is required"
}

expand_home_path() {
    path="$1"
    case "$path" in
        "~") printf '%s\n' "$HOME_DIR" ;;
        "~/"*) printf '%s/%s\n' "$HOME_DIR" "$(printf '%s' "$path" | sed 's|^~/||')" ;;
        *) printf '%s\n' "$path" ;;
    esac
}

decrypt_keys() {
    need_age
    [ -f "$KEYS_FILE" ] || fail "keys file missing: $KEYS_FILE"
    [ -f "$AGE_IDENTITY_FILE" ] || fail "age identity missing: $AGE_IDENTITY_FILE"
    age -d -i "$AGE_IDENTITY_FILE" "$KEYS_FILE"
}

secret_value() {
    name="$1"
    decrypt_keys | awk -F= -v key="$name" '
        $0 ~ /^[[:space:]]*#/ { next }
        $1 == key {
            sub(/^[^=]*=/, "")
            print
            found=1
            exit
        }
        END { if (!found) exit 1 }
    '
}

toml_quote() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'
}

use_usage() {
    cat <<'EOF'
Usage:
  dot use claude:BACKEND[:PROFILE]
  dot use codex:BACKEND[:PROFILE]
  dot use all:BACKEND[:PROFILE]

Examples:
  dot use claude:deepseek
  dot use codex:qwen
  dot use codex:qwen:payg-global

Writes backend settings from ~/.agents/secrets/dkey.providers.json.
Claude Code writes ~/.claude/settings.json.
Codex writes ~/.codex/config.toml and ~/.codex/auth.json.
EOF
}

profile_has_harness() {
    provider="$1"
    profile="$2"
    harness="$3"
    jq -e --arg provider "$provider" --arg profile "$profile" --arg harness "$harness" \
        '.providers[$provider].profiles[$profile][$harness] != null' "$PROVIDERS_FILE" >/dev/null
}

write_claude_use() {
    provider="$1"
    profile="$2"
    need_jq

    settings_path="$(expand_home_path "$(jq -r '.defaults.claude.settings_path // "~/.claude/settings.json"' "$PROVIDERS_FILE")")"
    home_path="$(expand_home_path "$(jq -r '.defaults.claude.home_path // "~/.claude.json"' "$PROVIDERS_FILE")")"
    mkdir -p "$(dirname "$settings_path")" "$(dirname "$home_path")" "$DOT_DIR/var"

    tmp="$DOT_DIR/var/claude-settings.$$"
    tmp2="$DOT_DIR/var/claude-settings2.$$"
    if [ -f "$settings_path" ]; then
        cp "$settings_path" "$tmp"
    else
        printf '{}\n' > "$tmp"
    fi

    managed="$(jq -c '.defaults.claude.managed_env_keys // []' "$PROVIDERS_FILE")"
    jq --argjson keys "$managed" '
        .env = (.env // {})
        | .env |= with_entries(select((.key | $keys | index(.)) | not))
    ' "$tmp" > "$tmp2"
    mv "$tmp2" "$tmp"

    entries="$DOT_DIR/var/claude-env.$$"
    jq -r --arg provider "$provider" --arg profile "$profile" '
        ((.defaults.claude.settings.env // {}) + (.providers[$provider].profiles[$profile].claude.settings.env // {}))
        | to_entries[]
        | if ((.value | type) == "object" and (.value.secret != null))
          then [.key, "secret", .value.secret]
          else [.key, "literal", (.value | tostring)]
          end
        | @tsv
    ' "$PROVIDERS_FILE" > "$entries"

    while IFS="$(printf '\t')" read -r key kind value; do
        [ -n "$key" ] || continue
        if [ "$kind" = "secret" ]; then
            resolved="$(secret_value "$value")" || fail "secret not found: $value"
        else
            resolved="$value"
        fi
        jq --arg key "$key" --arg value "$resolved" '.env[$key] = $value' "$tmp" > "$tmp2"
        mv "$tmp2" "$tmp"
    done < "$entries"
    rm -f "$entries"

    write_file_if_changed "$settings_path" "$tmp"

    home_obj="$(jq -c --arg provider "$provider" --arg profile "$profile" '
        (.defaults.claude.home // {}) * (.providers[$provider].profiles[$profile].claude.home // {})
    ' "$PROVIDERS_FILE")"
    if [ "$home_obj" != "{}" ]; then
        tmp="$DOT_DIR/var/claude-home.$$"
        tmp2="$DOT_DIR/var/claude-home2.$$"
        if [ -f "$home_path" ]; then
            cp "$home_path" "$tmp"
        else
            printf '{}\n' > "$tmp"
        fi
        jq --argjson home "$home_obj" '. * $home' "$tmp" > "$tmp2"
        mv "$tmp2" "$tmp"
        write_file_if_changed "$home_path" "$tmp"
    fi
    info "Claude Code backend: $provider:$profile"
}

write_codex_config_file() {
    provider="$1"
    profile="$2"
    config_path="$3"
    provider_id="$4"
    model="$5"
    mkdir -p "$(dirname "$config_path")" "$DOT_DIR/var"

    case "$provider_id" in
        *[!A-Za-z0-9_-]*|"") fail "invalid Codex provider id: $provider_id" ;;
    esac

    source_file="$config_path"
    if [ ! -f "$source_file" ]; then
        source_file="$DOT_DIR/var/codex-empty.$$"
        : > "$source_file"
    fi

    tmp="$DOT_DIR/var/codex-config.$$"
    rest="$DOT_DIR/var/codex-config-rest.$$"
    awk -v provider="$provider_id" '
        BEGIN { top = 1; skip = 0 }
        /^\[/ {
            top = 0
            if ($0 == "[model_providers." provider "]") {
                skip = 1
                next
            }
            skip = 0
        }
        skip { next }
        top && $0 ~ /^(model_provider|model|review_model)[[:space:]]*=/ { next }
        { print }
    ' "$source_file" > "$rest"

    {
        printf 'model_provider = %s\n' "$(toml_quote "$provider_id")"
        printf 'model = %s\n' "$(toml_quote "$model")"
        printf 'review_model = %s\n' "$(toml_quote "$model")"
        cat "$rest"
        printf '\n[model_providers.%s]\n' "$provider_id"
    } > "$tmp"

    entries="$DOT_DIR/var/codex-provider.$$"
    jq -r --arg provider "$provider" --arg profile "$profile" '
        .providers[$provider].profiles[$profile].codex.model_provider_config
        | to_entries[]
        | [.key, (.value | type), (.value | tostring)]
        | @tsv
    ' "$PROVIDERS_FILE" > "$entries"
    while IFS="$(printf '\t')" read -r key kind value; do
        [ -n "$key" ] || continue
        case "$kind" in
            string) printf '%s = %s\n' "$key" "$(toml_quote "$value")" >> "$tmp" ;;
            boolean|number) printf '%s = %s\n' "$key" "$value" >> "$tmp" ;;
            *) fail "unsupported Codex provider config value for $key: $kind" ;;
        esac
    done < "$entries"
    rm -f "$entries" "$rest"
    [ "$source_file" = "$config_path" ] || rm -f "$source_file"

    write_file_if_changed "$config_path" "$tmp"
}

write_codex_auth_file() {
    secret_name="$1"
    auth_path="$HOME_DIR/.codex/auth.json"
    mkdir -p "$(dirname "$auth_path")" "$DOT_DIR/var"
    secret="$(secret_value "$secret_name")" || fail "secret not found: $secret_name"

    tmp="$DOT_DIR/var/codex-auth.$$"
    tmp2="$DOT_DIR/var/codex-auth2.$$"
    if [ -f "$auth_path" ]; then
        cp "$auth_path" "$tmp"
    else
        printf '{}\n' > "$tmp"
    fi
    jq --arg key "$secret" '.auth_mode = "apikey" | .OPENAI_API_KEY = $key' "$tmp" > "$tmp2"
    mv "$tmp2" "$tmp"
    write_file_if_changed "$auth_path" "$tmp"
}

write_codex_use() {
    provider="$1"
    profile="$2"
    strict="$3"
    need_jq

    if ! profile_has_harness "$provider" "$profile" codex; then
        if [ "$strict" = "yes" ]; then
            fail "backend profile has no Codex config: $provider:$profile"
        fi
        return 3
    fi

    status="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.status // empty' "$PROVIDERS_FILE")"
    status_message="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.status_message // empty' "$PROVIDERS_FILE")"
    if [ -n "$status" ] && [ "$status" != "supported" ]; then
        message="${status_message:-Codex profile is marked $status}"
        if [ "$strict" = "yes" ]; then
            fail "$message"
        fi
        warn "Codex backend not applied for $provider:$profile: $message"
        return 3
    fi

    wire_api="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.model_provider_config.wire_api // empty' "$PROVIDERS_FILE")"
    if [ "$wire_api" != "responses" ]; then
        message="Codex 0.130 requires a Responses API backend; $provider:$profile declares wire_api=$wire_api and has no successful Responses smoke test."
        if [ "$strict" = "yes" ]; then
            fail "$message"
        fi
        warn "Codex backend not applied for $provider:$profile: $message"
        return 3
    fi

    config_path="$(expand_home_path "$(jq -r '.defaults.codex.config_path // "~/.codex/config.toml"' "$PROVIDERS_FILE")")"
    provider_id="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.model_provider' "$PROVIDERS_FILE")"
    model="$(jq -r --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile].codex.model' "$PROVIDERS_FILE")"
    secret_name="$(jq -r --arg provider "$provider" --arg profile "$profile" '
        (.providers[$provider].profiles[$profile].env // {} | to_entries[0].value.secret)
        // .providers[$provider].secret
        // empty
    ' "$PROVIDERS_FILE")"
    [ -n "$secret_name" ] || fail "Codex backend profile has no secret mapping: $provider:$profile"

    write_codex_config_file "$provider" "$profile" "$config_path" "$provider_id" "$model"
    write_codex_auth_file "$secret_name"
    info "Codex backend: $provider:$profile"
}

use_cmd() {
    need_jq
    [ -f "$PROVIDERS_FILE" ] || fail "providers registry missing: $PROVIDERS_FILE"

    target=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            help|-h|--help)
                use_usage
                return 0
                ;;
            --harness)
                fail "dot use now uses HARNESS:BACKEND syntax; try: dot use claude:deepseek"
                ;;
            -*)
                fail "unknown use argument: $1"
                ;;
            *)
                [ -z "$target" ] || fail "dot use accepts only one target"
                target="$1"
                ;;
        esac
        shift
    done

    [ -n "$target" ] || fail "use requires HARNESS:BACKEND[:PROFILE]"
    harness="${target%%:*}"
    if [ "$target" = "$harness" ]; then
        fail "dot use target must be HARNESS:BACKEND[:PROFILE]; try: dot use claude:deepseek"
    fi
    backend_spec="${target#*:}"
    case "$harness" in
        all|claude|codex) ;;
        *) fail "unknown harness in dot use target: $harness" ;;
    esac

    provider="${backend_spec%%:*}"
    if [ "$backend_spec" != "$provider" ]; then
        profile="${backend_spec#*:}"
        case "$profile" in
            *:*) fail "dot use supports at most HARNESS:BACKEND:PROFILE" ;;
        esac
    else
        profile="$(jq -r --arg provider "$provider" '.providers[$provider].default_profile // empty' "$PROVIDERS_FILE")"
    fi
    [ -n "$provider" ] || fail "backend is empty"
    [ -n "$profile" ] || fail "profile is empty for backend: $provider"

    jq -e --arg provider "$provider" '.providers[$provider] != null' "$PROVIDERS_FILE" >/dev/null || fail "unknown backend: $provider"
    jq -e --arg provider "$provider" --arg profile "$profile" '.providers[$provider].profiles[$profile] != null' "$PROVIDERS_FILE" >/dev/null || fail "unknown backend profile: $provider:$profile"

    applied="no"
    case "$harness" in
        all)
            if profile_has_harness "$provider" "$profile" claude; then
                write_claude_use "$provider" "$profile"
                applied="yes"
            fi
            if write_codex_use "$provider" "$profile" no; then
                applied="yes"
            else
                code="$?"
                [ "$code" = "3" ] || return "$code"
            fi
            ;;
        claude)
            profile_has_harness "$provider" "$profile" claude || fail "backend profile has no Claude Code config: $provider:$profile"
            write_claude_use "$provider" "$profile"
            applied="yes"
            ;;
        codex)
            write_codex_use "$provider" "$profile" yes
            applied="yes"
            ;;
        *)
            fail "unknown harness: $harness"
            ;;
    esac

    [ "$applied" = "yes" ] || fail "no applicable harness config for backend profile $provider:$profile"
}

doctor_cmd() {
    problems=0
    [ -d "$AGENTS_DIR" ] || { warn "$AGENTS_DIR missing"; problems=$((problems + 1)); }
    [ -d "$DOT_DIR" ] || { warn "$DOT_DIR missing"; problems=$((problems + 1)); }
    if [ -f "$GITIGNORE_FILE" ] && grep -qxF '/.dotpanel/' "$GITIGNORE_FILE"; then
        info "$GITIGNORE_FILE ignores /.dotpanel/"
    else
        warn "$GITIGNORE_FILE does not ignore /.dotpanel/"
        problems=$((problems + 1))
    fi
    if [ -f "$ENTRY_FILE" ]; then
        info "entry exists: $ENTRY_FILE"
    else
        warn "entry missing: $ENTRY_FILE"
    fi
    for target in "$HOME_DIR/.claude/CLAUDE.md" "$HOME_DIR/.codex/AGENTS.md" "$HOME_DIR/.kimi/AGENTS.md"; do
        if [ -f "$target" ] && grep -q 'Generated by dot configure' "$target"; then
            info "wrapper managed: $target"
        else
            warn "wrapper missing or unmanaged: $target"
        fi
    done
    case ":$PATH:" in
        *":$DOT_BIN:"*) info "dotpanel bin is on PATH: $DOT_BIN" ;;
        *) warn "dotpanel bin is not on PATH in this shell: $DOT_BIN" ;;
    esac
    if command -v dot >/dev/null 2>&1; then
        info "dot command found: $(command -v dot)"
    else
        warn "dot command not found on PATH"
    fi
    if command -v dkey >/dev/null 2>&1; then
        info "dkey command found: $(command -v dkey)"
    else
        warn "dkey command not found on PATH"
    fi
    if [ -f "$ENV_FILE" ]; then
        info "env file exists: $ENV_FILE"
    else
        warn "env file missing: $ENV_FILE"
    fi
    if command -v age >/dev/null 2>&1; then
        info "age found"
    else
        warn "age missing; dkey encrypted grants will not work yet"
    fi
    if command -v jq >/dev/null 2>&1; then
        info "jq found"
    else
        warn "jq missing; dkey provider JSON features will not work"
        problems=$((problems + 1))
    fi
    if [ "$problems" -gt 0 ]; then
        return 2
    fi
}

sync_usage() {
    cat <<'EOF'
Usage:
  dot sync status
  dot sync diff
  dot sync pull
  dot sync push [MESSAGE]

Synchronizes ~/.agents as the user's memspace repo.
~/.agents/.dotpanel/ is ignored and not part of this repo.
EOF
}

ensure_agents_git_repo() {
    need_git
    [ -d "$AGENTS_DIR" ] || fail "$AGENTS_DIR missing; run dot init first"
    is_git_repo "$AGENTS_DIR" || fail "$AGENTS_DIR is not a git repo; run 'git -C \"$AGENTS_DIR\" init' or clone your memspace repo there"
}

sync_cmd() {
    sub="${1:-status}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        help|-h|--help)
            sync_usage
            ;;
        status)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" status --short --branch
            ;;
        diff)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" diff "$@"
            ;;
        pull)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" pull --ff-only "$@"
            configure_cmd --harness all
            ;;
        push)
            ensure_agents_git_repo
            if ! git -C "$AGENTS_DIR" diff --quiet || ! git -C "$AGENTS_DIR" diff --cached --quiet; then
                msg="${1:-sync memspace}"
                git -C "$AGENTS_DIR" add -A
                git -C "$AGENTS_DIR" commit -m "$msg"
            else
                info "no memspace changes to commit"
            fi
            git -C "$AGENTS_DIR" push
            ;;
        *)
            fail "unknown sync command: $sub"
            ;;
    esac
}

self_usage() {
    cat <<'EOF'
Usage:
  dot self status
  dot self update

Manages the dot tool checkout at ~/.agents/.dotpanel.
EOF
}

self_cmd() {
    sub="${1:-status}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        help|-h|--help)
            self_usage
            ;;
        status)
            need_git
            is_git_repo "$DOT_DIR" || fail "$DOT_DIR is not a git repo; install with 'git clone <repo> \"$DOT_DIR\" && sh \"$DOT_DIR/bin/dot\" init'"
            git -C "$DOT_DIR" status --short --branch
            ;;
        update)
            need_git
            is_git_repo "$DOT_DIR" || fail "$DOT_DIR is not a git repo; install with 'git clone <repo> \"$DOT_DIR\" && sh \"$DOT_DIR/bin/dot\" init'"
            git -C "$DOT_DIR" pull --ff-only "$@"
            configure_cmd --harness all
            path_cmd
            ;;
        *)
            fail "unknown self command: $sub"
            ;;
    esac
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$cmd" in
    init) init_cmd "$@" ;;
    set) set_cmd "$@" ;;
    configure) configure_cmd "$@" ;;
    use) use_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    path) path_cmd "$@" ;;
    sync) sync_cmd "$@" ;;
    self) self_cmd "$@" ;;
    version|--version|-v) version ;;
    help|--help|-h) usage ;;
    *) fail "unknown command: $cmd" ;;
esac
