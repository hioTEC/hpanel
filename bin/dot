#!/bin/sh
# dot - minimal memspace sync/render helper.
#
# Philosophy:
#   ~/.agents/ is the user's memspace and source of truth.
#   ~/.agents/AGENTS.md is the entry.
#   ~/.agents/.dotpanel/ is managed local tooling and must be gitignored.

set -eu

VERSION="0.1.0"

HOME_DIR="${HOME:?HOME is required}"
AGENTS_DIR="${DOT_AGENTS_DIR:-$HOME_DIR/.agents}"
DOT_DIR="$AGENTS_DIR/.dotpanel"
ENTRY_FILE="$AGENTS_DIR/AGENTS.md"
GITIGNORE_FILE="$AGENTS_DIR/.gitignore"
CLAUDE_SKILLS="$HOME_DIR/.claude/skills"
CODEX_SKILLS="$HOME_DIR/.codex/skills"
CLAUDE_PLUGIN_OWNER_FILE='.dotpanel-owner'
CLAUDE_PLUGIN_OWNER='Generated by dotpanel; safe to reconcile.'
DOT_BIN="$DOT_DIR/bin"
TOOLS_BIN="$AGENTS_DIR/tools/bin"
ENV_FILE="$DOT_DIR/env.sh"
TEMPLATE_ENTRY="$DOT_DIR/templates/AGENTS.md"
SKILL_SOURCES_MANIFEST="$AGENTS_DIR/skills/sources.json"
CODEX_ALIAS_BANNER='<!-- Generated by dot configure from ~/.agents/skills/sources.json; do not edit directly. -->'
SHELL_RC_TMP=""
SHELL_RC_BODY_TMP=""
ENV_TMP=""
WRAPPER_TMP=""
MATT_SKILL_LIST_TMP=""
DOCTOR_WRAPPER_TMP=""
DOCTOR_ENV_TMP=""
DOCTOR_PLUGINS_TMP=""
DOCTOR_CODEX_ALIASES_TMP=""

info() { printf 'OK  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

need_git() {
    command -v git >/dev/null 2>&1 || fail "git is required"
}

is_git_repo() {
    git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

usage() {
    cat <<'EOF'
dot - minimal memspace sync/render helper

Usage:
  dot init [--template|--blank|--from PATH|--no-entry] [--yes] [--no-path]
  dot set -a|--all
  dot set TARGET [TARGET...]
  dot unset -a|--all
  dot unset TARGET [TARGET...]
  dot configure [--harness all|claude|codex|kimi]
  dot doctor
  dot sync status|diff|pull|push
  dot self status|update
  dot version
  dot help

TARGET = path | claude | codex | kimi
  path is the shell integration (env.sh + rc source line).
  -a|--all expands to: path claude codex kimi.

Core invariant:
  ~/.agents/ is your memspace; ~/.agents/AGENTS.md is the entry.
  ~/.agents/.dotpanel/ is managed by dot and must be gitignored.
EOF
}

version() {
    printf 'dot %s\n' "$VERSION"
}

ensure_agents_dir() {
    mkdir -p "$AGENTS_DIR" "$DOT_DIR/var"
}

ensure_gitignore() {
    ensure_agents_dir
    touch "$GITIGNORE_FILE"
    if ! grep -qxF '/.dotpanel/' "$GITIGNORE_FILE"; then
        printf '\n/.dotpanel/\n' >> "$GITIGNORE_FILE"
        info "added /.dotpanel/ to $GITIGNORE_FILE"
    else
        info "$GITIGNORE_FILE already ignores /.dotpanel/"
    fi
}

path_source_line() {
    printf '[ -f "%s" ] && . "%s"\n' "$ENV_FILE" "$ENV_FILE"
}

ensure_safe_generated_file() {
    generated_target="$1"
    generated_label="$2"
    ensure_safe_home_path "$generated_target" "$generated_label" || return 1
    [ ! -L "$generated_target" ] || {
        warn "$generated_label must not be symlinked: $generated_target"
        return 1
    }
    if [ -e "$generated_target" ] && [ ! -f "$generated_target" ]; then
        warn "$generated_label is not a regular file: $generated_target"
        return 1
    fi
}

ensure_safe_home_path() {
    home_path_target="$1"
    home_path_label="$2"
    case "$home_path_target" in
        "$HOME_DIR"/*) ;;
        *) warn "$home_path_label must stay below HOME: $home_path_target"; return 1 ;;
    esac
    case "$home_path_target" in
        */./*|*/.|*/../*|*/..)
            warn "$home_path_label must be lexically normalized: $home_path_target"
            return 1
            ;;
    esac
    [ ! -L "$HOME_DIR" ] || {
        warn "$home_path_label HOME boundary must not be symlinked: $HOME_DIR"
        return 1
    }
    home_path_cursor="$home_path_target"
    while [ "$home_path_cursor" != "$HOME_DIR" ]; do
        [ ! -L "$home_path_cursor" ] || {
            warn "$home_path_label path contains a symlink: $home_path_cursor"
            return 1
        }
        home_path_parent="$(dirname "$home_path_cursor")" || return 1
        case "$home_path_parent" in
            "$HOME_DIR"|"$HOME_DIR"/*) ;;
            *) warn "$home_path_label path escaped HOME: $home_path_target"; return 1 ;;
        esac
        home_path_cursor="$home_path_parent"
    done
}

env_body() {
cat <<EOF
# Generated by dot init; do not edit directly.
case ":\$PATH:" in
    *":$DOT_BIN:"*) ;;
    *) export PATH="$DOT_BIN:\$PATH" ;;
esac
case ":\$PATH:" in
    *":$TOOLS_BIN:"*) ;;
    *) export PATH="$TOOLS_BIN:\$PATH" ;;
esac

dkey() {
    case "\${1:-}" in
        on)
            shift
            if [ "\${_DOTPANEL_DKEY_EXPORTS+x}" = x ] || [ "\${_DOTPANEL_DKEY_OFF_STATUS+x}" = x ]; then
                printf '%s\n' 'FAIL  reserved dotpanel shell variable is already set' >&2
                return 1
            fi
            if [ -n "\${DKEY_ACTIVE_GRANT:-}" ] || [ -n "\${DKEY_MANAGED_VARS:-}" ]; then
                printf '%s\n' 'FAIL  dkey is already active; run dkey off before activating another grant' >&2
                return 1
            fi
            _DOTPANEL_DKEY_EXPORTS="\$(DKEY_EMIT_SHELL=1 command dkey on "\$@")" || {
                _DOTPANEL_DKEY_EXPORTS=
                unset _DOTPANEL_DKEY_EXPORTS
                return 1
            }
            ( eval "\$_DOTPANEL_DKEY_EXPORTS" ) || {
                _DOTPANEL_DKEY_EXPORTS=
                unset _DOTPANEL_DKEY_EXPORTS _DOTPANEL_DKEY_OFF_STATUS
                return 1
            }
            if eval "\$_DOTPANEL_DKEY_EXPORTS"; then
                _DOTPANEL_DKEY_EXPORTS=
                unset _DOTPANEL_DKEY_EXPORTS _DOTPANEL_DKEY_OFF_STATUS
                return 0
            fi
            _DOTPANEL_DKEY_EXPORTS=
            unset _DOTPANEL_DKEY_EXPORTS _DOTPANEL_DKEY_OFF_STATUS
            return 1
            ;;
        off)
            shift
            if [ "\${_DOTPANEL_DKEY_EXPORTS+x}" = x ] || [ "\${_DOTPANEL_DKEY_OFF_STATUS+x}" = x ]; then
                printf '%s\n' 'FAIL  reserved dotpanel shell variable is already set' >&2
                return 1
            fi
            _DOTPANEL_DKEY_EXPORTS="\$(command dkey off "\$@")" || {
                _DOTPANEL_DKEY_EXPORTS=
                unset _DOTPANEL_DKEY_EXPORTS
                return 1
            }
            ( eval "\$_DOTPANEL_DKEY_EXPORTS" ) || {
                _DOTPANEL_DKEY_EXPORTS=
                unset _DOTPANEL_DKEY_EXPORTS _DOTPANEL_DKEY_OFF_STATUS
                return 1
            }
            if eval "\$_DOTPANEL_DKEY_EXPORTS"; then
                _DOTPANEL_DKEY_EXPORTS=
                unset _DOTPANEL_DKEY_EXPORTS _DOTPANEL_DKEY_OFF_STATUS
                return 0
            fi
            _DOTPANEL_DKEY_EXPORTS=
            unset _DOTPANEL_DKEY_EXPORTS _DOTPANEL_DKEY_OFF_STATUS
            return 1
            ;;
        *)
            command dkey "\$@"
            ;;
    esac
}

# claw/clawb (claude) and codx/codxb (codex) live in ~/.agents/tools/bin/
# (added to PATH above) — per-invocation backend switch via dkey.providers.json.
# No aliases emitted here.
EOF
}

write_env_file() {
    ensure_agents_dir
    ensure_safe_generated_file "$ENV_FILE" "env file" || return 1
    ENV_TMP="$(mktemp "$DOT_DIR/var/env.XXXXXX")" || return 1
    if ! env_body > "$ENV_TMP"; then
        rm -f "$ENV_TMP" || true
        ENV_TMP=""
        return 1
    fi
    if [ -f "$ENV_FILE" ] && cmp -s "$ENV_FILE" "$ENV_TMP"; then
        rm -f "$ENV_TMP" || return 1
        ENV_TMP=""
        info "current $ENV_FILE"
    else
        if ! mv "$ENV_TMP" "$ENV_FILE"; then
            rm -f "$ENV_TMP" || true
            ENV_TMP=""
            return 1
        fi
        ENV_TMP=""
        info "wrote $ENV_FILE"
    fi
}

shell_rc_files() {
    if [ -n "${DOT_SHELL_RC:-}" ]; then
        printf '%s\n' "$DOT_SHELL_RC"
        return 0
    fi
    case "$(basename -- "${SHELL:-}")" in
        zsh)
            printf '%s\n' "${ZDOTDIR:-$HOME_DIR}/.zshrc"
            ;;
        *)
            printf '%s\n' "$HOME_DIR/.bashrc"
            printf '%s\n' "$HOME_DIR/.bash_profile"
            printf '%s\n' "$HOME_DIR/.profile"
            ;;
    esac
}

ensure_safe_shell_rc_path() {
    shell_rc_target="$1"
    [ -n "$shell_rc_target" ] || {
        warn "shell rc path must not be empty"
        return 1
    }
    case "$shell_rc_target" in
        */./*|*/.|*/../*|*/..)
            warn "shell rc path must be lexically normalized: $shell_rc_target"
            return 1
            ;;
    esac
    [ ! -L "$shell_rc_target" ] || {
        warn "shell rc must not be symlinked: $shell_rc_target"
        return 1
    }
    if [ -e "$shell_rc_target" ] && [ ! -f "$shell_rc_target" ]; then
        warn "shell rc is not a regular file: $shell_rc_target"
        return 1
    fi
    case "$shell_rc_target" in
        "$HOME_DIR"/*)
            ensure_safe_home_path "$shell_rc_target" "shell rc" || return 1
            ;;
        *)
            # DOT_SHELL_RC and ZDOTDIR may intentionally live outside HOME.
            # Validate their immediate mutation boundary without rejecting
            # legitimate system aliases such as macOS /var -> /private/var.
            shell_rc_cursor="$(dirname "$shell_rc_target")" || return 1
            [ ! -L "$shell_rc_cursor" ] || {
                warn "shell rc path contains a symlink: $shell_rc_cursor"
                return 1
            }
            ;;
    esac
}

preflight_shell_rc_files() {
    shell_rc_values="$(shell_rc_files)" || return 1
    while IFS= read -r shell_rc_candidate; do
        [ -n "$shell_rc_candidate" ] || continue
        ensure_safe_shell_rc_path "$shell_rc_candidate" || return 1
    done <<EOF
$shell_rc_values
EOF
}

cleanup_shell_rc_temps() {
    for shell_rc_temp_path in "${SHELL_RC_TMP:-}" "${SHELL_RC_BODY_TMP:-}"; do
        [ -z "$shell_rc_temp_path" ] || rm -f "$shell_rc_temp_path" || true
    done
    SHELL_RC_TMP=""
    SHELL_RC_BODY_TMP=""
}

inject_shell_rc() {
    line="$(path_source_line)"
    shell_rc_values="$(shell_rc_files)" || return 1
    while IFS= read -r rc; do
        [ -n "$rc" ] || continue
        ensure_safe_shell_rc_path "$rc" || return 1
        rc_dir="$(dirname "$rc")" || return 1
        mkdir -p "$rc_dir" || return 1
        ensure_safe_shell_rc_path "$rc" || return 1
        if [ -f "$rc" ] && grep -qxF "$line" "$rc"; then
            info "$rc already sources dot env"
            continue
        fi
        SHELL_RC_TMP="$(mktemp "$rc_dir/.dotpanel-rc.XXXXXX")" || return 1
        if [ -f "$rc" ]; then
            cp -p "$rc" "$SHELL_RC_TMP" || return 1
            shell_rc_was_present=1
        else
            shell_rc_was_present=0
        fi
        {
            printf '\n# dot: memspace tools PATH\n'
            printf '%s\n' "$line"
        } >> "$SHELL_RC_TMP" || return 1
        ensure_safe_shell_rc_path "$rc" || return 1
        if [ "$shell_rc_was_present" -eq 0 ] && [ -e "$rc" ]; then
            warn "shell rc appeared while preparing update; refusing to overwrite: $rc"
            return 1
        fi
        mv "$SHELL_RC_TMP" "$rc" || return 1
        SHELL_RC_TMP=""
        info "added dot env source line to $rc"
    done <<EOF
$shell_rc_values
EOF
}

path_cmd() {
    preflight_shell_rc_files || fail "unsafe shell rc path"
    write_env_file
    inject_shell_rc
    # This affects only this process and any commands still run by this script.
    # The caller's already-running shell must source ENV_FILE or open a new shell.
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    info "dotpanel bin is on PATH via $ENV_FILE: $DOT_BIN"
    if command -v dot >/dev/null 2>&1; then
        info "dot is available in this process: $(command -v dot)"
    else
        warn "dot is not on this shell's PATH yet"
    fi
    if command -v dkey >/dev/null 2>&1; then
        info "dkey is available in this process: $(command -v dkey)"
    else
        warn "dkey is not on this shell's PATH yet"
    fi
    printf 'For this already-open shell, run:\n  . "%s"\n' "$ENV_FILE"
}

first_nonempty_line() {
    # first_nonempty_line <file>
    awk 'NF { print; exit }' "$1" 2>/dev/null || true
}

find_entry_candidates() {
    # Print NUL-free tab-separated records: path<TAB>first line.
    # Scope: home root plus one level down.
    find "$HOME_DIR" -maxdepth 2 \( -name AGENTS.md -o -name CLAUDE.md \) \
        -type f 2>/dev/null | sort | while IFS= read -r file; do
            case "$file" in
                "$ENTRY_FILE"|"$DOT_DIR"/*) continue ;;
            esac
            line="$(first_nonempty_line "$file")"
            printf '%s\t%s\n' "$file" "$line"
        done
}

write_template_entry() {
    if [ -f "$TEMPLATE_ENTRY" ]; then
        cp "$TEMPLATE_ENTRY" "$ENTRY_FILE"
        return 0
    fi
    cat > "$ENTRY_FILE" <<'EOF'
# User Memspace

`~/.agents/` is the private memspace.
`~/.agents/AGENTS.md` is the entry.

Read this file first. Then read project-local `./.agents/AGENTS.md` when it
exists. Do not recursively scan `~/.agents/` or `./.agents/`; read only entry
files, files they explicitly reference, or files the user names.

## Voice

Describe operator voice, language preferences, and durable artifact language
here.

## Default Posture

- Follow the user's direct instructions first.
- Read before advising. When the real problem sits one layer lower than the
  question, name that lower layer.
- Default ambiguous requests to exploration and decision. Reserve file writes,
  commits, broad scripts, and agent spawning for explicit implementation verbs
  or clear task ownership.

## Read Families

Keep this entry self-contained at first. Add a route only after its target
exists, and lazy-load only the named files. Link to one source of truth instead
of copying its contents into this entry.

## Hard Edges

Follow the user's direct instructions first.

`~/.agents/.dotpanel/` is managed public tooling; do not edit it unless the
task is about dotpanel itself.

`dkey` is privileged. Subagents must refuse any `dkey` invocation or wrapper
known to use it. Unscoped `dkey on` is disabled. Main-agent credential use
requires `dkey run --with GRANT -- ...`, or `dkey on --with GRANT` only for an
authorized interactive tool. Run `dkey off` before activating another grant.

Never output secret values in logs or responses.

## Memspace Tooling

`dot init` is bootstrap. Install scripts run it once; day-to-day use should not
need it.

Use `dot set -a` after editing `~/.agents/AGENTS.md` or after pulling memspace
changes. It renders the managed Claude, Codex, and Kimi entry files. Use
`dot set claude`, `dot set codex`, or `dot set kimi` for one harness.

Use `dot doctor` for a read-only wiring check (entry wrappers, rendered
plugins, aliases, PATH, dependencies); run it after entry, skill, or routing
changes. Use `dot self status` / `dot self update` to inspect and update the
managed dotpanel checkout itself.

Use `dot sync status`, `dot sync diff`, `dot sync pull`, and `dot sync push` to
move the memspace repo across machines. `dot sync pull` fetches, requires a
clean worktree and a fast-forward path, recursively initializes/updates
submodules, then re-renders entries. `dot sync push` requires a clean worktree
and pushes existing commits only; it never stages or commits files.

Use `dkey keygen` once to create the local age identity. Use
`dkey set NAME VALUE` or `dkey set NAME=VALUE` to create or overwrite encrypted
keys, and `dkey list` to list key names.

Discover grant names with `dkey grants`; it prints each grant and the env vars
it injects, never secret values. Inject credentials with
`dkey run --with GRANT -- COMMAND`. For a non-interactive agent that is the
only functional path — each agent command runs in a fresh shell, so `dkey on`
exports die with the call. Use `dkey on --with GRANT` only for an authorized
interactive shell and `dkey off` to remove what it set. `dkey status` and
`dkey doctor` are read-only health checks.

## Layout

- `bin/` — user-owned command wrappers and ops verbs.
- `infra/` — machines, domains, services, desired state, network notes.
- `secrets/` — encrypted or template secret material; no plaintext real keys.
- `rules/` — behavior policy and scenario closure cards.
- `skills/` — optional user-authored skills; lazy load only when relevant.
- `journal/` — cross-session lessons; lazy load only when improving rules or doing retrospectives.
- `reference/` — optional long-form notes; lazy load only when relevant.
- `tools/` — helper libraries, templates, and docs used by `bin/`.
- `.dotpanel/` — managed checkout of the public `dot` / `dkey` tools; gitignored.
EOF
}

write_blank_entry() {
    cat > "$ENTRY_FILE" <<'EOF'
# User Memspace

`~/.agents/` is your memspace. `~/.agents/AGENTS.md` is the entry.
EOF
}

copy_entry_from() {
    src="$1"
    [ -f "$src" ] || fail "entry source not found: $src"
    cp "$src" "$ENTRY_FILE"
}

prompt_entry_seed() {
    [ -f "$ENTRY_FILE" ] && {
        info "$ENTRY_FILE already exists; leaving it unchanged"
        return 0
    }

    tmp="$DOT_DIR/var/init-candidates.tsv"
    find_entry_candidates > "$tmp"

    printf '\n%s\n' "Create $ENTRY_FILE?"
    printf '  1. Use dot template\n'

    count=1
    while IFS="$(printf '\t')" read -r path line; do
        count=$((count + 1))
        if [ -n "$line" ]; then
            printf '  %d. Use %s — %s\n' "$count" "$path" "$line"
        else
            printf '  %d. Use %s\n' "$count" "$path"
        fi
    done < "$tmp"

    blank_choice=$((count + 1))
    skip_choice=$((count + 2))
    printf '  %d. Blank AGENTS.md\n' "$blank_choice"
    printf '  %d. Skip\n' "$skip_choice"
    printf 'Select [%d]: ' "$skip_choice"

    read -r choice || choice="$skip_choice"
    [ -n "$choice" ] || choice="$skip_choice"

    if [ "$choice" = "1" ]; then
        write_template_entry
        info "created $ENTRY_FILE from template"
        return 0
    fi
    if [ "$choice" = "$blank_choice" ]; then
        write_blank_entry
        info "created blank $ENTRY_FILE"
        return 0
    fi
    if [ "$choice" = "$skip_choice" ]; then
        info "skipped entry creation"
        return 0
    fi
    if ! printf '%s' "$choice" | grep -Eq '^[0-9]+$'; then
        fail "invalid choice: $choice"
    fi
    if [ "$choice" -lt 2 ] || [ "$choice" -gt "$count" ]; then
        fail "invalid choice: $choice"
    fi

    idx=$((choice - 1))
    src="$(sed -n "${idx}p" "$tmp" | awk -F '\t' '{print $1}')"
    copy_entry_from "$src"
    info "created $ENTRY_FILE from $src"
}

init_cmd() {
    mode="prompt"
    src=""
    install_path=true

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --template) mode="template" ;;
            --blank) mode="blank" ;;
            --no-entry) mode="none" ;;
            --from)
                shift
                [ "$#" -gt 0 ] || fail "--from requires a path"
                mode="from"
                src="$1"
                ;;
            --yes|-y)
                # Non-interactive default: do not create user entry rules.
                [ "$mode" = "prompt" ] && mode="none"
                ;;
            --no-path)
                install_path=false
                ;;
            -h|--help) usage; return 0 ;;
            *) fail "unknown init argument: $1" ;;
        esac
        shift
    done

    ensure_agents_dir
    ensure_gitignore

    case "$mode" in
        template)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                write_template_entry
                info "created $ENTRY_FILE from template"
            fi
            ;;
        blank)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                write_blank_entry
                info "created blank $ENTRY_FILE"
            fi
            ;;
        from)
            if [ -f "$ENTRY_FILE" ]; then
                info "$ENTRY_FILE already exists; leaving it unchanged"
            else
                copy_entry_from "$src"
                info "created $ENTRY_FILE from $src"
            fi
            ;;
        none)
            info "entry creation skipped"
            ;;
        prompt)
            prompt_entry_seed
            ;;
        *) fail "internal error: bad init mode $mode" ;;
    esac

    configure_cmd --harness all
    if $install_path; then
        install_configure_traps
        path_cmd
        cleanup_configure_state
        clear_configure_traps
    fi
}

wrapper_body() {
    cat <<'EOF'
<!-- Generated by dot configure; do not edit directly. -->
`~/.agents/` is your memspace. `~/.agents/AGENTS.md` is the entry.

Before doing any work, read `~/.agents/AGENTS.md` if it exists.
Then read `./.agents/AGENTS.md` if it exists in the current repository.

Do not recursively scan `~/.agents/` or `./.agents/`. Read only the entry files above, files they explicitly reference, or files the user explicitly asks for.
EOF
}

is_safe_plugin_path() {
    plugin_path="$1"
    case "$plugin_path" in
        ""|*[!A-Za-z0-9._/-]*|/*|.|..|../*|*/..|*/../*) return 1 ;;
    esac
}

is_safe_skill_id() {
    skill_id="$1"
    case "$skill_id" in
        ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
}

resolve_plugin_source_dir() {
    plugin_root="$1"
    plugin_relative="$2"
    plugin_label="$3"
    is_safe_plugin_path "$plugin_relative" || {
        warn "unsafe $plugin_label path: $plugin_relative"
        return 1
    }
    [ -d "$plugin_root" ] && [ ! -L "$plugin_root" ] || {
        warn "plugin source root missing or symlinked: $plugin_root"
        return 1
    }
    plugin_cursor="$plugin_root"
    plugin_old_ifs="$IFS"
    IFS='/'
    set -- $plugin_relative
    IFS="$plugin_old_ifs"
    for plugin_component in "$@"; do
        [ -n "$plugin_component" ] || continue
        plugin_cursor="$plugin_cursor/$plugin_component"
        [ ! -L "$plugin_cursor" ] || {
            warn "$plugin_label path contains a symlink: $plugin_cursor"
            return 1
        }
    done
    [ -d "$plugin_cursor" ] || {
        warn "$plugin_label directory missing: $plugin_cursor"
        return 1
    }
    plugin_root_real="$(cd "$plugin_root" && pwd -P)" || return 1
    plugin_cursor_real="$(cd "$plugin_cursor" && pwd -P)" || return 1
    case "$plugin_cursor_real/" in
        "$plugin_root_real/"*) ;;
        *) warn "$plugin_label escapes its source root: $plugin_relative"; return 1 ;;
    esac
    printf '%s\n' "$plugin_cursor_real"
}

reject_plugin_tree_symlinks() {
    plugin_tree="$1"
    plugin_label="$2"
    plugin_symlink="$(find "$plugin_tree" -type l -print -quit 2>/dev/null)" || {
        warn "could not inspect $plugin_label tree: $plugin_tree"
        return 1
    }
    if [ -n "$plugin_symlink" ]; then
        warn "$plugin_label contains symlinks; refusing to render it"
        return 1
    fi
}

read_skill_metadata() {
    metadata_file="$1"
    metadata_label="$2"
    [ -f "$metadata_file" ] && [ ! -L "$metadata_file" ] || {
        warn "$metadata_label SKILL.md missing or symlinked: $metadata_file"
        return 1
    }
    command -v python3 >/dev/null 2>&1 || {
        warn "python3 with PyYAML is required to validate skill frontmatter"
        return 1
    }
    SKILL_NAME="$(python3 - "$metadata_file" <<'PY'
import sys

try:
    import yaml
except ImportError:
    raise SystemExit(2)


class UniqueSafeLoader(yaml.SafeLoader):
    pass


def construct_mapping(loader, node, deep=False):
    loader.flatten_mapping(node)
    mapping = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in mapping:
            raise yaml.constructor.ConstructorError(
                "while constructing a mapping",
                node.start_mark,
                f"duplicate key: {key!r}",
                key_node.start_mark,
            )
        mapping[key] = loader.construct_object(value_node, deep=deep)
    return mapping


UniqueSafeLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
    construct_mapping,
)

try:
    lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
    if not lines or lines[0] != "---":
        raise ValueError("opening marker is required")
    closing = lines[1:].index("---") + 1
    frontmatter_lines = lines[1:closing]
    frontmatter = "\n".join(frontmatter_lines)
    metadata = yaml.load(frontmatter, Loader=UniqueSafeLoader)
    metadata_node = yaml.compose(frontmatter, Loader=yaml.SafeLoader)
    if not isinstance(metadata, dict):
        raise ValueError("frontmatter must be a mapping")
    name_node = None
    if isinstance(metadata_node, yaml.nodes.MappingNode):
        for key_node, value_node in metadata_node.value:
            if isinstance(key_node, yaml.nodes.ScalarNode) and key_node.value == "name":
                name_node = value_node
                break
    if not isinstance(name_node, yaml.nodes.ScalarNode) or name_node.style in {"|", ">"}:
        raise ValueError("name must be an inline string")
    name = metadata.get("name")
    description = metadata.get("description")
    if not isinstance(name, str) or not name.strip():
        raise ValueError("name must be a non-empty string")
    if not isinstance(description, str) or not description.strip():
        raise ValueError("description must be a non-empty string")
    name.encode("utf-8")
    description.encode("utf-8")
except (OSError, UnicodeError, ValueError, TypeError, yaml.YAMLError):
    raise SystemExit(1)

print(name.strip())
PY
    )" || {
        warn "$metadata_label has no description or invalid frontmatter: $metadata_file"
        return 1
    }
    is_safe_skill_id "$SKILL_NAME" || {
        warn "$metadata_label has unsafe skill name: $SKILL_NAME"
        return 1
    }
}

cleanup_plugin_render_temps() {
    rm -rf "$DOT_DIR/var/plugin.hio.$$" "$DOT_DIR/var/plugin.matt.$$" \
        "$DOT_DIR/var/plugin.impeccable.$$" "$DOT_DIR/var/legacy-plugin.$$.hio" \
        "$DOT_DIR/var/legacy-plugin.$$.matt" "$DOT_DIR/var/legacy-plugin.$$.impeccable"
    rm -f "$DOT_DIR/var/.matt_skills.$$" "${MATT_SKILL_LIST_TMP:-}"
    MATT_SKILL_LIST_TMP=""
}

# _gen_plugin_flat <name> <src_dir> — generate a plugin from flat skill dirs.
# Scans <src_dir>/*/SKILL.md. Output: $CLAUDE_SKILLS/<name>/
_gen_plugin_flat() {
    plugin_name="$1"
    plugin_relative="$2"
    out_dir="$CLAUDE_SKILLS/$plugin_name"

    [ -e "$SKILLS_SRC/$plugin_relative" ] || [ -L "$SKILLS_SRC/$plugin_relative" ] || return 0
    src_dir="$(resolve_plugin_source_dir "$SKILLS_SRC" "$plugin_relative" "$plugin_name plugin")" || return 1

    tmp="$DOT_DIR/var/plugin.$plugin_name.$$"
    rm -rf "$tmp" || return 1
    mkdir -p "$tmp/.claude-plugin" "$tmp/skills" || return 1

    count=0
    for skill_dir in "$src_dir"/*; do
        [ -d "$skill_dir" ] || continue
        [ ! -L "$skill_dir" ] || { warn "$plugin_name skill directory is symlinked: $skill_dir"; return 1; }
        reject_plugin_tree_symlinks "$skill_dir" "$plugin_name skill" || return 1
        skill_file="$skill_dir/SKILL.md"
        [ -f "$skill_file" ] || continue

        read_skill_metadata "$skill_file" "$plugin_name skill" || return 1
        skill_name="$SKILL_NAME"
        [ ! -e "$tmp/skills/$skill_name" ] || {
            warn "$plugin_name plugin has duplicate skill name: $skill_name"
            return 1
        }
        cp -R "$skill_dir" "$tmp/skills/$skill_name" || return 1
        count=$((count + 1))
    done

    cat > "$tmp/.claude-plugin/plugin.json" <<PLUGINJSON || return 1
{
  "name": "$plugin_name",
  "description": "$plugin_name skills from memspace",
  "version": "$VERSION",
  "author": { "name": "dot" }
}
PLUGINJSON
    printf '%s\n' "$CLAUDE_PLUGIN_OWNER" > "$tmp/$CLAUDE_PLUGIN_OWNER_FILE" || return 1

    mkdir -p "$(dirname "$out_dir")" || return 1
    rm -rf "$out_dir" || return 1
    mv "$tmp" "$out_dir" || return 1
    info "generated $plugin_name plugin: $count skill(s) -> $out_dir"
}

# _gen_matt_plugin — generate from mattpocock/skills git clone.
# Reads upstream .claude-plugin/plugin.json for the skill manifest,
# flattens categorized paths (skills/engineering/diagnose) into flat skill dirs.
# Output: $CLAUDE_SKILLS/matt/
_gen_matt_plugin() {
    out_dir="$CLAUDE_SKILLS/matt"

    [ -e "$SKILLS_SRC/matt" ] || [ -L "$SKILLS_SRC/matt" ] || return 0
    src="$(resolve_plugin_source_dir "$SKILLS_SRC" "matt" "matt plugin")" || return 1
    manifest="$src/.claude-plugin/plugin.json"
    [ -f "$manifest" ] && [ ! -L "$manifest" ] || { warn "matt plugin.json missing or symlinked at $manifest"; return 1; }
    command -v jq >/dev/null || { warn "jq required for matt plugin generation"; return 1; }
    jq -e '.skills | type == "array" and all(.[]; type == "string" and length > 0)' \
        "$manifest" >/dev/null 2>&1 || { warn "invalid matt plugin skill manifest: $manifest"; return 1; }

    tmp="$DOT_DIR/var/plugin.matt.$$"
    rm -rf "$tmp" || return 1
    mkdir -p "$tmp/.claude-plugin" "$tmp/skills" || return 1

    # Write skill paths to temp file to avoid subshell pipe
    MATT_SKILL_LIST_TMP="$(mktemp "$DOT_DIR/var/matt-skills.XXXXXX")" || return 1
    skill_list="$MATT_SKILL_LIST_TMP"
    jq -r '.skills[]' "$manifest" > "$skill_list" || return 1

    count=0
    while IFS= read -r skill_path; do
        [ -n "$skill_path" ] || continue
        is_safe_plugin_path "$skill_path" || { warn "unsafe matt skill path: $skill_path"; return 1; }
        skill_dir="$(resolve_plugin_source_dir "$src" "$skill_path" "matt skill")" || return 1
        reject_plugin_tree_symlinks "$skill_dir" "matt skill" || return 1
        skill_file="$skill_dir/SKILL.md"
        [ -f "$skill_file" ] || { warn "matt skill not found: $skill_path"; return 1; }

        read_skill_metadata "$skill_file" "matt skill" || return 1
        skill_name="$SKILL_NAME"

        [ ! -e "$tmp/skills/$skill_name" ] || { warn "matt plugin has duplicate skill name: $skill_name"; return 1; }
        cp -R "$skill_dir" "$tmp/skills/$skill_name" || return 1
        count=$((count + 1))
    done < "$skill_list"
    rm -f "$skill_list" || return 1
    MATT_SKILL_LIST_TMP=""

    cat > "$tmp/.claude-plugin/plugin.json" <<PLUGINJSON || return 1
{
  "name": "matt",
  "description": "Matt Pocock engineering & productivity skills",
  "author": { "name": "dot" }
}
PLUGINJSON
    printf '%s\n' "$CLAUDE_PLUGIN_OWNER" > "$tmp/$CLAUDE_PLUGIN_OWNER_FILE" || return 1

    mkdir -p "$(dirname "$out_dir")" || return 1
    rm -rf "$out_dir" || return 1
    mv "$tmp" "$out_dir" || return 1
    info "generated matt plugin: $count skill(s) -> $out_dir"
}

# _gen_impeccable_plugin — generate from pbakaus/impeccable git clone.
# Moves scripts/ to plugin root so hardcoded .claude/skills/impeccable/scripts/
# paths work natively. reference/ stays inside the skill dir for relative refs.
# Output: $CLAUDE_SKILLS/impeccable/
_gen_impeccable_plugin() {
    out_dir="$CLAUDE_SKILLS/impeccable"

    [ -e "$SKILLS_SRC/impeccable" ] || [ -L "$SKILLS_SRC/impeccable" ] || return 0
    src="$(resolve_plugin_source_dir "$SKILLS_SRC" "impeccable" "impeccable plugin")" || return 1
    skill_src="$(resolve_plugin_source_dir "$src" "plugin/skills/impeccable" "impeccable skill")" || return 1
    reject_plugin_tree_symlinks "$skill_src" "impeccable skill" || return 1
    read_skill_metadata "$skill_src/SKILL.md" "impeccable skill" || return 1
    [ "$SKILL_NAME" = "impeccable" ] || { warn "impeccable skill name mismatch: $SKILL_NAME"; return 1; }

    tmp="$DOT_DIR/var/plugin.impeccable.$$"
    rm -rf "$tmp" || return 1
    mkdir -p "$tmp/.claude-plugin" "$tmp/skills/impeccable" || return 1

    # SKILL.md + reference/ stay inside skills/impeccable/
    cp "$skill_src/SKILL.md" "$tmp/skills/impeccable/" || return 1
    if [ -d "$skill_src/reference" ]; then
        cp -R "$skill_src/reference" "$tmp/skills/impeccable/reference" || return 1
    fi

    # Scripts go to plugin root so .claude/skills/impeccable/scripts/ works
    if [ -d "$skill_src/scripts" ]; then
        cp -R "$skill_src/scripts" "$tmp/scripts" || return 1
    fi

    # Agents (if any)
    if [ -d "$src/plugin/agents" ]; then
        agents_src="$(resolve_plugin_source_dir "$src" "plugin/agents" "impeccable agents")" || return 1
        reject_plugin_tree_symlinks "$agents_src" "impeccable agents" || return 1
        cp -R "$agents_src" "$tmp/agents" || return 1
    fi

    cat > "$tmp/.claude-plugin/plugin.json" <<PLUGINJSON || return 1
{
  "name": "impeccable",
  "description": "Frontend design & craft skill — 23 sub-commands",
  "author": { "name": "dot" }
}
PLUGINJSON
    printf '%s\n' "$CLAUDE_PLUGIN_OWNER" > "$tmp/$CLAUDE_PLUGIN_OWNER_FILE" || return 1

    mkdir -p "$(dirname "$out_dir")" || return 1
    rm -rf "$out_dir" || return 1
    mv "$tmp" "$out_dir" || return 1
    info "generated impeccable plugin -> $out_dir"
}

generate_claude_plugins() {
    # Build per-source Claude Code plugins from ~/.agents/skills/{hio,matt,impeccable}/.
    # Output: ~/.claude/skills/{hio,matt,impeccable}/
    # Claude Code auto-discovers plugins with .claude-plugin/plugin.json in this directory.
    SKILLS_SRC="$AGENTS_DIR/skills"
    [ ! -L "$SKILLS_SRC" ] || {
        warn "Claude plugin skills root must not be symlinked: $SKILLS_SRC"
        return 1
    }
    [ ! -e "$SKILLS_SRC" ] || [ -d "$SKILLS_SRC" ] || {
        warn "Claude plugin skills root is not a directory: $SKILLS_SRC"
        return 1
    }
    [ -d "$SKILLS_SRC" ] || return 0

    cleanup_plugin_render_temps
    _gen_plugin_flat "hio" "hio" || { cleanup_plugin_render_temps; return 1; }
    _gen_matt_plugin || { cleanup_plugin_render_temps; return 1; }
    _gen_impeccable_plugin || { cleanup_plugin_render_temps; return 1; }
}

is_dot_managed_claude_plugin_dir() {
    plugin_dir="$1"
    [ -d "$plugin_dir" ] && [ ! -L "$plugin_dir" ] &&
        [ -f "$plugin_dir/$CLAUDE_PLUGIN_OWNER_FILE" ] &&
        [ ! -L "$plugin_dir/$CLAUDE_PLUGIN_OWNER_FILE" ] &&
        [ -f "$plugin_dir/.claude-plugin/plugin.json" ] &&
        [ ! -L "$plugin_dir/.claude-plugin/plugin.json" ] &&
        grep -qxF "$CLAUDE_PLUGIN_OWNER" "$plugin_dir/$CLAUDE_PLUGIN_OWNER_FILE"
}

ensure_safe_codex_skills_root() {
    create_root="${1:-0}"
    ensure_safe_home_path "$HOME_DIR/.codex" "Codex config root" || return 1
    [ ! -L "$HOME_DIR/.codex" ] || {
        warn "Codex config root must not be symlinked: $HOME_DIR/.codex"
        return 1
    }
    if [ -e "$HOME_DIR/.codex" ] && [ ! -d "$HOME_DIR/.codex" ]; then
        warn "Codex config root is not a directory: $HOME_DIR/.codex"
        return 1
    fi
    ensure_safe_generated_file "$HOME_DIR/.codex/AGENTS.md" "Codex wrapper" || return 1
    [ ! -L "$CODEX_SKILLS" ] || {
        warn "Codex skills root must not be symlinked: $CODEX_SKILLS"
        return 1
    }
    if [ -e "$CODEX_SKILLS" ] && [ ! -d "$CODEX_SKILLS" ]; then
        warn "Codex skills root is not a directory: $CODEX_SKILLS"
        return 1
    fi
    if [ "$create_root" -eq 1 ]; then
        mkdir -p "$CODEX_SKILLS" || return 1
        ensure_safe_home_path "$CODEX_SKILLS" "Codex skills root" || return 1
        [ -d "$CODEX_SKILLS" ] && [ ! -L "$CODEX_SKILLS" ] || return 1
    fi
}

ensure_safe_claude_skills_root() {
    create_root="${1:-0}"
    ensure_safe_home_path "$HOME_DIR/.claude" "Claude config root" || return 1
    [ ! -L "$HOME_DIR/.claude" ] || {
        warn "Claude config root must not be symlinked: $HOME_DIR/.claude"
        return 1
    }
    if [ -e "$HOME_DIR/.claude" ] && [ ! -d "$HOME_DIR/.claude" ]; then
        warn "Claude config root is not a directory: $HOME_DIR/.claude"
        return 1
    fi
    ensure_safe_generated_file "$HOME_DIR/.claude/CLAUDE.md" "Claude wrapper" || return 1
    [ ! -L "$CLAUDE_SKILLS" ] || {
        warn "Claude skills root must not be symlinked: $CLAUDE_SKILLS"
        return 1
    }
    if [ -e "$CLAUDE_SKILLS" ] && [ ! -d "$CLAUDE_SKILLS" ]; then
        warn "Claude skills root is not a directory: $CLAUDE_SKILLS"
        return 1
    fi
    if [ "$create_root" -eq 1 ]; then
        mkdir -p "$CLAUDE_SKILLS" || return 1
        ensure_safe_home_path "$CLAUDE_SKILLS" "Claude skills root" || return 1
        [ -d "$CLAUDE_SKILLS" ] && [ ! -L "$CLAUDE_SKILLS" ] || return 1
    fi
}

ensure_safe_kimi_root() {
    ensure_safe_home_path "$HOME_DIR/.kimi" "Kimi config root" || return 1
    [ ! -L "$HOME_DIR/.kimi" ] || {
        warn "Kimi config root must not be symlinked: $HOME_DIR/.kimi"
        return 1
    }
    if [ -e "$HOME_DIR/.kimi" ] && [ ! -d "$HOME_DIR/.kimi" ]; then
        warn "Kimi config root is not a directory: $HOME_DIR/.kimi"
        return 1
    fi
    ensure_safe_generated_file "$HOME_DIR/.kimi/AGENTS.md" "Kimi wrapper" || return 1
}

is_migratable_legacy_claude_plugin() {
    expected_plugin="$1"
    actual_plugin="$2"
    [ -d "$expected_plugin" ] && [ -d "$actual_plugin" ] && [ ! -L "$actual_plugin" ] || return 1
    [ ! -e "$actual_plugin/$CLAUDE_PLUGIN_OWNER_FILE" ] && \
        [ ! -L "$actual_plugin/$CLAUDE_PLUGIN_OWNER_FILE" ] || return 1
    reject_plugin_tree_symlinks "$actual_plugin" "legacy Claude plugin" || return 1
    legacy_expected="$DOT_DIR/var/legacy-plugin.$$.${plugin_name:-unknown}"
    rm -rf "$legacy_expected" || return 1
    cp -R "$expected_plugin" "$legacy_expected" || { rm -rf "$legacy_expected"; return 1; }
    rm -f "$legacy_expected/$CLAUDE_PLUGIN_OWNER_FILE" || { rm -rf "$legacy_expected"; return 1; }
    if diff -qr "$legacy_expected" "$actual_plugin" >/dev/null 2>&1; then
        rm -rf "$legacy_expected" || return 1
        return 0
    fi
    rm -rf "$legacy_expected" || return 1
    return 1
}

is_safe_alias_path() {
    path="$1"
    case "$path" in
        ""|*[!A-Za-z0-9._/-]*|/*|*/|.|./*|*/.|*/./*|..|../*|*/..|*/../*|*//*) return 1 ;;
    esac
}

validate_codex_alias_manifest() {
    jq -e '
        .version == 1 and
        (.alias_adapter | type == "object") and
        .alias_adapter.owner == "dotpanel" and
        .alias_adapter.destination == "~/.codex/skills" and
        .alias_adapter.renderer == "dot set codex" and
        (.alias_adapter.retired_aliases | type == "array") and
        (all(.alias_adapter.retired_aliases[]; type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))) and
        (.aliases | type == "array") and
        (all(.aliases[];
            (.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
            (.source | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
            (.skill | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
            (.target | type == "string" and test("^[A-Za-z0-9._/-]+$")) and
            (.description | type == "string" and length > 0 and length <= 500 and
                (explode | all(.[]; . >= 32 and (. < 127 or . > 159) and
                    . != 8232 and . != 8233))) and
            ((has("guidance") | not) or
                (.guidance | type == "string" and length > 0 and length <= 500 and
                    (explode | all(.[]; . >= 32 and (. < 127 or . > 159) and
                        . != 8232 and . != 8233)))))) and
        ([.aliases[].id] | length == (unique | length)) and
        (([.aliases[].id] + .alias_adapter.retired_aliases) | length == (unique | length)) and
        (.sources | type == "array") and
        (all(.sources[];
            (.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
            (.paths | type == "array" and length > 0) and
            (all(.paths[]; type == "string" and length > 0)))) and
        ([.sources[].id] | length == (unique | length))
    ' "$SKILL_SOURCES_MANIFEST" >/dev/null 2>&1
}

resolve_codex_alias_target() {
    source_id="$1"
    target="$2"

    is_safe_alias_path "$target" || {
        warn "unsafe Codex alias target: $target"
        return 1
    }
    jq -e --arg source "$source_id" '
        [.sources[] | select(.id == $source)] as $matches |
        ($matches | length) == 1 and ($matches[0].paths | length) == 1
    ' "$SKILL_SOURCES_MANIFEST" >/dev/null 2>&1 || {
        warn "Codex alias source must declare exactly one path: $source_id"
        return 1
    }
    source_path="$(jq -r --arg source "$source_id" '.sources[] | select(.id == $source) | .paths[0]' "$SKILL_SOURCES_MANIFEST")" || return 1
    is_safe_alias_path "$source_path" || {
        warn "unsafe Codex alias source path: $source_path"
        return 1
    }
    case "$source_path" in
        skills/*) ;;
        *) warn "Codex alias source path must stay below skills/: $source_path"; return 1 ;;
    esac
    [ ! -L "$AGENTS_DIR/$source_path" ] || {
        warn "Codex alias source path must not be symlinked: $source_path"
        return 1
    }

    agents_real="$(cd "$AGENTS_DIR" && pwd -P)" || return 1
    [ ! -L "$AGENTS_DIR/skills" ] || {
        warn "Codex alias skills root must not be symlinked: $AGENTS_DIR/skills"
        return 1
    }
    skills_real="$(cd "$AGENTS_DIR/skills" 2>/dev/null && pwd -P)" || {
        warn "Codex alias skills root missing: $AGENTS_DIR/skills"
        return 1
    }
    case "$skills_real/" in
        "$agents_real/skills/") ;;
        *) warn "Codex alias skills root escapes the memspace: $AGENTS_DIR/skills"; return 1 ;;
    esac
    source_real="$(cd "$AGENTS_DIR/$source_path" 2>/dev/null && pwd -P)" || {
        warn "Codex alias source path missing: $source_path"
        return 1
    }
    case "$source_real/" in
        "$skills_real/"*) ;;
        *) warn "Codex alias source escapes the skills root: $source_path"; return 1 ;;
    esac

    target_dir="$(dirname "$target")"
    target_name="$(basename "$target")"
    resolved_dir="$(cd "$source_real/$target_dir" 2>/dev/null && pwd -P)" || {
        warn "Codex alias target directory missing: $source_id/$target_dir"
        return 1
    }
    case "$resolved_dir/" in
        "$source_real/"*) ;;
        *) warn "Codex alias target escapes its source: $source_id/$target"; return 1 ;;
    esac
    resolved_target="$resolved_dir/$target_name"
    [ -f "$resolved_target" ] && [ ! -L "$resolved_target" ] || {
        warn "Codex alias target missing or symlinked: $source_id/$target"
        return 1
    }
    reject_plugin_tree_symlinks "$(dirname "$resolved_target")" "Codex alias source skill" || return 1
    printf '%s\n' "$resolved_target"
}

render_codex_alias_skill() {
    alias_id="$1"
    alias_description="$2"
    alias_guidance="$3"
    source_file="$4"
    output_file="$5"
    description_json="$(printf '%s' "$alias_description" | jq -Rs .)" || return 1
    {
        printf '%s\n' '---'
        printf 'name: %s\n' "$alias_id"
        printf 'description: %s\n' "$description_json"
        printf '%s\n' '---' "$CODEX_ALIAS_BANNER" '' "# $alias_id — Codex alias" '' 'Canonical skill:' ''
        printf '`%s`\n' "$source_file"
        printf '%s\n' '' 'Read the canonical file completely and follow its instructions.' \
            'Resolve relative references from the canonical skill directory.'
        if [ -n "$alias_guidance" ]; then
            printf '%s\n' '' 'Alias-specific guidance:' '' "$alias_guidance"
        fi
    } > "$output_file" || return 1
}

build_codex_alias_tree() {
    output_root="$1"
    mkdir -p "$DOT_DIR/var" || return 1
    rm -rf "$output_root" || return 1
    mkdir -p "$output_root" || return 1
    if [ ! -e "$SKILL_SOURCES_MANIFEST" ] && [ ! -L "$SKILL_SOURCES_MANIFEST" ]; then
        return 0
    fi
    [ -f "$SKILL_SOURCES_MANIFEST" ] && [ ! -L "$SKILL_SOURCES_MANIFEST" ] || {
        warn "Codex alias manifest must be a regular non-symlinked file: $SKILL_SOURCES_MANIFEST"
        return 1
    }
    validate_codex_alias_manifest || {
        warn "invalid Codex alias manifest: $SKILL_SOURCES_MANIFEST"
        return 1
    }

    alias_count="$(jq -r '.aliases | length' "$SKILL_SOURCES_MANIFEST")" || return 1
    alias_index=0
    while [ "$alias_index" -lt "$alias_count" ]; do
        alias_id="$(jq -r --argjson i "$alias_index" '.aliases[$i].id' "$SKILL_SOURCES_MANIFEST")" || return 1
        source_id="$(jq -r --argjson i "$alias_index" '.aliases[$i].source' "$SKILL_SOURCES_MANIFEST")" || return 1
        skill_name="$(jq -r --argjson i "$alias_index" '.aliases[$i].skill' "$SKILL_SOURCES_MANIFEST")" || return 1
        target="$(jq -r --argjson i "$alias_index" '.aliases[$i].target' "$SKILL_SOURCES_MANIFEST")" || return 1
        alias_description="$(jq -r --argjson i "$alias_index" '.aliases[$i].description' "$SKILL_SOURCES_MANIFEST")" || return 1
        alias_guidance="$(jq -r --argjson i "$alias_index" '.aliases[$i].guidance // empty' "$SKILL_SOURCES_MANIFEST")" || return 1
        source_file="$(resolve_codex_alias_target "$source_id" "$target")" || {
            return 1
        }
        read_skill_metadata "$source_file" "Codex alias source" || return 1
        actual_skill_name="$SKILL_NAME"
        [ "$actual_skill_name" = "$skill_name" ] || {
            warn "Codex alias skill mismatch for $alias_id: manifest=$skill_name source=$actual_skill_name"
            return 1
        }
        mkdir -p "$output_root/$alias_id" || return 1
        render_codex_alias_skill "$alias_id" "$alias_description" "$alias_guidance" \
            "$source_file" "$output_root/$alias_id/SKILL.md" || return 1
        alias_index=$((alias_index + 1))
    done
}

is_dot_managed_codex_alias_dir() {
    managed_alias_candidate="$1"
    [ -d "$managed_alias_candidate" ] && [ ! -L "$managed_alias_candidate" ] &&
        [ -f "$managed_alias_candidate/SKILL.md" ] && [ ! -L "$managed_alias_candidate/SKILL.md" ] &&
        grep -qxF "$CODEX_ALIAS_BANNER" "$managed_alias_candidate/SKILL.md"
}

preflight_codex_aliases() {
    codex_preflight_root="$1"
    ensure_safe_codex_skills_root 0 || return 1
    build_codex_alias_tree "$codex_preflight_root" || {
        rm -rf "$codex_preflight_root" || true
        warn "could not render Codex skill aliases"
        return 1
    }

    # Check every declared and retired ID before mutating any alias.
    for alias_dir in "$codex_preflight_root"/*/; do
        [ -d "$alias_dir" ] || continue
        alias_id="$(basename "$alias_dir")" || return 1
        destination="$CODEX_SKILLS/$alias_id"
        if { [ -e "$destination" ] || [ -L "$destination" ]; } && ! is_dot_managed_codex_alias_dir "$destination"; then
            rm -rf "$codex_preflight_root" || true
            warn "Codex alias destination is unmanaged; refusing to overwrite: $destination"
            return 1
        fi
    done

    if [ -f "$SKILL_SOURCES_MANIFEST" ] && [ ! -L "$SKILL_SOURCES_MANIFEST" ]; then
        retired_list="$(mktemp "$DOT_DIR/var/codex-retired-aliases.XXXXXX")" || {
            rm -rf "$codex_preflight_root"
            warn "could not create retired Codex alias list"
            return 1
        }
        jq -r '.alias_adapter.retired_aliases[]' "$SKILL_SOURCES_MANIFEST" > "$retired_list" || {
            rm -f "$retired_list"
            rm -rf "$codex_preflight_root"
            warn "could not read retired Codex aliases"
            return 1
        }
        while IFS= read -r alias_id; do
            [ -n "$alias_id" ] || continue
            destination="$CODEX_SKILLS/$alias_id"
            if { [ -e "$destination" ] || [ -L "$destination" ]; } && ! is_dot_managed_codex_alias_dir "$destination"; then
                rm -f "$retired_list"
                rm -rf "$codex_preflight_root"
                warn "retired Codex alias is unmanaged; remove it manually: $destination"
                return 1
            fi
        done < "$retired_list"
        rm -f "$retired_list" || return 1
    fi
}

apply_codex_aliases() {
    codex_apply_root="$1"
    ensure_safe_codex_skills_root 1 || return 1

    # Remove only stale aliases carrying dot's ownership banner.
    for destination in "$CODEX_SKILLS"/*; do
        [ -d "$destination" ] || continue
        alias_id="$(basename "$destination")" || return 1
        if is_dot_managed_codex_alias_dir "$destination" && [ ! -d "$codex_apply_root/$alias_id" ]; then
            rm -rf "$destination" || return 1
            info "removed stale Codex alias: $alias_id"
        fi
    done

    for alias_dir in "$codex_apply_root"/*/; do
        [ -d "$alias_dir" ] || continue
        alias_id="$(basename "$alias_dir")" || return 1
        alias_destination="$CODEX_SKILLS/$alias_id"
        if { [ -e "$alias_destination" ] || [ -L "$alias_destination" ]; } && \
            ! is_dot_managed_codex_alias_dir "$alias_destination"; then
            warn "Codex alias destination became unmanaged after preflight: $alias_destination"
            return 1
        fi
        rm -rf "$alias_destination" || return 1
        mv "$alias_dir" "$alias_destination" || return 1
        info "generated Codex alias: $alias_id -> $CODEX_SKILLS/$alias_id"
    done
    rm -rf "$codex_apply_root" || return 1
}

configure_codex_aliases() {
    codex_configure_staging="$DOT_DIR/var/codex-aliases-render.$$"
    preflight_codex_aliases "$codex_configure_staging" || \
        fail "could not reconcile Codex skill aliases"
    apply_codex_aliases "$codex_configure_staging" || \
        fail "could not install Codex skill aliases"
}

doctor_codex_aliases() {
    ensure_safe_codex_skills_root 0 || return 1
    mkdir -p "$DOT_DIR/var" || return 1
    DOCTOR_CODEX_ALIASES_TMP="$(mktemp -d "$DOT_DIR/var/doctor-codex-aliases.XXXXXX")" || return 1
    expected_root="$DOCTOR_CODEX_ALIASES_TMP"
    alias_problems=0
    if ! build_codex_alias_tree "$expected_root"; then
        warn "could not render expected Codex aliases"
        rm -rf "$expected_root"
        return 1
    fi

    for doctor_expected_alias_dir in "$expected_root"/*/; do
        [ -d "$doctor_expected_alias_dir" ] || continue
        doctor_alias_id="$(basename "$doctor_expected_alias_dir")"
        doctor_destination="$CODEX_SKILLS/$doctor_alias_id"
        if [ ! -e "$doctor_destination" ] && [ ! -L "$doctor_destination" ]; then
            warn "Codex alias missing: $doctor_destination"
            alias_problems=$((alias_problems + 1))
        elif ! is_dot_managed_codex_alias_dir "$doctor_destination"; then
            warn "Codex alias destination unmanaged: $doctor_destination"
            alias_problems=$((alias_problems + 1))
        elif ! reject_plugin_tree_symlinks "$doctor_destination" "Codex alias $doctor_alias_id"; then
            alias_problems=$((alias_problems + 1))
        elif diff -qr "$doctor_expected_alias_dir" "$doctor_destination" >/dev/null 2>&1; then
            info "Codex alias current: $doctor_alias_id"
        else
            warn "Codex alias differs from source render: $doctor_destination"
            alias_problems=$((alias_problems + 1))
        fi
    done

    for doctor_destination in "$CODEX_SKILLS"/*; do
        [ -d "$doctor_destination" ] || continue
        doctor_alias_id="$(basename "$doctor_destination")"
        if is_dot_managed_codex_alias_dir "$doctor_destination" && [ ! -d "$expected_root/$doctor_alias_id" ]; then
            warn "stale dot-managed Codex alias: $doctor_destination"
            alias_problems=$((alias_problems + 1))
        fi
    done
    rm -rf "$expected_root"
    DOCTOR_CODEX_ALIASES_TMP=""
    [ "$alias_problems" -eq 0 ]
}

write_file_if_changed() {
    target="$1"
    tmp="$2"
    ensure_safe_generated_file "$target" "generated wrapper" || return 1
    mkdir -p "$(dirname "$target")" || return 1
    ensure_safe_generated_file "$target" "generated wrapper" || return 1
    if [ -f "$target" ] && cmp -s "$target" "$tmp"; then
        rm -f "$tmp" || return 1
        info "current $target"
        return 0
    fi
    ensure_safe_generated_file "$target" "generated wrapper" || return 1
    mv "$tmp" "$target" || return 1
    info "wrote $target"
}

cleanup_prepared_configure() {
    for prepared_path in "${PREPARED_CODEX_ALIASES:-}" "${PREPARED_CLAUDE_PLUGINS:-}"; do
        [ -n "$prepared_path" ] && rm -rf "$prepared_path"
    done
    PREPARED_CODEX_ALIASES=""
    PREPARED_CLAUDE_PLUGINS=""
}

cleanup_configure_state() {
    rm -f "${ENV_TMP:-}" "${WRAPPER_TMP:-}" || true
    ENV_TMP=""
    WRAPPER_TMP=""
    cleanup_prepared_configure || true
    cleanup_plugin_render_temps || true
    cleanup_shell_rc_temps || true
}

configure_signal_exit() {
    configure_signal_status="$1"
    trap - EXIT HUP INT TERM
    cleanup_configure_state
    exit "$configure_signal_status"
}

install_configure_traps() {
    trap 'cleanup_configure_state' EXIT
    trap 'configure_signal_exit 129' HUP
    trap 'configure_signal_exit 130' INT
    trap 'configure_signal_exit 143' TERM
}

clear_configure_traps() {
    trap - EXIT HUP INT TERM
}

prepare_configure_targets() {
    configure_targets=" $1 "
    cleanup_prepared_configure

    case "$configure_targets" in
        *" kimi "*) ensure_safe_kimi_root || return 1 ;;
    esac

    case "$configure_targets" in
        *" codex "*)
            PREPARED_CODEX_ALIASES="$DOT_DIR/var/codex-aliases-prepared.$$"
            preflight_codex_aliases "$PREPARED_CODEX_ALIASES" || {
                cleanup_prepared_configure
                return 1
            }
            ;;
    esac

    case "$configure_targets" in
        *" claude "*)
            ensure_safe_claude_skills_root 0 || {
                cleanup_prepared_configure
                return 1
            }
            PREPARED_CLAUDE_PLUGINS="$DOT_DIR/var/claude-plugins-prepared.$$"
            rm -rf "$PREPARED_CLAUDE_PLUGINS" || return 1
            actual_claude_skills="$CLAUDE_SKILLS"
            CLAUDE_SKILLS="$PREPARED_CLAUDE_PLUGINS"
            if generate_claude_plugins >/dev/null; then
                plugin_prepare_status=0
            else
                plugin_prepare_status=$?
            fi
            CLAUDE_SKILLS="$actual_claude_skills"
            if [ "$plugin_prepare_status" -ne 0 ]; then
                cleanup_prepared_configure
                warn "could not prepare Claude plugin rendering"
                return 1
            fi
            for plugin_name in hio matt impeccable; do
                prepared_plugin="$PREPARED_CLAUDE_PLUGINS/$plugin_name"
                [ -d "$prepared_plugin" ] || continue
                plugin_destination="$actual_claude_skills/$plugin_name"
                if { [ -e "$plugin_destination" ] || [ -L "$plugin_destination" ]; } && \
                    ! is_dot_managed_claude_plugin_dir "$plugin_destination" && \
                    ! is_migratable_legacy_claude_plugin "$prepared_plugin" "$plugin_destination"; then
                    cleanup_prepared_configure
                    warn "Claude plugin destination is unmanaged; refusing to overwrite: $plugin_destination"
                    return 1
                fi
            done
            ;;
    esac
}

apply_prepared_claude_plugins() {
    [ -n "${PREPARED_CLAUDE_PLUGINS:-}" ] || {
        generate_claude_plugins || return 1
        return 0
    }
    ensure_safe_claude_skills_root 1 || return 1
    for plugin_name in hio matt impeccable; do
        prepared_plugin="$PREPARED_CLAUDE_PLUGINS/$plugin_name"
        plugin_destination="$CLAUDE_SKILLS/$plugin_name"
        if [ -d "$prepared_plugin" ]; then
            if { [ -e "$plugin_destination" ] || [ -L "$plugin_destination" ]; } && \
                ! is_dot_managed_claude_plugin_dir "$plugin_destination" && \
                ! is_migratable_legacy_claude_plugin "$prepared_plugin" "$plugin_destination"; then
                warn "Claude plugin destination became unmanaged: $plugin_destination"
                return 1
            fi
            mkdir -p "$(dirname "$plugin_destination")" || return 1
            rm -rf "$plugin_destination" || return 1
            mv "$prepared_plugin" "$plugin_destination" || return 1
            info "generated $plugin_name plugin -> $plugin_destination"
        elif is_dot_managed_claude_plugin_dir "$plugin_destination"; then
            rm -rf "$plugin_destination" || return 1
            info "removed stale Claude plugin: $plugin_name"
        fi
    done
    rm -rf "$PREPARED_CLAUDE_PLUGINS" || return 1
    PREPARED_CLAUDE_PLUGINS=""
}

configure_one() {
    harness="$1"
    case "$harness" in
        claude)
            target="$HOME_DIR/.claude/CLAUDE.md"
            apply_prepared_claude_plugins || fail "could not install Claude plugins"
            ;;
        codex)
            if [ -n "${PREPARED_CODEX_ALIASES:-}" ]; then
                apply_codex_aliases "$PREPARED_CODEX_ALIASES" || \
                    fail "could not install Codex skill aliases"
                PREPARED_CODEX_ALIASES=""
            else
                configure_codex_aliases
            fi
            target="$HOME_DIR/.codex/AGENTS.md"
            ;;
        kimi) target="$HOME_DIR/.kimi/AGENTS.md" ;;
        *) fail "unknown harness: $harness" ;;
    esac
    WRAPPER_TMP="$(mktemp "$DOT_DIR/var/wrapper.$harness.XXXXXX")" || \
        fail "could not create $harness wrapper staging file"
    if ! wrapper_body > "$WRAPPER_TMP"; then
        rm -f "$WRAPPER_TMP" || true
        WRAPPER_TMP=""
        fail "could not render $harness wrapper"
    fi
    if ! write_file_if_changed "$target" "$WRAPPER_TMP"; then
        rm -f "$WRAPPER_TMP" || true
        WRAPPER_TMP=""
        fail "could not install $harness wrapper"
    fi
    WRAPPER_TMP=""
}

configure_cmd() {
    harness="all"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --harness)
                shift
                [ "$#" -gt 0 ] || fail "--harness requires a value"
                harness="$1"
                ;;
            -h|--help) usage; return 0 ;;
            *) fail "unknown configure argument: $1" ;;
        esac
        shift
    done

    ensure_agents_dir
    install_configure_traps
    case "$harness" in
        all)
            prepare_configure_targets "claude codex kimi" || \
                fail "render preparation failed; generated harness state was not changed"
            configure_one claude
            configure_one codex
            configure_one kimi
            ;;
        claude|codex|kimi)
            prepare_configure_targets "$harness" || \
                fail "render preparation failed; generated harness state was not changed"
            configure_one "$harness"
            ;;
        *) fail "unknown harness: $harness" ;;
    esac
    write_env_file || fail "could not write dotpanel shell environment"
    cleanup_prepared_configure
    cleanup_plugin_render_temps
    clear_configure_traps
}

set_usage() {
    cat <<'EOF'
Usage:
  dot set -a|--all
  dot set TARGET [TARGET...]

TARGET = path | claude | codex | kimi

  path   - write env.sh and inject the source line into the shell rc
  claude - render ~/.claude/CLAUDE.md and generate .claude/skills/ plugins (hio/matt/impeccable)
  codex  - render ~/.codex/AGENTS.md and optional declared Codex skill aliases
  kimi   - render ~/.kimi/AGENTS.md

-a|--all expands to: path claude codex kimi
EOF
}

set_cmd() {
    targets=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--all|all) targets="path claude codex kimi" ;;
            --harness)
                shift
                [ "$#" -gt 0 ] || fail "--harness requires a value"
                case "$1" in
                    all) targets="path claude codex kimi" ;;
                    claude|codex|kimi) targets="$targets $1" ;;
                    *) fail "unknown harness: $1" ;;
                esac
                ;;
            path|claude|codex|kimi) targets="$targets $1" ;;
            help|-h|--help) set_usage; return 0 ;;
            *) fail "unknown set argument: $1" ;;
        esac
        shift
    done
    [ -n "$targets" ] || fail "set requires -a|--all or a target name"

    ensure_agents_dir
    install_configure_traps
    case " $targets " in
        *" path "*) preflight_shell_rc_files || fail "unsafe shell rc path" ;;
    esac
    prepare_configure_targets "$targets" || \
        fail "render preparation failed; generated harness state was not changed"
    do_path=0
    for t in $targets; do
        case "$t" in
            path) do_path=1 ;;
            claude|codex|kimi) configure_one "$t" ;;
        esac
    done
    if [ "$do_path" -eq 1 ]; then
        path_cmd
    else
        write_env_file || fail "could not write dotpanel shell environment"
    fi
    cleanup_prepared_configure
    cleanup_plugin_render_temps
    clear_configure_traps
}

unset_usage() {
    cat <<'EOF'
Usage:
  dot unset -a|--all
  dot unset TARGET [TARGET...]

TARGET = path | claude | codex | kimi

  path   - remove the source line from shell rc and delete env.sh
  claude - delete ~/.claude/CLAUDE.md and the generated plugin directories
  codex  - delete ~/.codex/AGENTS.md and dot-managed Codex skill aliases
  kimi   - delete ~/.kimi/AGENTS.md

-a|--all expands to: path claude codex kimi.
A wrapper file is only removed if it carries the dot-generated header;
hand-edited files are left untouched.
EOF
}

unset_one() {
    harness="$1"
    case "$harness" in
        claude) target="$HOME_DIR/.claude/CLAUDE.md" ;;
        codex)  target="$HOME_DIR/.codex/AGENTS.md" ;;
        kimi)   target="$HOME_DIR/.kimi/AGENTS.md" ;;
        *) fail "unknown harness: $harness" ;;
    esac
    case "$harness" in
        claude) ensure_safe_claude_skills_root 0 || fail "unsafe Claude config root" ;;
        codex) ensure_safe_codex_skills_root 0 || fail "unsafe Codex config root" ;;
        kimi) ensure_safe_kimi_root || fail "unsafe Kimi config root" ;;
    esac
    if [ -f "$target" ] && [ ! -L "$target" ]; then
        wrapper_owner_line="$(sed -n '1p' "$target")"
        if [ "$wrapper_owner_line" = '<!-- Generated by dot configure; do not edit directly. -->' ]; then
            ensure_safe_generated_file "$target" "$harness wrapper" || \
                fail "unsafe $harness wrapper target"
            rm -f "$target"
            info "removed $target"
        else
            warn "$target not generated by dot; leaving untouched"
        fi
    else
        info "$target already absent"
    fi
    if [ "$harness" = "claude" ]; then
        for plugin_name in hio matt impeccable; do
            plugin_dir="$CLAUDE_SKILLS/$plugin_name"
            if is_dot_managed_claude_plugin_dir "$plugin_dir"; then
                rm -rf "$plugin_dir" || fail "could not remove Claude plugin: $plugin_dir"
                info "removed $plugin_dir"
            elif [ -e "$plugin_dir" ] || [ -L "$plugin_dir" ]; then
                warn "$plugin_dir is unmanaged; leaving untouched"
            else
                info "$plugin_dir already absent"
            fi
        done
    fi
    if [ "$harness" = "codex" ]; then
        for alias_destination in "$CODEX_SKILLS"/*; do
            [ -d "$alias_destination" ] || continue
            if is_dot_managed_codex_alias_dir "$alias_destination"; then
                rm -rf "$alias_destination" || fail "could not remove Codex alias: $alias_destination"
                info "removed dot-managed Codex alias: $alias_destination"
            fi
        done
    fi
}

uninject_shell_rc() {
    line="$(path_source_line)"
    shell_rc_values="$(shell_rc_files)" || return 1
    while IFS= read -r rc; do
        [ -n "$rc" ] || continue
        ensure_safe_shell_rc_path "$rc" || return 1
        [ -e "$rc" ] || continue
        if ! grep -qxF "$line" "$rc"; then
            info "$rc has no dot env source line"
            continue
        fi
        rc_dir="$(dirname "$rc")" || return 1
        SHELL_RC_TMP="$(mktemp "$rc_dir/.dotpanel-rc.XXXXXX")" || return 1
        cp -p "$rc" "$SHELL_RC_TMP" || return 1
        SHELL_RC_BODY_TMP="$(mktemp "$rc_dir/.dotpanel-rc-body.XXXXXX")" || return 1
        awk -v target="$line" '
            {
                if ($0 == target) {
                    if (have_prev && prev == "# dot: memspace tools PATH") {
                        have_prev = 0
                        prev = ""
                    } else if (have_prev) {
                        print prev
                        have_prev = 0
                        prev = ""
                    }
                    next
                }
                if (have_prev) print prev
                prev = $0
                have_prev = 1
            }
            END { if (have_prev) print prev }
        ' "$rc" > "$SHELL_RC_BODY_TMP" || return 1
        cat "$SHELL_RC_BODY_TMP" > "$SHELL_RC_TMP" || return 1
        rm -f "$SHELL_RC_BODY_TMP" || return 1
        SHELL_RC_BODY_TMP=""
        ensure_safe_shell_rc_path "$rc" || return 1
        mv "$SHELL_RC_TMP" "$rc" || return 1
        SHELL_RC_TMP=""
        info "removed dot env source line from $rc"
    done <<EOF
$shell_rc_values
EOF
}

unset_path_step() {
    uninject_shell_rc
    if [ -f "$ENV_FILE" ]; then
        rm -f "$ENV_FILE"
        info "removed $ENV_FILE"
    else
        info "$ENV_FILE already absent"
    fi
    printf 'This already-open shell still has the PATH/aliases until you exit it.\n'
}

unset_cmd() {
    targets=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -a|--all|all) targets="claude codex kimi path" ;;
            path|claude|codex|kimi) targets="$targets $1" ;;
            help|-h|--help) unset_usage; return 0 ;;
            *) fail "unknown unset argument: $1" ;;
        esac
        shift
    done
    [ -n "$targets" ] || fail "unset requires -a|--all or a target name"

    ensure_agents_dir
    install_configure_traps
    case " $targets " in
        *" path "*) preflight_shell_rc_files || fail "unsafe shell rc path" ;;
    esac
    for t in $targets; do
        case "$t" in
            claude|codex|kimi) unset_one "$t" ;;
            path) unset_path_step ;;
        esac
    done
    cleanup_configure_state
    clear_configure_traps
}

doctor_cleanup() {
    rm -f "${DOCTOR_WRAPPER_TMP:-}" "${DOCTOR_ENV_TMP:-}" || true
    rm -rf "${DOCTOR_PLUGINS_TMP:-}" "${DOCTOR_CODEX_ALIASES_TMP:-}" || true
    DOCTOR_WRAPPER_TMP=""
    DOCTOR_ENV_TMP=""
    DOCTOR_PLUGINS_TMP=""
    DOCTOR_CODEX_ALIASES_TMP=""
    cleanup_plugin_render_temps || true
}

doctor_signal_exit() {
    doctor_signal_status="$1"
    trap - EXIT HUP INT TERM
    doctor_cleanup
    exit "$doctor_signal_status"
}

doctor_cmd() {
    problems=0
    DOCTOR_WRAPPER_TMP=""
    DOCTOR_ENV_TMP=""
    DOCTOR_PLUGINS_TMP=""
    DOCTOR_CODEX_ALIASES_TMP=""
    trap 'doctor_cleanup' EXIT
    trap 'doctor_signal_exit 129' HUP
    trap 'doctor_signal_exit 130' INT
    trap 'doctor_signal_exit 143' TERM
    [ -d "$AGENTS_DIR" ] || { warn "$AGENTS_DIR missing"; problems=$((problems + 1)); }
    [ -d "$DOT_DIR" ] || { warn "$DOT_DIR missing"; problems=$((problems + 1)); }
    mkdir -p "$DOT_DIR/var" || {
        warn "cannot create dot runtime directory: $DOT_DIR/var"
        return 2
    }
    if [ -f "$GITIGNORE_FILE" ] && grep -qxF '/.dotpanel/' "$GITIGNORE_FILE"; then
        info "$GITIGNORE_FILE ignores /.dotpanel/"
    else
        warn "$GITIGNORE_FILE does not ignore /.dotpanel/"
        problems=$((problems + 1))
    fi
    if [ -f "$ENTRY_FILE" ]; then
        info "entry exists: $ENTRY_FILE"
    else
        warn "entry missing: $ENTRY_FILE"
        problems=$((problems + 1))
    fi
    DOCTOR_WRAPPER_TMP="$(mktemp "$DOT_DIR/var/doctor-wrapper.XXXXXX")" || {
        warn "could not create expected-wrapper scratch file"
        return 2
    }
    wrapper_expected="$DOCTOR_WRAPPER_TMP"
    wrapper_body > "$wrapper_expected" || {
        warn "could not render expected wrappers"
        return 2
    }
    for target in "$HOME_DIR/.claude/CLAUDE.md" "$HOME_DIR/.codex/AGENTS.md" "$HOME_DIR/.kimi/AGENTS.md"; do
        case "$target" in
            "$HOME_DIR/.claude/CLAUDE.md") wrapper_root_ok=1; ensure_safe_claude_skills_root 0 || wrapper_root_ok=0 ;;
            "$HOME_DIR/.codex/AGENTS.md") wrapper_root_ok=1; ensure_safe_codex_skills_root 0 || wrapper_root_ok=0 ;;
            "$HOME_DIR/.kimi/AGENTS.md") wrapper_root_ok=1; ensure_safe_kimi_root || wrapper_root_ok=0 ;;
        esac
        if [ "$wrapper_root_ok" -ne 1 ]; then
            problems=$((problems + 1))
            continue
        fi
        if [ ! -f "$target" ]; then
            warn "wrapper missing: $target"
            problems=$((problems + 1))
        elif cmp -s "$wrapper_expected" "$target"; then
            info "wrapper current: $target"
        else
            warn "wrapper differs from generated content: $target"
            problems=$((problems + 1))
        fi
    done
    rm -f "$wrapper_expected"
    DOCTOR_WRAPPER_TMP=""
    claude_root_safe=1
    if ! ensure_safe_claude_skills_root 0; then
        claude_root_safe=0
        problems=$((problems + 1))
    fi
    DOCTOR_PLUGINS_TMP="$(mktemp -d "$DOT_DIR/var/doctor-plugins.XXXXXX")" || {
        warn "could not create expected-plugin scratch directory"
        return 2
    }
    expected_plugins="$DOCTOR_PLUGINS_TMP"
    actual_plugins="$CLAUDE_SKILLS"
    CLAUDE_SKILLS="$expected_plugins"
    if generate_claude_plugins >/dev/null; then
        plugin_render_ok=1
    else
        plugin_render_ok=0
    fi
    CLAUDE_SKILLS="$actual_plugins"

    if [ "$plugin_render_ok" -eq 1 ] && [ "$claude_root_safe" -eq 1 ]; then
        for plugin_name in hio matt impeccable; do
            expected_plugin="$expected_plugins/$plugin_name"
            actual_plugin="$actual_plugins/$plugin_name"
            actual_plugin_tree_safe=1
            if { [ -e "$actual_plugin" ] || [ -L "$actual_plugin" ]; } && \
                ! reject_plugin_tree_symlinks "$actual_plugin" "$plugin_name live plugin"; then
                actual_plugin_tree_safe=0
            fi
            if [ "$actual_plugin_tree_safe" -ne 1 ]; then
                problems=$((problems + 1))
                continue
            fi
            if [ ! -d "$expected_plugin" ] && [ ! -e "$actual_plugin" ] && [ ! -L "$actual_plugin" ]; then
                info "$plugin_name plugin correctly absent"
            elif [ -d "$expected_plugin" ] && is_dot_managed_claude_plugin_dir "$actual_plugin" && \
                diff -qr "$expected_plugin" "$actual_plugin" >/dev/null 2>&1; then
                skill_count=$(find "$actual_plugin/skills" -name SKILL.md 2>/dev/null | wc -l)
                info "$plugin_name plugin current: $skill_count skill(s) at $actual_plugin"
            elif [ ! -d "$expected_plugin" ] && is_dot_managed_claude_plugin_dir "$actual_plugin"; then
                warn "stale dot-managed $plugin_name plugin: $actual_plugin"
                problems=$((problems + 1))
            elif [ -d "$expected_plugin" ] && is_dot_managed_claude_plugin_dir "$actual_plugin"; then
                warn "$plugin_name plugin differs from source render; run 'dot set claude'"
                problems=$((problems + 1))
            elif [ -e "$actual_plugin" ] || [ -L "$actual_plugin" ]; then
                warn "$plugin_name plugin destination is unmanaged: $actual_plugin"
                problems=$((problems + 1))
            else
                warn "$plugin_name plugin differs from source render; run 'dot set claude'"
                problems=$((problems + 1))
            fi
        done
    elif [ "$plugin_render_ok" -ne 1 ]; then
        warn "could not render expected Claude plugins"
        problems=$((problems + 1))
    else
        warn "skipped Claude plugin comparison because its root is unsafe"
    fi
    rm -rf "$expected_plugins"
    DOCTOR_PLUGINS_TMP=""
    if ! doctor_codex_aliases; then
        problems=$((problems + 1))
    fi
    case ":$PATH:" in
        *":$DOT_BIN:"*) info "dotpanel bin is on PATH: $DOT_BIN" ;;
        *) warn "dotpanel bin is not on PATH in this shell: $DOT_BIN" ;;
    esac
    if command -v dot >/dev/null 2>&1; then
        info "dot command found: $(command -v dot)"
    else
        warn "dot command not found on PATH"
    fi
    if command -v dkey >/dev/null 2>&1; then
        info "dkey command found: $(command -v dkey)"
    else
        warn "dkey command not found on PATH"
    fi
    DOCTOR_ENV_TMP="$(mktemp "$DOT_DIR/var/doctor-env.XXXXXX")" || {
        warn "could not create expected-env scratch file"
        return 2
    }
    env_expected="$DOCTOR_ENV_TMP"
    if ! env_body > "$env_expected"; then
        warn "could not render expected env file"
        problems=$((problems + 1))
    elif ! ensure_safe_generated_file "$ENV_FILE" "env file"; then
        problems=$((problems + 1))
    elif [ ! -f "$ENV_FILE" ]; then
        warn "env file missing: $ENV_FILE"
        problems=$((problems + 1))
    elif cmp -s "$env_expected" "$ENV_FILE"; then
        info "env file current: $ENV_FILE"
    else
        warn "env file differs from generated content: $ENV_FILE"
        problems=$((problems + 1))
    fi
    rm -f "$env_expected"
    DOCTOR_ENV_TMP=""
    if command -v age >/dev/null 2>&1; then
        info "age found"
    else
        warn "age missing; dkey encrypted grants will not work yet"
    fi
    if command -v jq >/dev/null 2>&1; then
        info "jq found"
    else
        warn "jq missing; dkey provider JSON features will not work"
        problems=$((problems + 1))
    fi
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
        info "python3 + PyYAML found"
    else
        warn "python3 + PyYAML missing; skill frontmatter cannot be validated"
        problems=$((problems + 1))
    fi
    doctor_status=0
    [ "$problems" -eq 0 ] || doctor_status=2
    doctor_cleanup
    trap - EXIT HUP INT TERM
    return "$doctor_status"
}

sync_usage() {
    cat <<'EOF'
Usage:
  dot sync status
  dot sync diff
  dot sync pull
  dot sync push [GIT_PUSH_ARGS...]

Synchronizes ~/.agents as the user's memspace repo.
~/.agents/.dotpanel/ is ignored and not part of this repo.

pull prints status, fetches, requires a clean worktree, fast-forwards from the
configured upstream, recursively initializes/updates submodules, then renders
all harness outputs.
push requires a clean worktree and pushes existing commits only. It never
stages or commits files.
EOF
}

ensure_agents_git_repo() {
    need_git
    [ -d "$AGENTS_DIR" ] || fail "$AGENTS_DIR missing; run dot init first"
    is_git_repo "$AGENTS_DIR" || fail "$AGENTS_DIR is not a git repo; run 'git -C \"$AGENTS_DIR\" init' or clone your memspace repo there"
}

require_clean_git_worktree() {
    repo="$1"
    label="$2"
    action="$3"
    if [ -n "$(git -C "$repo" status --porcelain=v1 --untracked-files=all)" ]; then
        fail "$label has uncommitted changes; commit or stash them before $action"
    fi
}

sync_cmd() {
    sub="${1:-status}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        help|-h|--help)
            sync_usage
            ;;
        status)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" status --short --branch
            ;;
        diff)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" diff "$@"
            ;;
        pull)
            ensure_agents_git_repo
            git -C "$AGENTS_DIR" status --short --branch
            git -C "$AGENTS_DIR" fetch "$@"
            require_clean_git_worktree "$AGENTS_DIR" "memspace" "pulling"
            upstream="$(git -C "$AGENTS_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || \
                fail "memspace branch has no upstream; configure one before pulling"
            git -C "$AGENTS_DIR" merge --ff-only "$upstream"
            git -C "$AGENTS_DIR" submodule update --init --recursive
            configure_cmd --harness all
            ;;
        push)
            ensure_agents_git_repo
            require_clean_git_worktree "$AGENTS_DIR" "memspace" "pushing"
            git -C "$AGENTS_DIR" push "$@"
            ;;
        *)
            fail "unknown sync command: $sub"
            ;;
    esac
}

self_usage() {
    cat <<'EOF'
Usage:
  dot self status
  dot self update

Manages the dot tool checkout at ~/.agents/.dotpanel.
update refuses a checkout with tracked, staged, or untracked changes.
EOF
}

self_cmd() {
    sub="${1:-status}"
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$sub" in
        help|-h|--help)
            self_usage
            ;;
        status)
            need_git
            is_git_repo "$DOT_DIR" || fail "$DOT_DIR is not a git repo; install with 'git clone <repo> \"$DOT_DIR\" && sh \"$DOT_DIR/bin/dot\" init'"
            git -C "$DOT_DIR" status --short --branch
            ;;
        update)
            need_git
            is_git_repo "$DOT_DIR" || fail "$DOT_DIR is not a git repo; install with 'git clone <repo> \"$DOT_DIR\" && sh \"$DOT_DIR/bin/dot\" init'"
            require_clean_git_worktree "$DOT_DIR" "dotpanel checkout" "updating"
            git -C "$DOT_DIR" pull --ff-only "$@"
            configure_cmd --harness all
            install_configure_traps
            path_cmd
            cleanup_configure_state
            clear_configure_traps
            ;;
        *)
            fail "unknown self command: $sub"
            ;;
    esac
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$cmd" in
    init) init_cmd "$@" ;;
    set) set_cmd "$@" ;;
    unset) unset_cmd "$@" ;;
    configure) configure_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    sync) sync_cmd "$@" ;;
    self) self_cmd "$@" ;;
    version|--version|-v) version ;;
    help|--help|-h) usage ;;
    *) fail "unknown command: $cmd" ;;
esac
