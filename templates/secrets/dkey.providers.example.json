{
  "_comment": "dkey providers registry — defines backends that dkey use writes config for.",
  "_schema": "See PROVIDERS.md for the full schema description.",

  "version": 1,

  "defaults": {
    "claude": {
      "settings_path": "~/.claude/settings.json",
      "home_path": "~/.claude.json",
      "home": {},
      "settings": {
        "env": {}
      },
      "managed_env_keys": [
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "ANTHROPIC_DEFAULT_SONNET_MODEL",
        "API_TIMEOUT_MS"
      ]
    },
    "codex": {
      "config_path": "~/.codex/config.toml"
    }
  },

  "providers": {
    "example": {
      "default_profile": "default",
      "secret": "EXAMPLE_API_KEY",
      "profiles": {
        "default": {
          "claude": {
            "settings": {
              "env": {
                "ANTHROPIC_BASE_URL": "https://api.example.com/anthropic",
                "ANTHROPIC_AUTH_TOKEN": {"secret": "EXAMPLE_API_KEY"},
                "ANTHROPIC_MODEL": "example-model",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": "example-fast-model"
              }
            },
            "home": {
              "hasCompletedOnboarding": true
            }
          },
          "codex": {
            "model": "example-model",
            "model_provider": "example",
            "model_provider_config": {
              "name": "Example Provider",
              "base_url": "https://api.example.com/v1",
              "wire_api": "responses",
              "requires_openai_auth": true
            },
            "status": "supported"
          }
        }
      }
    }
  }
}
