#!/usr/bin/env bash
# claw -- claude launcher & remote-control daemon manager
# Usage:
#   claw [target]                              # interactive, official OAuth
#   claw --<variant> [target]                  # interactive, relay backend
#   claw --variant NAME [target]               # same, explicit form
#   claw -p|--print [--<variant>] "prompt"     # headless one-shot (claude -p)
#   claw -s|--serve [--<variant>] [name]       # daemon mode
#   claw -s|--serve stop|logs|status [name]    # daemon control
#   claw status                                # repo status
#
# `<variant>` is any name declared under `.dotpanel.toml [backends.claude.variants]`.
set -euo pipefail

show_help() {
    sed -n '2,12s/^# \{0,1\}//p' "$0"
}

cmd_status() {
    printf "%-22s %-12s %-8s %s\n" "REPO" "BRANCH" "STATUS" "LAST COMMIT"
    printf "%-22s %-12s %-8s %s\n" "----" "------" "------" "-----------"
    for dir in "$HOME/.dotfiles" "$HOME"/src/*/ "$HOME"/vendor/*/; do
        [[ ! -d "${dir}/.git" ]] && continue
        local name branch dirty last status
        name="$(basename "$dir")"
        [[ "$dir" == "$HOME/.dotfiles" ]] && name="dotfiles"
        branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "?")
        dirty=$(git -C "$dir" status --porcelain 2>/dev/null | head -1)
        last=$(git -C "$dir" log -1 --format='%ar' 2>/dev/null || echo "?")
        status="clean"
        [[ -n "$dirty" ]] && status="dirty"
        printf "%-22s %-12s %-8s %s\n" "$name" "$branch" "$status" "$last"
    done
}

resolve_target_dir() {
    local target="$1"
    if [[ -z "$target" || "$target" == "." ]]; then
        echo "$HOME"
    elif [[ "$target" == "dotfiles" ]]; then
        echo "$HOME/.dotfiles"
    elif [[ -d "$HOME/src/$target" ]]; then
        echo "$HOME/src/$target"
    elif [[ -d "$HOME/vendor/$target" ]]; then
        echo "$HOME/vendor/$target"
    elif [[ -d "$target" ]]; then
        echo "$target"
    else
        echo ""
    fi
}

exec_interactive() {
    local target="$1"
    local variant="${2:-}"

    local target_dir
    target_dir="$(resolve_target_dir "$target")"
    if [[ -z "$target_dir" ]]; then
        echo "claw: not found: $target" >&2
        exit 1
    fi
    cd "$target_dir"

    if [[ -n "$variant" ]]; then
        exec dotpanel secrets run --backend claude --variant "$variant" -- bash -c '
            args=(--dangerously-skip-permissions --effort max)
            [[ -n "${DOTPANEL_MODEL:-}" ]] && args+=(--model "$DOTPANEL_MODEL")
            [[ -n "${DOTPANEL_PROMPT_OVERLAY:-}" && -f "$DOTPANEL_PROMPT_OVERLAY" ]] && \
                args+=(--append-system-prompt "$(cat "$DOTPANEL_PROMPT_OVERLAY")")
            exec claude "${args[@]}"
        '
    else
        exec claude --dangerously-skip-permissions --effort max
    fi
}

exec_headless() {
    local variant="${1:-andy}"
    shift || true

    if [[ $# -gt 0 ]]; then
        prompt="$*"
    elif [[ ! -t 0 ]]; then
        prompt="$(cat)"
    else
        echo "claw: -p requires a prompt (pass as args or pipe via stdin)" >&2
        exit 2
    fi

    export _CLAW_ASK_PROMPT="$prompt"
    exec dotpanel secrets run --backend claude --variant "$variant" -- bash -c '
        args=(-p --dangerously-skip-permissions)
        [[ -n "${DOTPANEL_MODEL:-}" ]] && args+=(--model "$DOTPANEL_MODEL")
        [[ -n "${DOTPANEL_PROMPT_OVERLAY:-}" && -f "$DOTPANEL_PROMPT_OVERLAY" ]] && \
            args+=(--append-system-prompt "$(cat "$DOTPANEL_PROMPT_OVERLAY")")
        exec claude "${args[@]}" "$_CLAW_ASK_PROMPT"
    ' < /dev/null
}

exec_serve() {
    local action="$1"
    local name="$2"
    local variant="${3:-}"

    if [[ -n "$variant" && "$variant" != "andy" ]]; then
        name="${variant}-${name}"
    fi

    local unit="rc-${name}"
    local unit_dir="$HOME/.config/systemd/user"
    local unit_file="${unit_dir}/${unit}.service"

    case "$action" in
        stop)
            systemctl --user stop "$unit" 2>/dev/null \
                && echo "Stopped $unit" \
                || echo "$unit not running"
            exit 0 ;;
        logs)
            exec journalctl --user -u "$unit" -f ;;
        status)
            systemctl --user status "$unit" 2>/dev/null \
                || echo "$unit not found"
            exit 0 ;;
    esac

    # Already running?
    if systemctl --user is-active "$unit" >/dev/null 2>&1; then
        echo "$unit already running. Use: claw --serve stop ${name}"
        systemctl --user status "$unit" --no-pager
        exit 0
    fi

    # Resolve claude-rc absolute path (systemd PATH is minimal).
    local claude_rc
    claude_rc="$(command -v claude-rc 2>/dev/null || true)"
    if [[ -z "$claude_rc" ]]; then
        if [[ -x "$HOME/.dotfiles/tools/bin/claude-rc" ]]; then
            claude_rc="$HOME/.dotfiles/tools/bin/claude-rc"
        else
            echo "claw: claude-rc not found in PATH or substrate" >&2
            exit 2
        fi
    fi

    # Build ExecStart
    local exec_start
    if [[ -n "$variant" ]]; then
        local dotpanel_bin
        dotpanel_bin="$(command -v dotpanel 2>/dev/null || true)"
        if [[ -z "$dotpanel_bin" ]]; then
            echo "claw: dotpanel not on PATH; cannot use variant $variant" >&2
            exit 2
        fi
        exec_start="${dotpanel_bin} secrets run --backend claude --variant ${variant} -- ${claude_rc} --name ${name} --permission-mode bypassPermissions"
    else
        exec_start="${claude_rc} --name ${name} --permission-mode bypassPermissions"
    fi

    # Collect proxy env from current shell so the daemon inherits it.
    local proxy_lines=""
    for var in HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy; do
        [[ -n "${!var:-}" ]] && proxy_lines="${proxy_lines}Environment=${var}=${!var}
"
    done

    mkdir -p "$unit_dir"
    cat > "$unit_file" <<EOF
[Unit]
Description=Claude remote-control: ${name}

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=${exec_start}
Restart=on-failure
RestartSec=5
${proxy_lines}[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user start "$unit"
    echo "Started remote-control: ${name}${variant:+ (variant=$variant, unit=$unit)}"
    systemctl --user status "$unit" --no-pager
}

# ── Parse args ──────────────────────────────────────────────────────────────

VARIANT=""
MODE="interactive"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --print|-p)
            MODE="headless"; shift ;;
        --serve|-s)
            MODE="serve"; shift ;;
        --variant)
            VARIANT="${2:?--variant requires NAME}"; shift 2 ;;
        help|--help|-h)
            show_help; exit 0 ;;
        status)
            if [[ "$MODE" == "interactive" ]]; then
                cmd_status; exit 0
            fi
            break ;;
        --*)
            # Any unrecognised --<name> flag is treated as a variant. dotpanel
            # secrets run validates against [backends.*.variants] and fails
            # loudly if the name isn't defined.
            VARIANT="${1#--}"; shift ;;
        *)
            break ;;
    esac
done

case "$MODE" in
    headless)
        exec_headless "${VARIANT:-andy}" "$@"
        ;;
    serve)
        ACTION="start"
        NAME=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                stop|logs|status)
                    ACTION="$1"; shift ;;
                *)
                    NAME="$1"; shift ;;
            esac
        done
        NAME="${NAME:-$(hostname)}"
        exec_serve "$ACTION" "$NAME" "$VARIANT"
        ;;
    *)
        TARGET="${1:-.}"
        exec_interactive "$TARGET" "$VARIANT"
        ;;
esac
