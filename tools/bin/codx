#!/usr/bin/env bash
# codx -- thin codex profile launcher
# Usage: codx [--andy | --let | --variant PROFILE] [-- codex args...]
#
# Profiles live in ~/.codex/config.toml and keep provider credentials env-keyed.
# Keys are loaded by shell startup / VSCode server-env-setup via
# `dotpanel secrets export --scope llm`; codx never writes auth.json or inline keys.
set -euo pipefail

PROFILE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --variant)
            PROFILE="${2:?--variant requires PROFILE}"; shift 2 ;;
        --profile)
            PROFILE="${2:?--profile requires PROFILE}"; shift 2 ;;
        --andy|--let)
            PROFILE="${1#--}"; shift ;;
        help|--help|-h)
            sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 0 ;;
        --) shift; break ;;
        --*)
            break ;;
        *)  break ;;
    esac
done

if [[ -n "$PROFILE" ]]; then
    exec codex -p "$PROFILE" "$@"
fi
exec codex "$@"
