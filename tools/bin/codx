#!/usr/bin/env bash
# codx -- thin codex profile launcher with on-demand secrets injection
# Usage:
#   codx                                  # official Codex config/auth
#   codx --andy|--let [-- codex args...]  # relay backend via profile
#   codx --variant PROFILE [-- codex args...]
#   codx --vscode --variant PROFILE       # inject relay backend for VS Code
#   codx --vscode --openai                # restore VS Code to official OpenAI
#
# No profile  -> exec codex directly (uses default config, env must be present).
# With profile -> dotpanel secrets run --backend codex --variant <profile>.
set -euo pipefail

show_help() {
    sed -n '2,9s/^# \{0,1\}//p' "$0"
}

install_vscode_env() {
    local profile="$1"
    if [[ -z "$profile" ]]; then
        echo "codx: --vscode requires --variant PROFILE (or --<variant>)" >&2
        exit 2
    fi

    local src_home="$HOME/.codex"
    local src_config="$src_home/config.toml"
    local dst_home="$HOME/.codex-vscode/${profile}"
    local dst_config="$dst_home/config.toml"

    if [[ ! -f "$src_config" ]]; then
        echo "codx: missing $src_config; run dotpanel configure --harness codex first" >&2
        exit 2
    fi

    local provider
    provider="$(awk -v profile="$profile" '
        $0 == "[profiles." profile "]" { in_profile = 1; next }
        /^\[/ { in_profile = 0 }
        in_profile && $1 == "model_provider" {
            value = $0
            sub(/^[^=]*=[[:space:]]*/, "", value)
            gsub(/"/, "", value)
            print value
            exit
        }
    ' "$src_config")"
    if [[ -z "$provider" ]]; then
        echo "codx: profile '$profile' not found in $src_config" >&2
        exit 2
    fi

    mkdir -p "$dst_home"
    awk -v provider="$provider" '
        /^\[/ && !done {
            print "model_provider = \"" provider "\""
            done = 1
        }
        !done && $0 ~ /^model_provider[[:space:]]*=/ {
            print "model_provider = \"" provider "\""
            done = 1
            next
        }
        { print }
        END {
            if (!done) {
                print "model_provider = \"" provider "\""
            }
        }
    ' "$src_config" > "$dst_config"
    [[ -f "$src_home/AGENTS.md" ]] && cp "$src_home/AGENTS.md" "$dst_home/AGENTS.md"
    if [[ -d "$src_home/rules" ]]; then
        mkdir -p "$dst_home/rules"
        cp -a "$src_home/rules/." "$dst_home/rules/"
    fi

    local q_profile q_dst_home
    printf -v q_profile '%q' "$profile"
    printf -v q_dst_home '%q' "$dst_home"
    local block
    block=$(cat <<EOF
# Generated by codx --vscode; do not edit directly.
# Sourced by vscode-server before extensions start; keep this block secret-free.

export CODEX_HOME=$q_dst_home
if command -v dotpanel >/dev/null 2>&1; then
    eval "\$(dotpanel secrets export --backend codex --variant $q_profile --shell bash 2>/dev/null)"
fi
EOF
)

    for vscode_home in "$HOME/.vscode-server" "$HOME/.vscode-server-insiders"; do
        mkdir -p "$vscode_home"
        local setup="$vscode_home/server-env-setup"
        write_vscode_env_block "$setup" "codex" "$block"
        echo "codx: installed $setup (variant=$profile, CODEX_HOME=$dst_home)"
    done
    echo "codx: restart VS Code Remote / vscode-server for the new backend env"
}

install_vscode_openai_env() {
    local src_home="$HOME/.codex"
    local q_src_home
    printf -v q_src_home '%q' "$src_home"
    local block
    block=$(cat <<EOF
# Generated by codx --vscode --openai; do not edit directly.
# Sourced by vscode-server before extensions start; keep this block secret-free.

export CODEX_HOME=$q_src_home
EOF
)

    for vscode_home in "$HOME/.vscode-server" "$HOME/.vscode-server-insiders"; do
        mkdir -p "$vscode_home"
        local setup="$vscode_home/server-env-setup"
        write_vscode_env_block "$setup" "codex" "$block"
        echo "codx: installed $setup (official OpenAI, CODEX_HOME=$src_home)"
    done
    echo "codx: restart VS Code Remote / vscode-server for the official OpenAI env"
}

write_vscode_env_block() {
    local setup="$1"
    local name="$2"
    local block="$3"
    local start="# >>> dotpanel ${name}"
    local end="# <<< dotpanel ${name}"
    local tmp="${setup}.tmp.$$"

    if [[ -f "$setup" ]]; then
        awk -v start="$start" -v end="$end" '
            $0 == start { skip = 1; next }
            $0 == end { skip = 0; next }
            !skip { print }
        ' "$setup" > "$tmp"
    else
        : > "$tmp"
    fi

    if [[ -s "$tmp" ]]; then
        printf '\n' >> "$tmp"
    fi
    printf '%s\n%s\n%s\n' "$start" "$block" "$end" >> "$tmp"
    mv "$tmp" "$setup"
    chmod 600 "$setup"
}

PROFILE=""
VSCODE=0
OPENAI=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --vscode)
            VSCODE=1; shift ;;
        --openai)
            OPENAI=1; shift ;;
        --variant)
            PROFILE="${2:?--variant requires PROFILE}"; shift 2 ;;
        --profile)
            PROFILE="${2:?--profile requires PROFILE}"; shift 2 ;;
        --andy|--let)
            PROFILE="${1#--}"; shift ;;
        help|--help|-h)
            show_help; exit 0 ;;
        --) shift; break ;;
        --*)
            break ;;
        *)  break ;;
    esac
done

if [[ "$VSCODE" == "1" ]]; then
    if [[ "$OPENAI" == "1" ]]; then
        if [[ -n "$PROFILE" ]]; then
            echo "codx: --vscode --openai conflicts with --variant/--profile" >&2
            exit 2
        fi
        install_vscode_openai_env
    else
        install_vscode_env "$PROFILE"
    fi
    exit 0
fi

if [[ "$OPENAI" == "1" ]]; then
    echo "codx: --openai is only supported with --vscode" >&2
    exit 2
fi

if [[ -n "$PROFILE" ]]; then
    exec dotpanel secrets run --backend codex --variant "$PROFILE" -- codex -p "$PROFILE" "$@"
fi
exec codex "$@"
